---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { googleReviewsUrl } from '../data/site-config';

// One entry per person, one wording per quote. The homepage and the English
// landing page quote these entries word for word, so edit them here and there
// together. Names are shortened to first name + surname initial; students are
// minors. `featured` entries fill the carousel, the rest fill the grid, so no
// quote appears twice on this page.
const testimonials = [
  {
    name: 'Linda T.',
    context: 'Mother of a Sec 4 student',
    initials: 'LT',
    stars: 5,
    quote: 'The moment my son learned the SHARP Method\'s "See" step for inference questions, his comprehension marks jumped from 12/25 to 20/25 — no more guessing.',
    featured: true,
  },
  {
    name: 'Ethan L.',
    context: 'Sec 4 student',
    initials: 'EL',
    stars: 5,
    quote: 'I used to dread essay writing. The SHARP Method\'s "Apply" step taught me how to plan and argue properly — my essay scores went from 18/30 to 26/30. Got A1 for O-Levels.',
    featured: false,
  },
  {
    name: 'Rajesh K.',
    context: 'Father of a Sec 3 student',
    initials: 'RK',
    stars: 5,
    quote: 'What impressed me most was how the SHARP Method\'s "See" and "Hit" steps made inference questions click for my daughter. She went from losing 8 marks per paper to losing only 2.',
    featured: false,
  },
  {
    name: 'Angela W.',
    context: 'Mother of a Sec 4 student',
    initials: 'AW',
    stars: 5,
    quote: 'The small class size means real attention.',
    featured: true,
  },
  {
    name: 'Muhammad F.',
    context: 'Father of Sec 2 twins',
    initials: 'MF',
    stars: 5,
    quote: 'Both my boys have improved significantly in their English. The analytical approach builds skills that help across all subjects.',
    featured: false,
  },
  {
    name: 'Jennifer L.',
    context: 'Mother of a Sec 3 student',
    initials: 'JL',
    stars: 5,
    quote: 'We switched from a large tuition chain. The difference is night and day — focused, systematic, and my son actually understands why he\'s learning what he\'s learning.',
    featured: false,
  },
  {
    name: 'Ryan O.',
    context: 'Sec 4 student',
    initials: 'RO',
    stars: 5,
    quote: 'The SHARP Method helped me go from barely passing to B3 in English. Once I started using the "Hit" step to target key points in summary, my score went from 3/8 to 7/8.',
    featured: false,
  },
  {
    name: 'Deepa N.',
    context: 'Mother of a Sec 2 student',
    initials: 'DN',
    stars: 5,
    quote: 'I appreciate the detailed feedback after every mock paper. I can see exactly what my daughter needs to work on.',
    featured: false,
  },
  {
    name: 'Wei Ling',
    context: 'Sec 4 student',
    initials: 'WL',
    stars: 5,
    quote: 'Got A2 for O-Level English! The SHARP Method\'s "Refine" step taught me to self-check my answers — I stopped losing careless marks and my Paper 2 score jumped by 15 marks.',
    featured: true,
  },
  {
    name: 'Sarah G.',
    context: 'Mother of a JC 1 student',
    initials: 'SG',
    stars: 5,
    quote: 'A-Worthy is the only tuition centre that actually teaches thinking, not just content. My daughter went from struggling to scoring distinctions.',
    featured: true,
  },
  {
    name: 'David O.',
    context: 'Father of a Sec 3 student',
    initials: 'DO',
    stars: 5,
    quote: 'The small class size means my son can\'t hide. He gets feedback every single session — something his previous tuition centre never offered.',
    featured: true,
  },
];

const featured = testimonials.filter((t) => t.featured);
const gridTestimonials = testimonials.filter((t) => !t.featured);
---

<BaseLayout title="Tuition Reviews & Testimonials | A-Worthy Singapore" description="Reviews from Singapore parents and students on A-Worthy's small-group tuition in O-Level English, H1 GP and H2 Economics, in their own words." >
  <Header slot="header" />

  <!-- ===== HERO ===== -->
  <section class="t-hero">
    <div class="t-container t-hero-inner">
      <img src="/images/mascots/mascot-heart.webp" alt="" width="299" height="413" class="t-hero-mascot sticker sticker--right" />
      <span class="eyebrow">Reviews</span>
      <h1 class="t-hero-heading">What Singapore parents and students say about <span class="accent-word">A-Worthy</span></h1>
      <p class="t-hero-subtitle">
        Parents and students, in their own words. We shorten names to protect the students&rsquo; privacy.
      </p>
      <div class="t-hero-actions" data-track="hero">
        <a href="/contact/" class="btn btn-accent">Book Free Assessment</a>
      </div>
    </div>
  </section>

  <!-- ===== STATS BAR ===== -->
  <section class="t-stats-bar">
    <div class="t-container t-stats-inner">
      <div class="t-stat" data-animate="reveal-up" data-animate-delay="1">
        <span class="t-stat-number"><span class="stat-dot stat-dot--green" aria-hidden="true"></span>500+</span>
        <span class="t-stat-label">Students taught</span>
      </div>
      <div class="t-stat-divider"></div>
      <div class="t-stat" data-animate="reveal-up" data-animate-delay="2">
        <span class="t-stat-number"><span class="stat-dot stat-dot--pink" aria-hidden="true"></span>6</span>
        <span class="t-stat-label">Max class size</span>
      </div>
      <div class="t-stat-divider"></div>
      <div class="t-stat" data-animate="reveal-up" data-animate-delay="3">
        <span class="t-stat-number"><span class="stat-dot stat-dot--blue" aria-hidden="true"></span>4.9/5</span>
        <span class="t-stat-label">Google rating</span>
      </div>
    </div>
  </section>

  <!-- ===== FEATURED CAROUSEL ===== -->
  <section class="t-section">
    <div class="t-container">
      <span class="eyebrow" data-animate="reveal-up">Featured Reviews</span>
      <h2 class="section-title" data-animate="reveal-up">What families are saying</h2>

    <div class="carousel-wrap" data-animate="reveal-up">
      <div class="carousel" id="testimonial-carousel">
        <div class="carousel-track" id="carousel-track">
          {featured.map((t) => (
            <div class="carousel-slide">
              <div class="carousel-quote">&ldquo;{t.quote}&rdquo;</div>
              <div class="carousel-author"><strong>{t.name}</strong> &mdash; {t.context}</div>
            </div>
          ))}
        </div>
      </div>
      <div class="carousel-dots" id="carousel-dots"></div>
    </div>
    </div>
  </section>

  <!-- ===== TESTIMONIALS GRID ===== -->
  <section class="t-section t-testimonials-section">
    <div class="t-container">
      <div class="t-testimonials-grid">
        {gridTestimonials.map((t, i) => (
          <div class:list={['t-card', { 't-card--featured': t.featured }]} data-animate="reveal-up" data-animate-delay={String((i % 3) + 1)}>
            <div class="t-card-stars" aria-label={`${t.stars} out of 5 stars`}>
              {Array.from({ length: t.stars }).map(() => (
                <span class="t-star">&#9733;</span>
              ))}
            </div>
            <blockquote class="t-card-quote">
              &ldquo;{t.quote}&rdquo;
            </blockquote>
            <div class="t-card-author">
              <div class="t-avatar-initials">{t.initials}</div>
              <div class="t-card-author-info">
                <strong>{t.name}</strong>
                <span>{t.context}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== REVIEWS ===== -->
  <section class="t-section t-google-section">
    <div class="t-container t-google-inner">
      <span class="eyebrow" data-animate="reveal-up">Your Feedback</span>
      {googleReviewsUrl ? (
        <h2 class="t-google-heading squiggle squiggle--center" data-animate="reveal-up">Read what families say on Google</h2>
      ) : (
        <h2 class="t-google-heading squiggle squiggle--center" data-animate="reveal-up">Tell us how we did</h2>
      )}
      <p class="t-google-sub" data-animate="reveal-up">Families rate us 4.9 out of 5 on Google. If your child is in one of our classes, a short review helps other parents decide.</p>

      <div class="t-google-actions" data-animate="reveal-up">
        {googleReviewsUrl && (
          <a href={googleReviewsUrl} class="btn btn-accent" target="_blank" rel="noopener noreferrer">
            Read all reviews on Google &rarr;
          </a>
        )}
        <a href="/review/" class:list={['btn', { 'btn-accent': !googleReviewsUrl }]}>
          Leave us a review
        </a>
      </div>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section class="t-section t-cta" data-track="final-cta">
    <div class="t-container t-cta-inner">
      <span class="eyebrow">Get Started</span>
      <h2 class="t-cta-heading squiggle squiggle--center" data-animate="reveal-up">Find out how <span class="t-nowrap">A-Worthy</span> can help your child</h2>
      <p class="t-cta-subtitle">Book a free 20-minute assessment with <span class="t-nowrap">A-Worthy</span>. Jeremy reviews your child&rsquo;s latest marked paper and sends you a written summary of the gaps.</p>
      <div class="t-cta-actions">
        <a href="/contact/" class="btn btn-accent">Book Free Assessment</a>
        <a href="https://wa.me/6589913181" class="btn" target="_blank" rel="noopener noreferrer">
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style="vertical-align: middle; margin-right: 6px;">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          WhatsApp us
        </a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* Uses global design tokens from global.css */

  /* ===== BASE ===== */
  .t-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .t-section {
    padding: 1.75rem 0;
  }

  /* Eyebrows stack centred above their (centred) section titles — the plain
     .t-container bands don't centre their children the way the hero /
     Google / CTA wrappers do. */
  .t-section > .t-container > .eyebrow {
    display: block;
    text-align: center;
  }

  /* ===== HERO ===== */
  .t-hero {
    background: var(--bg-primary);
    padding: 1.75rem 0;
    text-align: center;
  }

  .t-hero-inner {
    max-width: 720px;
  }

  /* Sticker centred above the headline, LMS-style */
  .t-hero-mascot {
    height: 160px;
    width: auto;
    margin: 0 auto 0.75rem;
  }

  .t-hero-heading {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 5vw, 3.75rem);
    font-weight: 900;
    color: var(--text-primary);
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin: 0 0 24px;
  }

  .t-hero-subtitle {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin: 0;
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
  }

  .t-hero-actions {
    display: flex;
    justify-content: center;
    margin-top: 1.5rem;
  }

  /* ===== STATS BAR — coloured stat dots before 900-weight numbers ===== */
  .t-stats-bar {
    background: var(--bg-secondary);
    padding: 40px 0;
  }

  .t-stats-inner {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 64px;
  }

  .t-stat {
    text-align: center;
  }

  .t-stat-number {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-size: 2.25rem;
    font-weight: 900;
    color: var(--text-primary);
    line-height: 1.2;
    letter-spacing: -0.03em;
  }

  .t-stat-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin-top: 6px;
  }

  .t-stat-divider {
    width: 0;
    height: 48px;
    border-left: 2px dashed var(--ink-faint);
  }

  /* ===== TESTIMONIALS GRID ===== */
  .t-testimonials-section {
    background: var(--bg-primary);
  }

  .t-testimonials-grid {
    columns: 3;
    column-gap: 24px;
  }

  /* White ink cards; rest shadow + hover lift come from the global .t-card rules */
  .t-card {
    position: relative;
    break-inside: avoid;
    display: inline-block;
    width: 100%;
    background: var(--bg-card);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    margin-bottom: 24px;
  }

  /* Highlighted cards stay solid white like the rest of the grid (no tinted
     card fills); only the quote is set larger */
  .t-card--featured .t-card-quote {
    font-size: 1.15rem;
  }

  .t-card-stars {
    display: flex;
    gap: 2px;
    margin-bottom: 1rem;
  }

  /* Stars carry data → sun, not the action red */
  .t-star {
    color: var(--color-sun);
    font-size: 1.1rem;
    line-height: 1;
  }

  .t-card-quote {
    font-family: var(--font-heading);
    font-weight: 600;
    font-style: italic;
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--text-primary);
    margin: 0 0 20px;
    padding: 0;
    border: none;
    text-wrap: pretty;
  }

  .t-card-author {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-top: 16px;
    border-top: 2px dashed var(--ink-faint);
  }

  /* Initials tile — ink-ringed circle on the muted fill */
  .t-avatar-initials {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--bg-muted);
    border: 2px solid var(--color-ink);
    color: var(--text-primary);
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .t-card-author-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .t-card-author-info strong {
    color: var(--text-primary);
    font-size: 0.9rem;
    font-weight: 800;
  }

  .t-card-author-info span {
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  /* ===== GOOGLE REVIEWS ===== */
  .t-google-section {
    background: var(--bg-secondary);
    padding: 64px 0;
  }

  .t-google-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
  }

  .t-google-heading {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 3.2vw, 2.2rem);
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin: 0;
  }
  .t-google-sub {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin: 0 0 1rem;
    max-width: 560px;
  }
  .t-google-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 1rem;
  }

  /* ===== CTA ===== */
  .t-cta {
    background: var(--bg-primary);
    text-align: center;
  }

  .t-cta-inner {
    max-width: 640px;
  }

  .t-cta-heading {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
  }

  /* Keeps the brand name whole — the heading otherwise broke at its hyphen
     ("Experience the A-" / "Worthy difference") on phones and laptops. */
  .t-nowrap {
    white-space: nowrap;
  }

  .t-cta-subtitle {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin: 0 0 32px;
  }

  .t-cta-actions {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 1024px) {
    .t-testimonials-grid {
      columns: 2;
    }
  }

  @media (max-width: 768px) {
    .t-hero {
      padding: 2rem 0 1.5rem;
    }

    .t-section {
      padding: 1.75rem 0;
    }

    /* Compact 3-up grid on phones — never a single column of giant numbers */
    .t-stats-inner {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
    }

    .t-stat-divider {
      display: none;
    }

    .t-stat-number {
      font-size: 1.75rem;
    }

    .t-stat-label {
      font-size: 0.72rem;
    }

    .t-google-inner {
      flex-direction: column;
      gap: 32px;
    }
  }

  @media (max-width: 640px) {
    .t-testimonials-grid {
      columns: 1;
    }

    .t-hero-heading {
      font-size: 2rem;
    }

    .t-hero-mascot {
      height: 120px;
    }

    .t-card {
      padding: 1.25rem;
    }

    .t-cta-actions,
    .t-google-actions {
      flex-direction: column;
      align-items: center;
    }

    .t-cta-actions .btn,
    .t-google-actions .btn {
      width: 100%;
      max-width: 300px;
    }
  }

  /* Landscape phones (~390px tall): the 160px sticker pushed the headline
     below the first screen. */
  @media (max-height: 500px) and (orientation: landscape) {
    .t-hero-mascot {
      height: 80px;
      margin-bottom: 0.5rem;
    }
  }

  @media (min-width: 1921px) {
    /* rem, not px: html is 125–150% here, and a fixed 1400px left the 3-up
       review cards ~24 characters wide at 2560px. */
    .t-container {
      max-width: 75rem;
    }

    /* rem: at the 150% root the px caps ran the headline to 4 lines and the
       lead to ~35 characters */
    .t-hero-inner {
      max-width: 45rem;
    }
    .t-hero-subtitle,
    .t-google-sub {
      max-width: 35rem;
    }

    /* The .t-container rule above would otherwise override these narrow
       wrappers (same specificity, later in the file) — the CTA subtitle ran
       to ~110 characters on one line. */
    .t-google-inner {
      max-width: 45rem;
    }

    .t-cta-inner {
      max-width: 40rem;
    }

    .t-testimonials-grid {
      max-width: 75rem;
      margin: 0 auto;
    }
  }

  /* ===== CAROUSEL ===== */
  .carousel-wrap {
    max-width: 700px;
    margin: 0 auto 1.5rem;
  }
  .carousel {
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--bg-card);
    border: 2px solid var(--color-ink);
    box-shadow: 0 3px 0 var(--ink-shadow);
    position: relative;
  }
  .carousel::before {
    content: '\201C';
    position: absolute;
    top: -0.4rem;
    left: 1rem;
    font-family: var(--font-heading);
    font-size: 6rem;
    font-weight: 900;
    line-height: 1;
    color: var(--color-ink);
    opacity: 0.12;
    pointer-events: none;
    z-index: 0;
  }
  .carousel-track {
    display: flex;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    z-index: 1;
  }
  .carousel-slide {
    min-width: 100%;
    padding: 1.75rem 1.5rem 1.5rem;
    text-align: center;
  }
  .carousel-quote {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.6;
    color: var(--text-primary);
    font-style: italic;
    margin-bottom: 1.25rem;
  }
  .carousel-author {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }
  .carousel-author strong {
    color: var(--text-primary);
    font-weight: 800;
  }
  .carousel-dots {
    display: flex;
    justify-content: center;
    gap: 0;
    margin-top: 1rem;
  }
  /* 8px visual dot inside a 40px hit area (the site's touch-target standard;
     it was 28px). The buttons touch, so the dots still sit ~40px apart. The
     dots are created by the script below, so they carry no Astro scoping
     attribute — these rules must be :global or they never match. */
  :global(.carousel-dot) {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: none;
    background: transparent;
    cursor: pointer;
    padding: 0;
    display: grid;
    place-items: center;
    touch-action: manipulation;
  }
  :global(.carousel-dot::before) {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ink-faint);
    transition: all 0.3s ease;
  }
  :global(.carousel-dot.is-active::before) {
    background: var(--color-accent);
    transform: scale(1.3);
  }
</style>

<script is:inline>
(function(){
  var track = document.getElementById('carousel-track');
  var dots = document.getElementById('carousel-dots');
  if (!track || !dots) return;
  var slides = track.querySelectorAll('.carousel-slide');
  var count = slides.length;
  var current = 0;

  // Create dots
  for (var i = 0; i < count; i++) {
    var dot = document.createElement('button');
    dot.className = 'carousel-dot' + (i === 0 ? ' is-active' : '');
    dot.setAttribute('aria-label', 'Go to testimonial ' + (i + 1));
    dot.setAttribute('data-index', i);
    dots.appendChild(dot);
  }

  function goTo(idx) {
    current = idx;
    track.style.transform = 'translateX(-' + (current * 100) + '%)';
    dots.querySelectorAll('.carousel-dot').forEach(function(d, i) {
      d.classList.toggle('is-active', i === current);
    });
  }

  // Auto-rotate every 6 seconds. Auto-advancing content must be pausable
  // (WCAG 2.2.2): hover pauses it for mouse users, and any touch, swipe, dot tap
  // or keyboard focus hands control to the reader for good — touch screens have
  // no hover, so readers there previously could not stop it. Reduced-motion
  // users get no auto-advance at all.
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var timer = null;
  var readerControl = false;
  function start() {
    if (reduce || readerControl || timer) return;
    timer = setInterval(function() { goTo((current + 1) % count); }, 6000);
  }
  function stop() { if (timer) { clearInterval(timer); timer = null; } }
  function takeControl() { readerControl = true; stop(); }
  start();

  dots.addEventListener('click', function(e) {
    var dot = e.target.closest('.carousel-dot');
    if (!dot) return;
    takeControl();
    goTo(parseInt(dot.getAttribute('data-index')));
  });

  var frame = track.parentElement;
  frame.addEventListener('mouseenter', stop);
  frame.addEventListener('mouseleave', start);
  frame.addEventListener('focusin', takeControl);

  // Swipe between testimonials on touch screens.
  var x0 = null, y0 = null;
  frame.addEventListener('touchstart', function(e) {
    takeControl();
    x0 = e.touches[0].clientX; y0 = e.touches[0].clientY;
  }, { passive: true });
  frame.addEventListener('touchend', function(e) {
    if (x0 === null) return;
    var dx = e.changedTouches[0].clientX - x0, dy = e.changedTouches[0].clientY - y0;
    x0 = null;
    if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) goTo((current + (dx < 0 ? 1 : count - 1)) % count);
  }, { passive: true });
})();
</script>
