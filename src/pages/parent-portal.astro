---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<BaseLayout title="Parent Portal | A-Worthy Tuition Centre Singapore" description="A-Worthy's Parent Portal is coming soon: monthly progress reports, lesson summaries and messages with your child's tutor, in one place for parents." noindex={true}>
  <Header slot="header" />

  <section class="section portal-hero">
    <div class="container">
      <span class="eyebrow" data-animate="reveal-up">Parent Portal</span>
      <h1 class="portal-title" data-animate="reveal-up">Your child&rsquo;s <span class="accent-word">progress</span>, in one place</h1>
      <p class="portal-subtitle" data-animate="reveal-up">Monthly progress reports, a short summary after every lesson, and messages with your child&rsquo;s tutor.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="portal-features" data-animate="reveal-up">
        <div class="portal-feature card-lift">
          <div class="portal-feature-icon icon-circle icon-circle--green">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18"/><path d="M7 16l4-4 4 4 5-5"/></svg>
          </div>
          <h3>Progress reports</h3>
          <p>A monthly report on your child&rsquo;s grades, which topics are secure and what to work on next, for each part of the syllabus.</p>
        </div>
        <div class="portal-feature card-lift">
          <div class="portal-feature-icon icon-circle icon-circle--pink">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          </div>
          <h3>Lesson summaries</h3>
          <p>After every lesson, a short note on what was covered, how your child took part, and what to practise that week.</p>
        </div>
        <div class="portal-feature card-lift">
          <div class="portal-feature-icon icon-circle icon-circle--blue">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
          </div>
          <h3>Messages with the tutor</h3>
          <p>Message your child&rsquo;s tutor about homework, upcoming tests or how to revise.</p>
        </div>
        <div class="portal-feature card-lift">
          <div class="portal-feature-icon icon-circle icon-circle--gold">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </div>
          <h3>Attendance and schedule</h3>
          <p>Your child&rsquo;s attendance, upcoming lessons and any schedule changes.</p>
        </div>
        <div class="portal-feature card-lift">
          <div class="portal-feature-icon icon-circle icon-circle--green">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/></svg>
          </div>
          <h3>Resource library</h3>
          <p>Every worksheet, practice paper and set of notes from your child&rsquo;s lessons, kept in one place.</p>
        </div>
        <div class="portal-feature card-lift">
          <div class="portal-feature-icon icon-circle icon-circle--pink">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
          <h3>Goal setting</h3>
          <p>Agree a target for each term with your child&rsquo;s tutor, and see how close they are.</p>
        </div>
      </div>

      <div class="portal-cta" data-animate="reveal-up">
        <img src="/images/mascots/mascot-rocket-fly.webp" alt="" width="308" height="392" class="portal-cta__mascot sticker" loading="lazy" />
        <span class="portal-badge chip chip--blue">Coming soon</span>
        <h2>The Parent Portal is launching soon</h2>
        <p>Until it opens, every enrolled family gets a progress report by email each month: strengths, what to work on and next steps. Students can WhatsApp us questions between lessons.</p>
        <div class="portal-actions">
          <a href="/contact/" class="btn btn-accent">Enquire about enrolment</a>
          <a href="https://wa.me/6589913181" class="btn" target="_blank" rel="noopener noreferrer">WhatsApp us</a>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .portal-title {
    font-family: var(--font-heading);
    font-size: clamp(2.4rem, 5.5vw, 3.8rem);
    font-weight: 900;
    color: var(--text-primary);
    line-height: 1.08;
    margin-bottom: 1rem;
    letter-spacing: -0.03em;
  }
  .portal-subtitle {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--text-secondary);
    /* rem, not px: the root size steps up at >=1441px, and a px cap wrapped
       this to three lines (orphan "journey.") on 1920 screens */
    max-width: 40rem;
    margin-bottom: 1rem;
  }
  .portal-features {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
    margin-bottom: 4rem;
  }
  /* Feature cards — white stickers with a 2px ink outline; lift via global .card-lift */
  .portal-feature {
    background: var(--bg-card);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-md);
    box-shadow: 0 3px 0 var(--ink-shadow);
    padding: 2rem;
  }
  .portal-feature-icon {
    margin-bottom: 1.25rem;
  }
  .portal-feature h3 {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }
  .portal-feature p {
    font-size: 0.95rem; /* >= 15px body copy */
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 0; /* the global p margin left dead space at the card foot */
  }
  .portal-cta {
    text-align: center;
    padding: 3rem;
    background: var(--bg-card);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-md);
    box-shadow: 0 4px 0 var(--ink-shadow);
    max-width: 40rem;
    margin: 0 auto;
  }
  .portal-cta__mascot {
    height: 96px;
    width: auto;
    margin: 0 auto 1rem;
  }
  .portal-badge {
    margin-bottom: 1.25rem;
  }
  .portal-cta h2 {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }
  .portal-cta p {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }
  .portal-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  /* Tablets (portrait and landscape): two columns, 3 even rows of 2. A single
     column stretched each card to ~700px with a 2-line paragraph in it; three
     columns at 1024 squeezed the text to ~200px. */
  @media (max-width: 1024px) {
    .portal-features { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; margin-bottom: 3rem; }
    .portal-feature { padding: 1.5rem; }
  }
  @media (max-width: 768px) {
    .portal-cta { padding: 2rem 1.25rem; }
  }
  /* Phones: one column, tighter cards so six features don't run ~1,800px */
  @media (max-width: 560px) {
    .portal-features { grid-template-columns: minmax(0, 1fr); gap: 1rem; margin-bottom: 2rem; }
    .portal-feature { padding: 1.25rem; }
    .portal-feature-icon { margin-bottom: 0.75rem; }
  }
</style>
