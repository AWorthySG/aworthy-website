---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { studySubjects, studyMaterialMeta } from '../data/study-materials';

/*
 * Every .html file in `public/study/` is picked up automatically at build
 * time — drop a file in and it appears here. Curated titles, subjects and
 * blurbs live in `src/data/study-materials.ts`; anything not listed there
 * falls back to the file's own <title> and <meta name="description">.
 */
const STUDY_DIR = path.join(process.cwd(), 'public', 'study');

const decodeEntities = (s: string): string =>
  s
    .replace(/&amp;/g, '&')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&#0?39;/g, "'")
    .replace(/&apos;/g, "'")
    .replace(/&mdash;/g, '—')
    .replace(/&ndash;/g, '–')
    .replace(/&rsquo;/g, '’')
    .replace(/&lsquo;/g, '‘')
    .replace(/&nbsp;/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();

const titleFromSlug = (slug: string): string =>
  slug.replace(/[-_]+/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());

let filenames: string[] = [];
try {
  filenames = fs.readdirSync(STUDY_DIR).filter((f) => /\.html?$/i.test(f));
} catch {
  filenames = []; // folder not created yet — the page renders its empty state
}

const fallbackSubject = studySubjects[studySubjects.length - 1];

const materials = filenames
  .map((file) => {
    const slug = file.replace(/\.html?$/i, '');
    const meta = studyMaterialMeta[slug] ?? {};
    let title = meta.title;
    let description = meta.description;

    if (!title || !description) {
      const head = fs.readFileSync(path.join(STUDY_DIR, file), 'utf-8').slice(0, 16000);
      if (!title) {
        const m = head.match(/<title[^>]*>([\s\S]*?)<\/title>/i);
        title = m ? decodeEntities(m[1]) : '';
      }
      if (!description) {
        const m = head.match(/<meta[^>]+name=["']description["'][^>]+content=["']([^"']*)["'][^>]*>/i);
        description = m ? decodeEntities(m[1]) : '';
      }
    }

    return {
      slug,
      href: `/study/${file}`,
      title: title || titleFromSlug(slug),
      description: description || '',
      level: meta.level ?? '',
      subject: studySubjects.find((s) => s.id === meta.subject) ?? fallbackSubject,
      order: meta.order ?? 999,
    };
  })
  .sort((a, b) => a.order - b.order || a.title.localeCompare(b.title));

// Only offer a filter row for subjects that actually have something in them.
const activeSubjects = studySubjects.filter((s) => materials.some((m) => m.subject.id === s.id));
const showFilters = activeSubjects.length > 1;
const count = materials.length;
---

<BaseLayout
  title="Study Hub | Live Notes & Study Materials | A-Worthy"
  description="Open your A-Worthy notes and study materials straight in the browser — no downloads, no apps. Frameworks, checklists and revision cards for O-Level English, Maths, H1 GP and H2 Economics."
>
  <Header slot="header" />

  <!-- ===== HERO ===== -->
  <section class="sh-hero">
    <div class="container">
      <p class="eyebrow">Study Hub</p>
      <h1 class="sh-hero__title">Your notes, <span class="accent-word">live</span> in the browser</h1>
      <p class="sh-hero__lead">
        Every study material below opens right here &mdash; nothing to download, nothing to install. Works on a phone
        between classes and on a laptop beside your practice paper. Bookmark any material to come straight back to it.
      </p>
    </div>
    <img src="/images/mascots/mascot-reading.webp" alt="" width="477" height="640" class="sticker sticker--hero" />
  </section>

  <!-- ===== LIBRARY ===== -->
  <section class="section sh-library">
    <div class="container">
      {count > 0 && (
        <div class="sh-bar">
          <p class="sh-count">
            <strong>{count}</strong> {count === 1 ? 'material' : 'materials'} available
          </p>
          {showFilters && (
            <div class="sh-filters" id="sh-filters" role="group" aria-label="Filter materials by subject">
              <button type="button" class="sh-chip is-active" data-filter="all" aria-pressed="true">All</button>
              {activeSubjects.map((s) => (
                <button
                  type="button"
                  class="sh-chip"
                  data-filter={s.id}
                  aria-pressed="false"
                  style={`--chip-accent: ${s.accent};`}
                >
                  {s.short}
                </button>
              ))}
            </div>
          )}
        </div>
      )}

      {count > 0 ? (
        <div class="sh-grid" id="sh-grid">
          {materials.map((m) => (
            <a
              class="sh-card"
              href={m.href}
              data-slug={m.slug}
              data-title={m.title}
              data-subject={m.subject.label}
              data-subject-id={m.subject.id}
              style={`--sub: ${m.subject.accent}; --sub-text: ${m.subject.accentText};`}
            >
              <span class="sh-card__top">
                <span class="sh-card__chip chip">{m.subject.short}</span>
                {m.level && <span class="sh-card__level chip">{m.level}</span>}
              </span>
              <span class="sh-card__title">{m.title}</span>
              {m.description && <span class="sh-card__desc">{m.description}</span>}
              <span class="sh-card__cta" aria-hidden="true">
                Open
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
            </a>
          ))}
        </div>
      ) : (
        <div class="sh-empty">
          <h2 class="sh-empty__title">Materials are on the way</h2>
          <p class="sh-empty__body">
            Your study materials will appear here as soon as they&rsquo;re published. In the meantime, the
            <a href="/frameworks/">framework library</a> and the <a href="/resources/">resource vault</a> have plenty to
            work through.
          </p>
        </div>
      )}

      <p class="sh-note">
        Studying for a specific paper? The <a href="/frameworks/">frameworks page</a> walks through STAMP CARD, SWIFT and
        CAPS interactively, and the <a href="/resources/">resource vault</a> has printable PDFs.
      </p>
    </div>
  </section>

  <!-- ===== FULL-SCREEN VIEWER ===== -->
  <div class="sh-viewer" id="sh-viewer" role="dialog" aria-modal="true" aria-labelledby="sh-viewer-title" hidden>
    <div class="sh-viewer__bar">
      <div class="sh-viewer__meta">
        <span class="sh-viewer__chip chip" id="sh-viewer-chip"></span>
        <h2 class="sh-viewer__title" id="sh-viewer-title"></h2>
      </div>
      <div class="sh-viewer__actions">
        <a class="btn btn--sm sh-viewer__btn" id="sh-newtab" href="#" target="_blank" rel="noopener noreferrer">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><path d="M15 3h6v6"/><path d="M10 14 21 3"/></svg>
          <span class="sh-viewer__btn-label">New tab</span>
        </a>
        <button type="button" class="btn btn--sm sh-viewer__btn sh-viewer__btn--close" id="sh-close">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
          <span class="sh-viewer__btn-label">Close</span>
        </button>
      </div>
    </div>
    <div class="sh-viewer__stage" id="sh-stage">
      <p class="sh-viewer__loading" id="sh-loading" role="status">Loading&hellip;</p>
      <!-- The material's iframe is created per open by the script below. -->
    </div>
  </div>

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* ── Hero ── */
  .sh-hero { padding: 3rem 0 2rem; background: var(--bg-secondary); position: relative; overflow: hidden; }
  .sh-hero__title {
    font-size: clamp(2rem, 4.4vw, 3.4rem); font-weight: 900; line-height: 1.12;
    margin: 0.5rem 0 0.75rem; letter-spacing: -0.02em; color: var(--text-primary);
  }
  .sh-hero__lead { max-width: 680px; font-size: 1.08rem; line-height: 1.65; color: var(--text-secondary); margin: 0; }
  /* The root font scales up from 1441px; a px cap made the lead a narrow ~40-character column at 2560 */
  @media (min-width: 1441px) { .sh-hero__lead { max-width: 42.5rem; } }

  /* ── Bar: count + filters ── */
  .sh-bar {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: 1rem; margin-bottom: 1.5rem;
  }
  .sh-count { margin: 0; font-size: 0.9rem; color: var(--text-secondary); }
  .sh-count strong { color: var(--text-primary); font-weight: 800; }

  /* Filter chips — the LMS tinted-chip look; the active one goes red */
  .sh-filters { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .sh-chip {
    font-family: var(--font-body); font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase;
    font-weight: 700; padding: 0.45rem 0.85rem; min-height: 40px; border-radius: var(--radius-pill); cursor: pointer;
    background: var(--bg-muted); color: var(--text-secondary);
    border: 1.5px solid var(--ink-faint);
    transition: color var(--transition-fast), border-color var(--transition-fast), background var(--transition-fast);
  }
  .sh-chip:hover { color: var(--text-primary); border-color: var(--color-ink); background: var(--bg-hover); }
  .sh-chip.is-active {
    color: var(--color-accent-text); background: var(--color-danger-bg); border-color: var(--color-accent);
  }

  /* ── Card grid — white ink cards with a subject-coloured top edge ── */
  .sh-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.15rem; }
  .sh-card {
    display: flex; flex-direction: column; gap: 0.55rem; padding: 1.35rem 1.4rem;
    background: var(--bg-card); border: 2px solid var(--color-ink); border-top: 6px solid var(--sub);
    border-radius: var(--radius-md); text-decoration: none; color: inherit;
  }
  .sh-card:hover { color: inherit; opacity: 1; }
  .sh-card[hidden] { display: none; }

  .sh-card__top { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; flex-wrap: wrap; }
  /* --sub is the subject dot colour (top edge, chip border); --sub-text is its AA text pair — both tokens swap in dark mode */
  .sh-card__chip { background: var(--bg-card); color: var(--sub-text); border-color: var(--sub); }
  .sh-card__level { text-transform: none; letter-spacing: 0.02em; font-size: 0.75rem; }
  .sh-card__title { font-size: 1.08rem; font-weight: 800; line-height: 1.35; color: var(--text-primary); letter-spacing: -0.01em; }
  .sh-card__desc { font-size: 0.9rem; line-height: 1.55; color: var(--text-secondary); flex: 1; }
  .sh-card__cta {
    display: inline-flex; align-items: center; gap: 0.35rem; margin-top: 0.35rem;
    font-family: var(--font-body); font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase;
    font-weight: 700; color: var(--sub-text);
  }
  .sh-card:hover .sh-card__cta svg { transform: translateX(3px); }
  .sh-card__cta svg { transition: transform var(--transition-fast); }

  /* ── Empty state ── */
  .sh-empty {
    text-align: center; padding: 3rem 1.5rem; border: 2px dashed var(--ink-faint);
    border-radius: var(--radius-md); background: var(--bg-card);
  }
  .sh-empty__title { font-size: 1.25rem; font-weight: 800; margin: 0 0 0.5rem; }
  .sh-empty__body { margin: 0 auto; max-width: 46ch; color: var(--text-secondary); line-height: 1.6; }

  /* Capped measure: uncapped it ran as one ~150-character line on laptops and desktops */
  .sh-note { max-width: 68ch; margin: 2rem auto 0; font-size: 0.9375rem; line-height: 1.6; color: var(--text-secondary); text-align: center; }
  .sh-note a, .sh-empty__body a { color: var(--color-accent-text); font-weight: 700; }

  /* ── Full-screen viewer ── */
  .sh-viewer {
    position: fixed; inset: 0; z-index: var(--z-modal);
    display: flex; flex-direction: column; background: var(--bg-primary);
  }
  .sh-viewer[hidden] { display: none; }
  .sh-viewer__bar {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding: 0.7rem 1rem; padding-top: max(0.7rem, env(safe-area-inset-top));
    /* viewport-fit=cover: in landscape the notch / rounded corners sit over the sides */
    padding-left: max(1rem, env(safe-area-inset-left)); padding-right: max(1rem, env(safe-area-inset-right));
    background: var(--bg-card); border-bottom: 2px solid var(--color-ink); flex: 0 0 auto;
  }
  .sh-viewer__meta { display: flex; flex-direction: column; align-items: flex-start; gap: 0.3rem; min-width: 0; }
  .sh-viewer__chip { background: var(--bg-card); color: var(--chip, var(--text-secondary)); border-color: var(--chip-border, var(--ink-faint)); }
  .sh-viewer__chip:empty { display: none; }
  .sh-viewer__title {
    margin: 0; font-size: 0.98rem; font-weight: 800; line-height: 1.3; color: var(--text-primary);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%;
  }
  .sh-viewer__actions { display: flex; gap: 0.5rem; flex: 0 0 auto; }
  /* Size-only tweaks — the pill, ink border and hard shadow come from the global .btn.btn--sm */
  .sh-viewer__btn { gap: 0.4rem; padding: 0.5rem 0.85rem; font-size: 0.82rem; }
  .sh-viewer__btn--close:hover { color: var(--color-accent-text); }
  /* The frame is absolutely positioned inside a stage that takes the rest of
     the viewer's height. That sizes it identically in every engine (no
     percentage-of-flex-item ambiguity), and the frame is never display:none —
     the loading state is an overlay on top of it, because hiding an iframe
     while it navigates is a known way to end up with a blank frame in Safari. */
  .sh-viewer__stage { position: relative; flex: 1 1 auto; min-height: 0; background: var(--bg-primary); }
  /* :global() because the iframe is created by script, so it never receives
     Astro's scoping attribute — a plain scoped selector would not match it and
     the frame would fall back to the browser's default 300×150 box. */
  .sh-viewer__stage :global(.sh-viewer__frame) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; background: #fff; }
  .sh-viewer__loading {
    position: absolute; inset: 0; z-index: 1;
    display: grid; place-items: center; margin: 0; padding: 2rem 1rem;
    background: var(--bg-primary); color: var(--text-secondary);
    font-family: var(--font-body); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
  }
  .sh-viewer:not(.is-loading) .sh-viewer__loading { display: none; }

  /* ── Responsive ── */
  @media (max-width: 1024px) { .sh-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 768px) {
    .sh-hero { padding: 2.25rem 0 1.5rem; }
    .sh-bar { flex-direction: column; align-items: flex-start; gap: 0.75rem; }
  }
  /* One column only on phones: at 641–768px (iPad portrait) a single column made ~700px-wide cards */
  @media (max-width: 640px) { .sh-grid { grid-template-columns: minmax(0, 1fr); } }
  /* Landscape phones are ~390px tall: put the chip and title on one row so the bar is ~55px, not 75px */
  @media (max-height: 500px) and (orientation: landscape) {
    .sh-viewer__bar { padding-top: max(0.4rem, env(safe-area-inset-top)); padding-bottom: 0.4rem; }
    .sh-viewer__meta { flex-direction: row; align-items: center; gap: 0.6rem; }
    .sh-viewer__chip { flex: 0 0 auto; }
  }
  @media (max-width: 480px) {
    .sh-viewer__btn-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .sh-viewer__btn { padding: 0.5rem 0.7rem; min-width: 40px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sh-card, .sh-card__cta svg { transition: none; }
    .sh-card:hover { transform: none; }
  }
</style>

<style is:global>
  /* BaseLayout's scroll-progress bar sits above modals (z-index), so while the
     viewer is open it drew a red line across the viewer bar. Global block:
     the bar lives in BaseLayout, outside this page's scope. */
  body:has(#sh-viewer:not([hidden])) .scroll-progress { display: none; }
</style>

<script is:inline>
  function initStudyHub() {
    var grid = document.getElementById('sh-grid');
    var viewer = document.getElementById('sh-viewer');
    if (!viewer || (grid && grid.dataset.bound === '1')) return;
    if (grid) grid.dataset.bound = '1';

    var stage = document.getElementById('sh-stage');
    var frame = null;          // the current material's iframe, created per open
    var frameTimer = 0;
    var titleEl = document.getElementById('sh-viewer-title');
    var chipEl = document.getElementById('sh-viewer-chip');
    var newTab = document.getElementById('sh-newtab');
    var closeBtn = document.getElementById('sh-close');
    var filters = document.getElementById('sh-filters');
    var lastFocused = null;
    var loadToken = 0;

    /*
     * Materials are injected via `srcdoc` rather than `src`, so they render
     * without the site's own framing restrictions ever being loosened for a
     * real URL. A `srcdoc` document has no HTTP response, but it does INHERIT
     * this page's CSP, including frame-ancestors. Safari enforces that
     * inherited frame-ancestors on the srcdoc document, so with the old
     * `frame-ancestors 'none'` every material rendered as a blank white frame
     * on iPhone and Mac while working fine in Chrome. The header is now
     * `frame-ancestors 'self'` (vercel.json and public/_headers) — keep it that
     * way. As a last line of defence the loader below also detects an empty
     * frame and opens the material as its own page instead.
     */
    /*
     * In a srcdoc document, in-page anchors (href="#section") resolve against
     * the inherited base URL, so clicking one NAVIGATES the frame to /study/#section
     * instead of scrolling. Any material with a table of contents would break.
     * This shim intercepts same-document fragment links and scrolls instead.
     * It is injected by the viewer so materials need no modification.
     */
    var ANCHOR_SHIM =
      '<script>(function(){document.addEventListener("click",function(e){' +
      'var a=e.target&&e.target.closest?e.target.closest(\'a[href^="#"]\'):null;' +
      'if(!a||a.target)return;var h=a.getAttribute("href");if(!h)return;' +
      'var id=h.slice(1);e.preventDefault();' +
      'if(!id){window.scrollTo({top:0,behavior:"smooth"});return;}' +
      'var t=document.getElementById(id)||document.getElementsByName(id)[0];' +
      'if(t)t.scrollIntoView({behavior:"smooth",block:"start"});' +
      '});})();<\/script>';

    /*
     * Fonts do not cross document boundaries, so the material cannot use the
     * page's Nunito. Give it the same self-hosted files (same-origin, allowed
     * by font-src 'self'); a material that already declares them is unaffected.
     */
    var FONT_FACES =
      '<style>' +
      "@font-face{font-family:'Nunito';font-style:normal;font-weight:200 1000;font-display:swap;src:url('/fonts/nunito-latin-wght-normal.woff2') format('woff2')}" +
      "@font-face{font-family:'Nunito';font-style:italic;font-weight:200 1000;font-display:swap;src:url('/fonts/nunito-latin-wght-italic.woff2') format('woff2')}" +
      '</style>';

    function prepareDoc(html) {
      var head = '<base href="/study/">' + FONT_FACES;
      var out = /<head[^>]*>/i.test(html)
        ? html.replace(/<head([^>]*)>/i, '<head$1>' + head)
        : head + html;
      return /<\/body>/i.test(out)
        ? out.replace(/<\/body>/i, ANCHOR_SHIM + '</body>')
        : out + ANCHOR_SHIM;
    }

    function removeFrame() {
      clearTimeout(frameTimer);
      if (frame) { frame.remove(); frame = null; }
    }

    function openStandalone(src) {
      // The material is also a normal page; if the viewer cannot show it,
      // go there rather than leave the reader looking at nothing.
      window.location.href = src;
    }

    /*
     * Each open builds a brand-new iframe with its srcdoc already set, then
     * inserts it: exactly one navigation, nothing left over from a previous
     * material, and no about:blank load racing the srcdoc one. The loading
     * overlay stays up until the frame's own load event confirms there is a
     * document with content in it.
     */
    function loadIntoFrame(src, title) {
      var token = ++loadToken;
      removeFrame();
      viewer.classList.add('is-loading');
      fetch(src, { credentials: 'same-origin' })
        .then(function (r) {
          if (!r.ok) throw new Error('HTTP ' + r.status);
          return r.text();
        })
        .then(function (html) {
          if (token !== loadToken) return; // a newer material was opened
          var f = document.createElement('iframe');
          f.className = 'sh-viewer__frame';
          f.title = title || 'Study material';
          f.addEventListener('load', function () {
            if (token !== loadToken || f !== frame) return;
            var doc = null, url = '';
            try { doc = f.contentDocument; url = f.contentWindow.location.href; } catch (e) {}
            // Some engines report the initial about:blank before the srcdoc
            // document; wait for the real one (the timer covers "never").
            if (url === 'about:blank') return;
            clearTimeout(frameTimer);
            if (!doc || !doc.body || !doc.body.childElementCount) { openStandalone(src); return; }
            viewer.classList.remove('is-loading');
          });
          f.srcdoc = prepareDoc(html);
          frame = f;
          stage.appendChild(f);
          frameTimer = setTimeout(function () {
            if (token === loadToken && viewer.classList.contains('is-loading')) openStandalone(src);
          }, 5000);
        })
        .catch(function () {
          if (token !== loadToken) return;
          openStandalone(src);
        });
    }

    function cardFor(slug) {
      if (!grid || !slug) return null;
      var cards = grid.querySelectorAll('.sh-card');
      for (var i = 0; i < cards.length; i++) {
        if (cards[i].dataset.slug === slug) return cards[i];
      }
      return null;
    }

    function openCard(card, updateHash) {
      if (!card) return;
      lastFocused = document.activeElement;
      var src = card.getAttribute('href');
      titleEl.textContent = card.dataset.title;
      chipEl.textContent = card.dataset.subject;
      var cardStyle = getComputedStyle(card);
      chipEl.style.setProperty('--chip', cardStyle.getPropertyValue('--sub-text'));
      chipEl.style.setProperty('--chip-border', cardStyle.getPropertyValue('--sub'));
      newTab.setAttribute('href', src);
      loadIntoFrame(src, card.dataset.title);
      viewer.hidden = false;
      document.body.style.overflow = 'hidden';
      closeBtn.focus();
      if (updateHash) {
        try { history.pushState(null, '', '#' + card.dataset.slug); } catch (e) {}
      }
      if (typeof window.plausible === 'function') {
        window.plausible('Study Material Opened', { props: { material: card.dataset.slug } });
      }
    }

    function closeViewer(updateHash) {
      if (viewer.hidden) return;
      viewer.hidden = true;
      loadToken++; // cancel any in-flight load
      removeFrame();
      viewer.classList.remove('is-loading');
      document.body.style.overflow = '';
      if (updateHash && window.location.hash) {
        try { history.pushState(null, '', window.location.pathname); } catch (e) {}
      }
      if (lastFocused && typeof lastFocused.focus === 'function') lastFocused.focus();
    }

    if (grid) {
      grid.addEventListener('click', function (e) {
        // Let modified clicks (new tab, download) behave natively.
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
        var card = e.target.closest ? e.target.closest('.sh-card') : null;
        if (!card || !grid.contains(card)) return;
        e.preventDefault();
        openCard(card, true);
      });
    }

    closeBtn.addEventListener('click', function () { closeViewer(true); });

    if (filters) {
      filters.addEventListener('click', function (e) {
        var btn = e.target.closest ? e.target.closest('.sh-chip') : null;
        if (!btn) return;
        var want = btn.dataset.filter;
        var chips = filters.querySelectorAll('.sh-chip');
        for (var i = 0; i < chips.length; i++) {
          var on = chips[i] === btn;
          chips[i].classList.toggle('is-active', on);
          chips[i].setAttribute('aria-pressed', on ? 'true' : 'false');
        }
        var cards = grid ? grid.querySelectorAll('.sh-card') : [];
        for (var j = 0; j < cards.length; j++) {
          cards[j].hidden = want !== 'all' && cards[j].dataset.subjectId !== want;
        }
      });
    }

    // Escape closes the viewer (guarded so a second init cannot stack handlers).
    if (window.__shEscHandler) document.removeEventListener('keydown', window.__shEscHandler);
    window.__shEscHandler = function (e) {
      if (e.key === 'Escape' && !viewer.hidden) closeViewer(true);
    };
    document.addEventListener('keydown', window.__shEscHandler);

    // Deep links: /study/#slug opens that material directly, and Back closes it.
    function syncFromHash(updateHash) {
      var slug = window.location.hash.replace(/^#/, '');
      var card = cardFor(slug);
      if (card) openCard(card, false);
      else closeViewer(updateHash);
    }
    if (window.__shPopHandler) window.removeEventListener('popstate', window.__shPopHandler);
    window.__shPopHandler = function () { syncFromHash(false); };
    window.addEventListener('popstate', window.__shPopHandler);

    if (window.location.hash) syncFromHash(false);
  }

  initStudyHub();
</script>
