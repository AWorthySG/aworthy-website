          <p class="speech-bubble prog-hero__intake">Next intake: <strong>{nextIntakeLabel}</strong> &middot; Year 3 &amp; Year 4 &middot; max 6 per class</p>
        </div>
        <img class="sticker sticker--right prog-hero__sticker" src="/images/mascots/mascot-graph.webp" alt="" width="418" height="550" loading="eager" decoding="async" />
      </div>
    </div>
