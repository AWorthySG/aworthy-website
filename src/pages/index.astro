<script is:inline>
  // Show sticky CTA after scrolling past hero, with dismiss support
  (function() {
    const sticky = document.getElementById('sticky-cta');
    const dismissBtn = document.getElementById('sticky-cta-dismiss');
    if (!sticky) return;
    let dismissed = false;
    let shown = false;
    window.aworthyOnScroll(function(y) {
      if (dismissed) return;
      const visible = y > window.innerHeight * 0.8;
      if (visible === shown) return;
      shown = visible;
      const h = visible ? sticky.offsetHeight : 0;
      sticky.classList.toggle('is-visible', visible);
      window.aworthyBottomBar('cta', h);
    });
    dismissBtn?.addEventListener('click', function() {
      dismissed = true;
      sticky.classList.remove('is-visible');
      window.aworthyBottomBar('cta', 0);
    });
  })();
</script>

<!-- Contact form handling. The lead event fires only when Formspree answers OK;
     after a send the button stays disabled and a pre-filled WhatsApp button
     asks for the test or exam paper. Works with or without the sitewide helpers
     (aworthyWaRef, aworthyAttachAttribution, plausible). -->
<script is:inline>
(function(){
  var form = document.getElementById('contact-form');
  if (!form) return;
  var btn = document.getElementById('form-submit-btn');
  var successEl = document.getElementById('form-success');
  var successWa = document.getElementById('form-success-wa');
  var errorsEl = document.getElementById('form-errors');
  var EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  function waHref(text) {
    var ref = 'WEB';
    try { if (typeof window.aworthyWaRef === 'function') ref = window.aworthyWaRef() || 'WEB'; } catch (e) {}
    return 'https://wa.me/6589913181?text=' + encodeURIComponent(text + ' [ref: ' + ref + ']');
  }
  function showErrors(nodes) {
    errorsEl.textContent = '';
    nodes.forEach(function (n) { errorsEl.appendChild(n); });
    errorsEl.hidden = false;
  }
  function para(text) { var p = document.createElement('p'); p.textContent = text; return p; }

  form.addEventListener('submit', function(e) {
    e.preventDefault();
    errorsEl.hidden = true;
    var parentName = form.querySelector('[name="parentName"]');
    var email = form.querySelector('[name="email"]');
    var phone = form.querySelector('[name="phone"]');
    var level = form.querySelector('[name="studentLevel"]');
    var subject = form.querySelector('[name="subject"]');
    var errors = [], invalid = [];
    [parentName, email, phone, level, subject].forEach(function (f) { f.removeAttribute('aria-invalid'); });
    var digits = phone.value.replace(/\D/g, '');
    if (!parentName.value.trim()) { errors.push('Please tell us what to call you.'); invalid.push(parentName); }
    if (!phone.value.trim()) { errors.push('Please enter your WhatsApp or phone number.'); invalid.push(phone); }
    else if (digits.length < 8 || digits.length > 15) { errors.push('Please enter a valid WhatsApp or phone number.'); invalid.push(phone); }
    if (!level.value) { errors.push('Please choose your child’s level.'); invalid.push(level); }
    if (!subject.value) { errors.push('Please choose a subject.'); invalid.push(subject); }
    if (email.value.trim() && !EMAIL_RE.test(email.value.trim())) { errors.push('Please enter a valid email address, or leave the email blank.'); invalid.push(email); }
    if (errors.length) {
      showErrors(errors.map(para));
      invalid.forEach(function (f) { f.setAttribute('aria-invalid', 'true'); });
      invalid[0].focus();
      return;
    }
    var who = parentName.value.trim(), lvl = level.value, subj = subject.value;
    form.querySelector('[name="_subject"]').value = 'Homepage enquiry: ' + subj;
    if (typeof window.aworthyAttachAttribution === 'function') {
      try { window.aworthyAttachAttribution(form); } catch (err) {}
    }
    btn.disabled = true;
    btn.innerHTML = '<span>Sending…</span>';

    function sent() {
      if (typeof window.plausible === 'function') {
        try { window.plausible('Lead: Homepage Form', { props: { subject: subj } }); } catch (err) {}
      }
      if (window.aworthyCelebrate) window.aworthyCelebrate();
      // stays disabled: one enquiry per visit, and the WhatsApp button is the next step
      btn.innerHTML = '<span>Sent</span>';
      successWa.href = waHref('Hi Jeremy, I\'m ' + who + '. I\'ve just asked for a free assessment for my child (' + lvl + ', ' + subj + '). Here is the latest test or exam paper.');
      successEl.hidden = false;
      // centred: clear of the fixed header and of the sticky bar on phones
      try { successEl.focus({ preventScroll: true }); } catch (err) { successEl.focus(); }
      successEl.scrollIntoView({ block: 'center' });
    }
    function failed() {
      btn.disabled = false;
      btn.innerHTML = '<span>Get a Free Report</span>';
      var p = document.createElement('p');
      var a = document.createElement('a');
      a.href = waHref('Hi Jeremy, I\'m ' + who + '. I\'d like a free assessment for my child (' + lvl + ', ' + subj + ').');
      a.target = '_blank';
      a.rel = 'noopener noreferrer';
      a.textContent = 'send your request on WhatsApp';
      p.appendChild(document.createTextNode('Sorry, your message didn’t go through. Please try again, or '));
      p.appendChild(a);
      p.appendChild(document.createTextNode('.'));
      showErrors([p]);
      errorsEl.scrollIntoView({ block: 'center' });
    }
    fetch(form.action, {
      method: 'POST',
      body: new FormData(form),
      headers: { 'Accept': 'application/json' }
    }).then(function(r) { if (r.ok) sent(); else failed(); }, failed);
  });
})();
</script>

<!-- Programme Quiz Logic (#8) -->
<script is:inline>
(function(){
  var quiz = document.getElementById('programme-quiz');
  if (!quiz) return;
  var answers = {};

  quiz.addEventListener('click', function(e) {
    var btn = e.target.closest('.quiz-option');
    if (!btn) return;
    var step = btn.closest('.quiz-step');
    var stepNum = step.getAttribute('data-step');
    answers[stepNum] = btn.getAttribute('data-value');

    // Highlight selected
    step.querySelectorAll('.quiz-option').forEach(function(b){ b.classList.remove('selected'); });
    btn.classList.add('selected');

    var next = btn.getAttribute('data-next');
    if (next === 'result') {
      setTimeout(function(){ showResult(); }, 300);
    } else {
      setTimeout(function(){
        step.hidden = true;
        var nextStep = quiz.querySelector('[data-step="' + next + '"]');
        if (nextStep) nextStep.hidden = false;
      }, 300);
    }
  });

  function showResult() {
    quiz.querySelectorAll('.quiz-step').forEach(function(s){ s.hidden = true; });
    var result = document.getElementById('quiz-result');
    var title = document.getElementById('quiz-result-title');
    var desc = document.getElementById('quiz-result-desc');
    var isIndividual = answers['3'] === 'individual';
    var isJunior = answers['1'] === 'sec1-2';
    var isJC = answers['1'] === 'jc';
    var isEcons = answers['1b'] === 'econs';
    var isMaths = answers['1a'] === 'maths';
    var link = document.getElementById('quiz-result-link');

    if (isIndividual) {
      title.textContent = 'One-to-one coaching';
      desc.textContent = 'One-to-one sessions built around your child’s weakest question types, at a time you choose. SGD 120/session (O-Level, IB) or SGD 140 (JC).';
      link.href = '/programmes/';
    } else if (isJC && isEcons) {
      title.textContent = 'H2 Economics';
      desc.textContent = 'H2 Economics across micro and macro: diagrams, essay technique and case studies, each with its own SHARP framework. From SGD 360/month.';
      link.href = '/h2-economics/';
    } else if (isJC) {
      title.textContent = 'H1 General Paper';
      desc.textContent = 'Essays and the application question: building an argument, reading critically and planning under time pressure, across every theme. From SGD 360/month.';
      link.href = '/h1-general-paper/';
    } else if (isJunior && isMaths) {
      title.textContent = 'Sec 1–2 Maths: the foundations';
      desc.textContent = 'Solid algebra and geometry before Sec 3 adds new topics. One 90-minute lesson a week in a group of up to 6. SGD 280/month.';
      link.href = '/o-level-mathematics/#sec1-2';
    } else if (isMaths) {
      title.textContent = 'Sec 3–4 O-Level Maths: exam preparation';
      desc.textContent = 'Both O-Level papers, topic by topic, with a named SHARP framework for each question type. One 90-minute lesson a week. SGD 320/month.';
      link.href = '/o-level-mathematics/#sec3-4';
    } else if (isJunior) {
      title.textContent = 'Sec 1–2 English: the foundations';
      desc.textContent = 'Comprehension, composition and editing, taught with the frameworks your child will use in the O-Level exam. One 90-minute lesson a week in a group of up to 6. SGD 280/month.';
      link.href = '/o-level-english/#sec1-2';
    } else {
      title.textContent = 'Sec 3–4 O-Level English: exam preparation';
      desc.textContent = 'Paper by paper, with a mock paper marked every month and a SHARP framework for each component. One 90-minute lesson a week. SGD 320/month.';
      link.href = '/o-level-english/#sec3-4';
    }
    result.hidden = false;
  }

  var restart = document.getElementById('quiz-restart');
  if (restart) {
    restart.addEventListener('click', function(){
      answers = {};
      document.getElementById('quiz-result').hidden = true;
      quiz.querySelectorAll('.quiz-step').forEach(function(s){ s.hidden = true; });
      quiz.querySelector('[data-step="1"]').hidden = false;
      quiz.querySelectorAll('.quiz-option').forEach(function(b){ b.classList.remove('selected'); });
    });
  }
})();
</script>

<!-- Audience Toggle -->
<script is:inline>
document.querySelectorAll('.audience-btn').forEach(function(btn) {
  btn.addEventListener('click', function() {
    document.querySelectorAll('.audience-btn').forEach(function(b) {
      b.classList.remove('active');
      b.setAttribute('aria-selected', 'false');
    });
    btn.classList.add('active');
    btn.setAttribute('aria-selected', 'true');
    var audience = btn.dataset.audience;
    document.getElementById('msg-parent').hidden = audience !== 'parent';
    document.getElementById('msg-student').hidden = audience !== 'student';
  });
});
</script>

<style>
  /* ===== HOMEPAGE — LMS "sticker-book" system =====
     Cream paper canvas (body texture shows through — no section fills except
     the .section--sand bands), white cards outlined in 2px ink, one red action
     per view, grey micro-labels, coloured stat dots / tinted chips for data.
     All colour comes from global.css tokens — nothing hardcoded here. */

  /* Hero wash — two soft tints (sun top-left, sky bottom-right), never gold. */
  .hero-depth-layer {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(55% 45% at 12% 18%, color-mix(in srgb, var(--color-sun) 12%, transparent) 0%, transparent 70%),
      radial-gradient(45% 40% at 88% 82%, color-mix(in srgb, var(--color-sky) 10%, transparent) 0%, transparent 70%);
  }

  /* ===== EYEBROW (global look; block-level here so it sits above headings) ===== */
  .eyebrow {
    display: block;
    margin-bottom: 0.75rem;
  }

  /* ===== SECTION HEADING ===== */
  .section-heading {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.08;
    margin-bottom: 0.75rem;
    /* rem, not px: the cap has to grow with the root font at >=1441px, or the
       headings wrap to 3-4 lines on 1920/2560 screens (700px at 16px). */
    max-width: 43.75rem;
    letter-spacing: -0.03em;
  }

  .testimonials-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .testimonials-head__mascot {
    height: 130px;
    width: auto;
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .testimonials-head__mascot { display: none; }
  }

  .contact-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .contact-head__mascot {
    height: 140px;
    width: auto;
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .contact-head__mascot { display: none; }
  }

  /* ===== SECTION SPACING ===== */
  .section {
    padding: 1.75rem 0;
    /* header + subject bar (--nav-offset drops the bar where it's hidden), so a
       /#contact jump doesn't land under the fixed bars */
    scroll-margin-top: var(--nav-offset);
  }

  /* ===== HERO ===== */
  .hero {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    /* Top padding must clear the fixed header + subject bar: the negative
       margin pulls the hero under them, and on shorter viewports (~900px)
       flex-centering pushed the kicker/prelude up into the nav. */
    padding: calc(var(--nav-offset) + 1.5rem) 0 2rem;
    overflow: hidden;
    position: relative;
    margin-top: calc(-1 * var(--nav-offset));
  }

  /* ── Hero entrance — a short staggered cascade, over 0.8s after first paint
     (the last item, --d:17, starts at 0.31s and ends at 0.76s; the letters
     end at 0.78s, the swash at 0.8s). It used to start at 0.6s and run to
     ~4s, so a parent who arrived and scrolled straight away met a half-empty
     hero. The buttons (.hero-btns) never animate. Later homepage views in the
     same session skip it entirely (html.hero-seen, set by the inline script
     before the hero). ── */
  .hero-anim {
    opacity: 0;
    transform: translateY(16px);
    animation: hero-rise 0.45s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(var(--d) * 0.018s);
  }
  @keyframes hero-rise {
    to { opacity: 1; transform: translateY(0); }
  }

  .hero-centre {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 900px;
    padding: 0 2rem;
  }

  .hero-kicker {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }

  .hero-display {
    text-align: center;
    margin-bottom: 2rem;
    position: relative;
  }

  .hero-prelude {
    display: block;
    font-family: var(--font-body);
    font-size: clamp(1rem, 2.5vw, 1.5rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }

  .hero-prelude-word {
    display: inline-block;
    opacity: 0;
    transform: translateY(12px);
    animation: prelude-in 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(0.05s + var(--i) * 0.06s);
  }

  @keyframes prelude-in {
    to { opacity: 1; transform: translateY(0); }
  }

  .hero-tagline {
    display: block;
    font-family: var(--font-heading);
    font-size: clamp(4rem, 12vw, 8.5rem);
    font-weight: 900;
    font-style: normal;
    line-height: 0.95;
    letter-spacing: -0.04em;
    color: var(--text-primary);
    /* The per-letter spans must never wrap mid-word ("A Worth / y") */
    white-space: nowrap;
  }

  .hero-letter {
    display: inline-block;
    opacity: 0;
    transform: translateY(24px) scale(0.9);
    filter: blur(4px);
    animation: letter-reveal 0.45s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(0.08s + var(--i) * 0.035s);
  }

  /* "Worthy" — the one emphasised word, solid red like the LMS's "purpose." */
  .hero-letter--italic {
    font-style: normal;
    font-weight: 900;
    color: var(--color-accent-text);
  }

  .hero-letter--space {
    width: 0.25em;
  }

  @keyframes letter-reveal {
    40% { filter: blur(1px); }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: blur(0);
    }
  }

  /* Red marker swash drawn in under the display as the letters land (0.45s → 0.8s).
     Drawn with clip-path, not width: an animated width re-laid out the hero
     on every frame. */
  .hero-underline {
    display: block;
    width: 88px;
    height: 14px;
    margin: 0.5rem auto 0;
    background: var(--swash) left center / 88px 14px no-repeat;
    clip-path: inset(0 100% 0 0);
    animation: underline-draw 0.35s cubic-bezier(0.16, 1, 0.3, 1) 0.45s forwards;
  }

  @keyframes underline-draw {
    to { clip-path: inset(0 0 0 0); }
  }

  /* Later homepage views in the same session: no entrance at all */
  :global(html.hero-seen) .hero-anim,
  :global(html.hero-seen) .hero-prelude-word,
  :global(html.hero-seen) .hero-letter {
    opacity: 1;
    transform: none;
    filter: none;
    animation: none;
  }
  :global(html.hero-seen) .hero-underline { clip-path: none; animation: none; }

  /* Hero subtitle — capped measure for readability. */
  .hero-sub {
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    line-height: 1.5;
    color: var(--text-secondary);
    max-width: 58ch;
    margin: 0 auto 1.5rem;
    letter-spacing: -0.005em;
    text-wrap: pretty;
  }

  /* Proof row — stat dots + 900 numbers, like the LMS "150+ / AI / 7 / 100%" row. */
  .hero-proof-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    max-width: 560px;
    margin: 0 auto 1.25rem;
    padding: 1rem 0;
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
  }

  .hero-proof-item {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-proof-num {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--text-primary);
    font-feature-settings: "tnum" 1, "lnum" 1;
    font-variant-numeric: tabular-nums lining-nums;
  }

  .hero-proof-lbl {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    margin-top: 0.4rem;
  }

  /* Intake / pricing line rides on the global .speech-bubble (LMS welcome-card
     callout); the 1.75rem bottom margin leaves room for the bubble's tail. */
  .hero-meta {
    font-size: 0.85rem;
    margin-bottom: 1.75rem;
    line-height: 1.55;
    max-width: 640px;
    text-align: left;
  }

  .hero-meta strong {
    color: var(--text-primary);
  }

  .hero-meta a {
    color: var(--color-accent-text);
    text-decoration: none;
    font-weight: 700;
    white-space: nowrap;
  }

  .hero-meta a:hover {
    text-decoration: underline;
  }

  .hero-btns {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  /* CTAs inherit the sticker-pill look from the global .btn / .btn-accent —
     only size is tweaked here. */
  .hero-cta-primary {
    padding: 0.9rem 2.25rem;
    font-size: 1rem;
  }

  .hero-cta-secondary {
    padding: 0.9rem 1.9rem;
    font-size: 1rem;
  }

  .hero-badges-row {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* Cheer sticker floats in the empty margin beside the display; hidden once
     that margin gets narrow enough to collide with the headline. */
  .hero-sticker {
    position: absolute;
    right: -9rem;
    top: 24%;
    width: 170px;
    z-index: 1;
  }
  @media (max-width: 1279px) {
    .hero-sticker { display: none; }
  }

  /* Scroll cue */




  /* ===== STICKY MOBILE CTA — solid cream strip with an ink top rule ===== */
  .sticky-cta {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: var(--bg-primary); /* solid: a backdrop blur repainted the page under the bar on every scroll frame */
    padding: 0.5rem var(--space-lg);
    /* Safe area for notched phones */
    padding-bottom: calc(0.5rem + env(safe-area-inset-bottom, 0px));
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    z-index: var(--z-sticky-bar); /* --z-sticky-cta never existed: the invalid var() left the bar at z-index auto, so page content painted over it */
    transform: translateY(100%);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    border-top: 2px solid var(--color-ink);
  }

  .sticky-cta.is-visible {
    transform: translateY(0);
  }

  .sticky-cta-btn {
    /* rem so the pill grows with the root font — at 2560 (150%) a 360px
       basis wrapped "Get a Free Report" onto two lines */
    flex: 0 1 22.5rem;
    text-align: center;
    display: block;
  }
  /* <=768 the pill fills the row beside the WhatsApp icon, and the bar's right
     padding reserves 44px for the absolutely-placed dismiss (it sat on top of
     the red pill at 641-768 before). width:auto — the phone .btn rule in
     global.css sets width:100%, which pushed the pill under the ×. */
  @media (max-width: 768px) {
    .sticky-cta-btn { flex: 1 1 auto; min-width: 0; width: auto; }
  }

  /* WhatsApp icon — the same round green sticker as the WhatsApp float
     (ink outline, hard shadow, ink glyph: white on this green fails 3:1) */
  .sticky-cta-wa {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-whatsapp);
    border: 2px solid var(--color-ink);
    box-shadow: 0 3px 0 var(--ink-shadow);
    text-decoration: none;
    touch-action: manipulation;
    transition: background-color 0.12s ease, transform 0.1s ease, box-shadow 0.1s ease;
  }
  .sticky-cta-wa svg { fill: #22304A; }
  @media (hover: hover) {
    .sticky-cta-wa:hover { background: #4BE07F; }
  }
  .sticky-cta-wa:active {
    transform: translateY(3px);
    box-shadow: 0 0 0 var(--ink-shadow);
  }

  .sticky-cta-dismiss {
    position: absolute;
    top: 0.25rem;
    right: 0.25rem;
    background: none;
    border: none;
    color: var(--text-secondary);
    font-size: 1.25rem;
    cursor: pointer;
    padding: 0.5rem;
    min-width: 44px;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    touch-action: manipulation;
  }

  .sticky-cta-dismiss:hover {
    color: var(--text-primary);
  }

  @media (max-width: 768px) {
    .sticky-cta {
      gap: 0.5rem;
      padding-left: 0.75rem;
      padding-right: calc(0.25rem + 44px + 0.25rem);
    }
    /* level with the 44px pill and icon */
    .sticky-cta-dismiss {
      top: 0.5rem;
    }
    .section {
      padding: 1.5rem 0;
    }
  }

  /* Landscape phones: the header already carries the CTA; a bottom bar here
     only eats a ~390px-tall screen (same rule as the global sticky CTA).
     Must come AFTER the <=768 display:block above, or 667x375 / 740x360
     landscape phones still got the bar. */
  @media (max-height: 500px) and (orientation: landscape) {
    .sticky-cta {
      display: none;
    }
  }
  /* Short laptop screens: the header carries the CTA from 1025px up (same
     rule as the global sticky CTA). */
  @media (min-width: 1025px) and (max-height: 820px) {
    .sticky-cta {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .hero {
      min-height: auto;
      /* keep clearing the fixed header (negative margin pulls the hero under it) */
      padding: calc(var(--nav-offset) + 1.25rem) 0 1.5rem;
    }
    .section {
      padding: 1rem 0;
    }
    .hero-badges-row {
      display: none;
    }
    .hero-proof-row {
      gap: 0.75rem;
      padding: 0.5rem 0;
    }
    .hero-proof-num {
      font-size: 1.2rem;
    }
    .hero-proof-lbl {
      font-size: 0.75rem;
      letter-spacing: 0.08em;
    }
    .hero-tagline {
      font-size: clamp(3.5rem, 16vw, 5.5rem);
    }
    .hero-prelude {
      font-size: 0.85rem;
      letter-spacing: 0.25em;
    }
    .hero-btns {
      flex-direction: column;
      align-items: stretch;
    }
  }

  /* Short landscape screens (1366x768, 1280x800, 1536x864, iPad landscape):
     tighten the hero's vertical rhythm and cap the display size by height so
     the hero's own CTAs land above the fold instead of ~60-100px below it. */
  @media (min-width: 1024px) and (max-height: 900px) {
    .hero {
      padding-top: calc(var(--nav-offset) + 0.75rem);
    }
    .hero-kicker {
      margin-bottom: 1rem;
    }
    .hero-display {
      margin-bottom: 1.25rem;
    }
    .hero-tagline {
      font-size: clamp(4rem, min(12vw, 15vh), 8.5rem);
    }
    .hero-sub {
      margin-bottom: 1rem;
    }
    .hero-proof-row {
      padding: 0.75rem 0;
      margin-bottom: 1rem;
    }
    .hero-meta {
      margin-bottom: 1.25rem;
    }
  }

  /* ===== STATS BAR — sand band, stat dots + 900 numbers ===== */
  .stats-bar {
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
    padding: 1.75rem 0;
    position: relative;
  }

  .stats-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
  }

  .stat-item {
    flex: 1;
    text-align: center;
    padding: 0.5rem 1.5rem;
  }

  .stat-figure {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .stat-number {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    font-weight: 900;
    color: var(--text-primary);
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .stat-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-top: 0.35rem;
  }

  .stat-divider {
    width: 1px;
    height: 40px;
    background: var(--border-color);
    flex-shrink: 0;
  }

  /* ===== PROGRAMMES ===== */
  .programmes-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .programmes-pricing-link {
    text-align: center;
    margin-top: 1.5rem;
  }

  .programmes-pricing-link a {
    /* inline-block + padding = a 40px+ tap target (was 30px on touch) */
    display: inline-block;
    padding-block: 0.625rem;
    color: var(--color-accent-text);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
  }

  .programmes-pricing-link + .programmes-pricing-link {
    margin-top: 0.5rem;
  }

  .programmes-pricing-link a:hover {
    text-decoration: underline;
  }

  /* Meet your tutor band */
  .founder-band__inner {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    max-width: 920px;
    margin: 0 auto;
  }

  /* Avatar as a sticker tile — white, 2px ink, hard offset shadow */
  .founder-band__avatar {
    flex-shrink: 0;
    width: 120px;
    height: 120px;
    border-radius: var(--radius-md);
    display: grid;
    place-items: center;
    background: var(--bg-card);
    border: 2px solid var(--color-ink);
    box-shadow: 0 4px 0 var(--ink-shadow);
  }

  .founder-band__avatar span {
    font-size: 2.25rem;
    font-weight: 900;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .founder-band__title {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0.4rem 0 0.75rem;
    line-height: 1.25;
  }

  .founder-band__lead {
    color: var(--text-secondary);
    margin-bottom: 1rem;
    line-height: 1.65;
    /* Nunito's "0" is wide (ch ~ 1.35 avg chars): 60ch ~ 80 characters a
       line, down from ~99 in the 760px column at 1180-1440 */
    max-width: 60ch;
  }

  .founder-band__lead strong {
    color: var(--text-primary);
  }

  .founder-band__creds {
    list-style: none;
    padding: 0;
    margin: 0 0 1.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  .founder-band__creds li {
    position: relative;
    padding-left: 1.4rem;
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .founder-band__creds li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.05em;
    width: 1rem;
    height: 1rem;
    background: var(--sticker-bullet) center / contain no-repeat;
  }

  .founder-band__link {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    color: var(--color-accent-text);
    text-decoration: none;
    font-weight: 700;
  }

  .founder-band__link:hover {
    text-decoration: underline;
  }

  /* ===== A-WORTHY WHITEBOARD BAND ===== */
  .whiteboard-band {
    text-align: center;
  }

  .wb-head {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2.5rem;
    max-width: 57.5rem;
    margin: 0 auto 2.5rem;
  }

  /* rem caps (920px / 720px at 16px) so the heading keeps its 2-line break
     when the root font scales up at >=1441px */
  .wb-head__text {
    max-width: 45rem;
  }
  .wb-head .section-heading::before {
    margin-left: auto;
    margin-right: auto;
  }

  .wb-head__sticker {
    flex-shrink: 0;
    width: 150px;
  }

  @media (max-width: 640px) {
    .wb-head__sticker { width: 110px; }
    .wb-head { flex-direction: column; gap: 1.25rem; }
  }

  .wb-name {
    color: var(--color-accent-text);
    white-space: nowrap;
  }

  .wb-sub {
    margin-top: 1rem;
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  .wb-more { text-align: center; margin: 1.5rem 0 0; font-weight: 800; }

  .wb-more a { color: var(--color-accent-text); }

  .wb-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    max-width: 55rem;
    margin: 0 auto;
  }

  /* Feature cards — white sticker cards (lift comes from the global list) */
  .wb-feature {
    text-align: left;
    background: var(--bg-card);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-md);
    padding: 1.5rem 1.5rem 1.75rem;
    transition: transform 0.22s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.22s ease;
  }

  .wb-feature__icon {
    margin-bottom: 1rem;
  }

  .wb-feature__title {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 0.4rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .wb-feature__desc {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
  }

  @media (max-width: 640px) {
    .wb-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .wb-head {
      margin-bottom: 1.75rem;
    }
  }

  @media (max-width: 640px) {
    .founder-band__inner {
      flex-direction: column;
      text-align: center;
      gap: 1.5rem;
    }
    .founder-band__creds {
      justify-content: center;
    }
  }

  /* Grade-transformation strip */
  .transformations {
    margin-top: 3rem;
    text-align: center;
  }

  .transformations__title {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
  }

  .transformations__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .transformation-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    padding: 1.75rem 1.25rem;
    background: var(--bg-card);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: transform 0.22s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.22s ease;
  }

  .transformation-card:hover .transformation-card__arrow {
    transform: translateX(5px);
  }

  .transformation-card__jump {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Before / after grades ride on the global .chip--pink / .chip--green, sized up */
  .transformation-card__before,
  .transformation-card__after {
    font-size: 1.2rem;
    font-weight: 900;
    letter-spacing: 0;
    padding: 0.3rem 0.85rem;
  }

  .transformation-card__arrow {
    color: var(--text-primary);
    font-size: 1.4rem;
    font-weight: 800;
    transition: transform var(--transition-fast);
  }

  .transformation-card__meta {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .transformation-card__quote {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.5;
    font-style: italic;
  }

  .transformations__link {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    color: var(--color-accent-text);
    text-decoration: none;
    font-weight: 700;
  }

  .transformations__link:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .transformations__grid {
      grid-template-columns: 1fr;
    }
  }

  /* Programme cards — white sticker cards, subject mascot in the top well */
  .programme-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    background: var(--bg-card);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: transform 0.22s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.22s ease;
  }

  .programme-body {
    padding: 1.5rem 1.5rem 1.75rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .programme-badge {
    align-self: flex-start;
    margin-bottom: 0.65rem;
  }

  /* Cards without a "Most Popular" / "New" chip reserve the chip row, so the
     level eyebrow and title share a baseline across each row of the grid.
     Chip height = 0.72rem x 1.2 line-height + 0.6rem padding + 3px borders. */
  @media (min-width: 481px) {
    .programme-card:not(:has(.programme-badge)) .programme-body {
      padding-top: calc(1.5rem + 1.65rem + 0.65rem);
    }
  }

  .programme-level {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }

  .programme-body h3 {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }

  .programme-body p {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    flex: 1;
  }

  .programme-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    padding-top: 1rem;
    border-top: 2px dashed var(--ink-faint);
  }

  .programme-price {
    font-size: 0.9rem;
    font-weight: 800;
    color: var(--color-accent-text);
  }

  .programme-link {
    font-size: 0.85rem;
    color: var(--text-primary);
    font-weight: 700;
  }

  /* ===== TESTIMONIALS ===== */
  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .reviews-cta {
    text-align: center;
    margin-top: 2.5rem;
  }
  /* Google-reviews link is a plain white .btn pill; just the inline icon sizing here */
  .reviews-link {
    font-size: 0.9rem;
  }
  .reviews-link svg {
    flex-shrink: 0;
  }

  /* Testimonial cards — white sticker cards (hover lift from the global list) */
  .testimonial-card {
    position: relative;
    background: var(--bg-card);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-md);
    padding: 1.75rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
  }

  .testimonial-stars {
    color: var(--color-sun);
    font-size: 0.95rem;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
  }

  .testimonial-card blockquote {
    font-family: var(--font-body);
    font-weight: 600;
    font-style: italic;
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--text-primary);
    margin: 0 0 1.5rem;
    flex: 1;
    text-wrap: pretty;
  }

  .testimonial-author {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-top: 1.25rem;
    border-top: 2px dashed var(--ink-faint);
  }

  .testimonial-author strong {
    display: block;
    font-size: 0.9rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .testimonial-author span {
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  /* Avatar initials — a tinted .icon-circle, sized up */
  .testimonial-avatar-circle {
    width: 44px;
    height: 44px;
  }
  .testimonial-avatar-circle span {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.05em;
  }

  /* ===== RESULTS SECTION ===== */
  .results-section {
    background: var(--bg-secondary);
    position: relative;
  }
  .results-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    padding: 2rem 0;
    margin-bottom: 1.5rem;
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-md);
    background: var(--bg-card);
  }
  .result-stat {
    flex: 1;
    text-align: center;
    padding: 1rem;
  }
  .result-stat-figure {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .result-stat-number {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 900;
    color: var(--text-primary);
    letter-spacing: -0.03em;
    line-height: 1;
    white-space: nowrap;
  }
  /* Four across in a ~180-220px cell: 2.5rem broke "3 months" onto two
     lines at 769-1100 (iPad portrait 820, landscape phones, iPad 1024). */
  @media (min-width: 769px) and (max-width: 1180px) {
    .result-stat-number {
      font-size: clamp(1.75rem, 3.6vw, 2.5rem);
    }
  }
  .result-stat-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    margin-top: 0.5rem;
  }
  .result-stat-divider {
    width: 1px;
    height: 40px;
    background: var(--border-color);
    flex-shrink: 0;
  }
  .results-sub-heading {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
    margin-top: 2rem;
  }
  /* Flex, not a 5-column 1fr grid: 1fr means minmax(auto, 1fr), so the grade
     chips' min-content width pushed the cards past the viewport (overflow at
     360, 820 and 844). Five across on wide screens, then 3 + 2 and 2 + 2 + 1
     with the short last row centred rather than left-hanging. */
  .results-transforms {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }
  .transform-card {
    flex: 1 1 0;
    min-width: 0;
    background: var(--bg-card);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    text-align: center;
  }
  .transform-card strong {
    display: block;
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }
  .transform-grades {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  /* Grade pills ride on the global .chip--pink / .chip--green */
  .grade-before,
  .grade-after {
    font-size: 0.95rem;
    font-weight: 900;
    letter-spacing: 0;
    padding: 0.25rem 0.7rem;
  }
  .grade-arrow {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }
  .transform-duration {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* ===== CONTACT SECTION ===== */
  .contact-section {
    position: relative;
  }
  .contact-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 3rem;
    align-items: start;
  }
  .contact-col-heading {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
  }
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .form-hp { position: absolute; left: -9999px; }
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .form-group { display: flex; flex-direction: column; gap: 0.35rem; }
  /* Inputs take the global look (muted fill, 2px ink, red focus ring);
     labels are grey micro-labels. */
  .form-group label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-secondary);
    font-weight: 700;
    margin-bottom: 0;
  }
  .required { color: var(--color-accent-text); }
  .optional { color: var(--text-secondary); font-weight: 600; text-transform: none; letter-spacing: 0; }
  .btn-submit {
    width: 100%;
    margin-top: 0.5rem;
  }
  /* "More details (optional)" — the optional fields fold away under a dashed
     well; the summary is a 44px row with the same +/− as the FAQ accordions */
  .form-more {
    border: 2px dashed var(--ink-faint);
    border-radius: var(--radius-sm);
  }
  .form-more__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 44px;
    padding: 0.6rem 1rem;
    font-size: 0.9rem;
    font-weight: 800;
    color: var(--text-primary);
    cursor: pointer;
    list-style: none;
    touch-action: manipulation;
  }
  .form-more__summary::-webkit-details-marker { display: none; }
  .form-more__summary::after {
    content: '+';
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1;
    color: var(--text-secondary);
  }
  .form-more[open] > .form-more__summary::after { content: '\2212'; }
  @media (hover: hover) {
    .form-more__summary:hover { color: var(--color-accent-text); }
  }
  .form-more__body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 0.25rem 1rem 1rem;
  }
  .btn-submit:disabled { opacity: 0.7; cursor: default; }
  .form-success {
    display: none;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 1rem;
    background: var(--tint-green-bg);
    border: 2px solid var(--color-leaf);
    border-radius: var(--radius-sm);
    color: var(--tint-green-fg);
    font-size: 0.9rem;
    font-weight: 600;
    margin-top: 0.5rem;
  }
  .form-success[hidden] { display: none; }
  .form-success:not([hidden]) { display: flex; }
  .form-success:focus { outline: none; }
  .form-success__text {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin: 0;
    line-height: 1.55;
  }
  .form-success__text svg { flex-shrink: 0; margin-top: 0.1rem; }
  .form-errors {
    padding: 1rem;
    background: var(--color-danger-bg);
    border: 2px solid var(--color-accent);
    border-radius: var(--radius-sm);
    color: var(--color-accent-text);
    font-size: 0.85rem;
    font-weight: 600;
    margin-top: 0.5rem;
  }
  .form-errors p { margin: 0.2rem 0; }
  .form-errors a { color: inherit; text-decoration: underline; text-underline-offset: 0.15em; }
  .info-card {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border-color);
  }
  .info-card:last-of-type { border-bottom: none; }
  .info-card strong {
    display: block;
    font-size: 0.9rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }
  .info-card p {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.6;
  }
  .info-card a {
    color: var(--color-accent-text);
    font-weight: 700;
  }
  .enrol-steps {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 2px dashed var(--ink-faint);
  }
  .enrol-steps-heading {
    font-size: 0.9rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }
  .enrol-step {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }
  .enrol-num {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--color-accent);
    border: 2px solid var(--color-ink);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 800;
    flex-shrink: 0;
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 1024px) {
    .transform-card {
      flex: 0 1 calc((100% - 2rem) / 3);
    }
    .programmes-grid,
    .testimonials-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 768px) {
    .section {
      padding: 1.5rem 0;
    }

    .stats-inner {
      flex-wrap: wrap;
      gap: 1rem;
    }

    .stat-divider {
      display: none;
    }

    .stat-item {
      flex: 0 0 45%;
    }
    .contact-grid {
      grid-template-columns: 1fr;
    }
    .form-row {
      grid-template-columns: 1fr;
    }
    .transform-card {
      flex: 0 1 calc((100% - 2rem) / 3);
    }
    .results-stats {
      flex-wrap: wrap;
    }
    .result-stat-divider {
      display: none;
    }
    .result-stat {
      flex: 0 0 45%;
    }
  }

  @media (max-width: 640px) {
    .programmes-grid,
    .testimonials-grid {
      grid-template-columns: 1fr;
    }

    .stat-item {
      flex: 0 0 calc(50% - 0.5rem);
      padding: 0.5rem 0.5rem;
    }
    .transform-card {
      flex: 0 1 calc((100% - 1rem) / 2);
    }
    .result-stat {
      flex: 0 0 50%;
      padding: 0.75rem 0.5rem;
    }
    .result-stat-number {
      font-size: clamp(1.6rem, 8vw, 2.2rem);
    }

    .section-heading {
      font-size: clamp(1.5rem, 6.5vw, 1.75rem);
      margin-bottom: 0.75rem;
    }

  }

  /* Tablet portrait */
  @media (min-width: 481px) and (max-width: 768px) {
    .programmes-grid {
      grid-template-columns: 1fr 1fr;
    }
    .testimonials-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 480px) {
    .testimonials-grid {
      grid-template-columns: 1fr;
    }
  }
  /* Two columns x three quotes left the third card hanging under the first
