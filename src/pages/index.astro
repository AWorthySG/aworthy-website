---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PenAnimation from '../components/PenAnimation.astro';
import '../styles/global.css';
import { googleReviewsUrl } from '../data/site-config';
---

<BaseLayout title="English, Maths, GP & Econs Tuition Singapore | A-Worthy" description="Online tuition in Singapore for O-Level English & Maths, Pre-IB Maths, H1 GP and H2 Economics. Groups of up to 6, taught by Jeremy Lim. Get a free assessment.">
  <Header slot="header" />

  <!-- ===== HERO ===== -->
  <!-- The entrance cascade plays once per browser session: later homepage views
       in the same session get html.hero-seen, which switches it off. Runs before
       the hero is parsed, so the settled state is the first thing painted. -->
  <script is:inline>
    (function () {
      try {
        if (sessionStorage.getItem('aw-hero-seen')) document.documentElement.classList.add('hero-seen');
        else sessionStorage.setItem('aw-hero-seen', '1');
      } catch (e) {}
    })();
  </script>
  <section class="hero">
    <div class="hero-depth-layer" aria-hidden="true"></div>

    <div class="hero-centre">
      <div class="hero-reveal-line hero-anim" style="--d:0">
        <span class="hero-kicker">Online tuition in Singapore: O-Level English &amp; Maths, Pre-IB, GP, H2 Economics</span>
      </div>
      <h1 class="hero-display">
        <span class="hero-prelude">
          <span class="hero-prelude-word" style="--i:0">You</span>
          <span class="hero-prelude-word" style="--i:1">are</span>
        </span>
        <!-- Letter spans are deliberately contiguous: whitespace text nodes between
             inline-block spans render as visible gaps (~0.25em each at display size)
             that stretched "Worthy" and wrapped it mid-word. -->
        <span class="hero-tagline"><span class="hero-letter" style="--i:0">A</span><span class="hero-letter hero-letter--space" style="--i:1">&nbsp;</span><span class="hero-letter hero-letter--italic" style="--i:2">W</span><span class="hero-letter hero-letter--italic" style="--i:3">o</span><span class="hero-letter hero-letter--italic" style="--i:4">r</span><span class="hero-letter hero-letter--italic" style="--i:5">t</span><span class="hero-letter hero-letter--italic" style="--i:6">h</span><span class="hero-letter hero-letter--italic" style="--i:7">y</span></span>
        <span class="hero-underline" aria-hidden="true"></span>
      </h1>
      <div class="hero-sticker hero-anim" style="--d:9" aria-hidden="true">
        <img src="/images/mascots/mascot-cheer.webp" alt="" width="455" height="508" class="sticker sticker--right" />
      </div>
      <p class="hero-sub hero-anim" style="--d:10">Your child works hard, but the grades don&rsquo;t move. They know the content but can&rsquo;t show it under exam pressure. That&rsquo;s a skill we can teach. Our five-step SHARP Method shows them how to read what each question wants, pick the framework for it and write an answer that earns the marks.</p>

      <div class="hero-proof-row hero-anim" style="--d:12">
        <div class="hero-proof-item">
          <span class="hero-proof-num"><span class="stat-dot stat-dot--green" aria-hidden="true"></span>90%</span>
          <span class="hero-proof-lbl">O-Level English A1–B3</span>
        </div>
        <div class="hero-proof-item">
          <span class="hero-proof-num"><span class="stat-dot stat-dot--pink" aria-hidden="true"></span>4.9</span>
          <span class="hero-proof-lbl">Google rating</span>
        </div>
        <div class="hero-proof-item">
          <span class="hero-proof-num"><span class="stat-dot stat-dot--blue" aria-hidden="true"></span>6</span>
          <span class="hero-proof-lbl">Max class size</span>
        </div>
      </div>

      <p class="hero-meta speech-bubble hero-anim" style="--d:14">From <strong>S$280/mo</strong>, no registration fee &middot; <a href="/pricing/">See pricing &rarr;</a></p>

      <!-- No entrance animation: the two buttons are on screen from the first paint -->
      <div class="hero-btns" data-track="hero">
        <a href="/#contact" class="btn btn-accent hero-cta-primary" data-cta>Get a Free Report</a>
        <a href="https://wa.me/6589913181" class="btn btn-outline hero-cta-secondary" target="_blank" rel="noopener noreferrer">
          <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" style="margin-right: 6px;"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          WhatsApp us
        </a>
      </div>

      <div class="hero-badges-row hero-anim" style="--d:17">
        <span class="chip chip--green">MOE syllabus</span>
        <span class="chip chip--blue">100% online</span>
        <span class="chip chip--gold">Founder: NUS Law graduate</span>
      </div>

      <div class="audience-toggle segmented hero-anim" style="--d:7" role="tablist" aria-label="View content for">
        <button class="audience-btn segmented__btn active" data-audience="parent" role="tab" aria-selected="true" aria-controls="msg-parent" id="tab-parent">
          <img src="/images/mascots/mascot-heart-alt-icon.webp" alt="" class="audience-btn__icon" width="240" height="273" />
          I&rsquo;m a parent
        </button>
        <button class="audience-btn segmented__btn" data-audience="student" role="tab" aria-selected="false" aria-controls="msg-student" id="tab-student">
          <img src="/images/mascots/mascot-heart-alt-icon.webp" alt="" class="audience-btn__icon" width="240" height="273" />
          I&rsquo;m a student
        </button>
      </div>
      <div class="audience-msg audience-msg--parent" id="msg-parent" role="tabpanel" aria-labelledby="tab-parent">
        <p><strong>For parents:</strong> each week, your child has a live 90-minute lesson with the same tutor, in a group of up to 6. Every lesson is recorded, and their work comes back with written feedback. Each month, you get a progress report by email. Between lessons, your child can send questions on WhatsApp.</p>
      </div>
      <div class="audience-msg audience-msg--student" id="msg-student" role="tabpanel" aria-labelledby="tab-student" hidden>
        <p><strong>For students:</strong> you already know more than your marks show. You don&rsquo;t need to memorise more; you need a method for the exam. SHARP is five steps: See, Hit, Apply, Refine, Practise. At the Hit step, you pick the framework for the question in front of you, such as EIL (Evidence, Implication, Link) for English inference or P-E-E-L (Point, Evidence, Explanation, Link) for a GP paragraph.</p>
      </div>
    </div>
    </div>
  </section>

  <!-- ===== STATS BAR ===== -->
  <section class="stats-bar section--sand">
    <div class="container stats-inner">
      <div class="stat-item" data-animate="reveal-up" data-animate-delay="1">
        <span class="stat-figure"><span class="stat-dot stat-dot--green" aria-hidden="true"></span><span class="stat-number" data-count="90" data-count-suffix="%">90%</span></span>
        <span class="stat-label">O-Level English A1–B3</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item" data-animate="reveal-up" data-animate-delay="2">
        <span class="stat-figure"><span class="stat-dot stat-dot--pink" aria-hidden="true"></span><span class="stat-number">6</span></span>
        <span class="stat-label">Maximum class size</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item" data-animate="reveal-up" data-animate-delay="3">
        <span class="stat-figure"><span class="stat-dot stat-dot--blue" aria-hidden="true"></span><span class="stat-number" data-count="500" data-count-suffix="+">500+</span></span>
        <span class="stat-label">Students taught</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item" data-animate="reveal-up" data-animate-delay="4">
        <span class="stat-figure"><span class="stat-dot stat-dot--gold" aria-hidden="true"></span><span class="stat-number">NUS</span></span>
        <span class="stat-label">Law graduate founder</span>
      </div>
    </div>
  </section>

  <section id="programmes" class="section section--sand programmes-section">
    <div class="container">
      <span class="eyebrow" data-animate="reveal-up">Our programmes</span>
      <h2 class="section-heading" data-animate="reveal-up">Tuition from Sec 1 to JC 2</h2>

      <div class="programmes-grid">
        <a href="/o-level-english/" class="programme-card subject--english" data-animate="reveal-up" data-animate-delay="1">
          <div class="subject-panel">
            <img src="/images/mascots/mascot-grade-a.webp" alt="O-Level English tuition, Sec 1 to 4" width="414" height="553" class="sticker" loading="lazy" />
          </div>
          <div class="programme-body">
            <span class="chip chip--gold programme-badge">Most popular</span>
            <span class="programme-level">Sec 1&ndash;4</span>
            <h3>O-Level English</h3>
            <p>Comprehension, composition, oral and editing, each taught with a step-by-step method your child can use in the exam.</p>
            <div class="programme-meta">
              <span class="programme-price">From SGD 280/month</span>
              <span class="programme-link">View O-Level English &rarr;</span>
            </div>
          </div>
        </a>

        <a href="/h1-general-paper/" class="programme-card subject--gp" data-animate="reveal-up" data-animate-delay="2">
          <div class="subject-panel">
            <img src="/images/mascots/mascot-lightbulb.webp" alt="H1 General Paper tuition, JC 1 and JC 2" width="399" height="546" class="sticker sticker--right" loading="lazy" />
          </div>
          <div class="programme-body">
            <span class="programme-level">JC 1&ndash;2</span>
            <h3>H1 General Paper</h3>
            <p>Building an argument, reading a passage critically and planning an essay under time pressure.</p>
            <div class="programme-meta">
              <span class="programme-price">From SGD 360/month</span>
              <span class="programme-link">View H1 General Paper &rarr;</span>
            </div>
          </div>
        </a>

        <a href="/o-level-mathematics/" class="programme-card subject--maths" data-animate="reveal-up" data-animate-delay="3">
          <div class="subject-panel">
            <img src="/images/mascots/mascot-maths.webp" alt="O-Level Mathematics tuition, Sec 1 to 4" width="417" height="553" class="sticker" loading="lazy" />
          </div>
          <div class="programme-body">
            <span class="chip chip--blue programme-badge">New</span>
            <span class="programme-level">Sec 1&ndash;4</span>
            <h3>O-Level Mathematics</h3>
            <p>Algebra, geometry, trigonometry, functions and statistics, with a named framework for each question type.</p>
            <div class="programme-meta">
              <span class="programme-price">From SGD 280/month</span>
              <span class="programme-link">View O-Level Maths &rarr;</span>
            </div>
          </div>
        </a>

        <a href="/pre-ib-mathematics/" class="programme-card subject--preib" data-animate="reveal-up" data-animate-delay="4">
          <div class="subject-panel">
            <img src="/images/mascots/mascot-graph.webp" alt="Pre-IB Mathematics tuition, Year 3 and Year 4" width="418" height="550" class="sticker sticker--right" loading="lazy" />
          </div>
          <div class="programme-body">
            <span class="chip chip--blue programme-badge">New</span>
            <span class="programme-level">Year 3&ndash;4</span>
            <h3>Pre-IB Mathematics</h3>
            <p>Indices and surds through to logarithms and early calculus, with the line-by-line working IB examiners want.</p>
            <div class="programme-meta">
              <span class="programme-price">From SGD 280/month</span>
              <span class="programme-link">View Pre-IB Maths &rarr;</span>
            </div>
          </div>
        </a>

        <a href="/h2-economics/" class="programme-card subject--econ" data-animate="reveal-up" data-animate-delay="5">
          <div class="subject-panel">
            <img src="/images/mascots/mascot-economics.webp" alt="H2 Economics tuition, JC 1 and JC 2" width="426" height="551" class="sticker" loading="lazy" />
          </div>
          <div class="programme-body">
            <span class="programme-level">JC 1&ndash;2</span>
            <h3>H2 Economics</h3>
            <p>Micro and macro for the full A-Level 9570 syllabus: accurate diagrams, essays that evaluate, and case study answers that use the data.</p>
            <div class="programme-meta">
              <span class="programme-price">From SGD 360/month</span>
              <span class="programme-link">View H2 Economics &rarr;</span>
            </div>
          </div>
        </a>

        <a href="/programmes/" class="programme-card subject--coaching" data-animate="reveal-up" data-animate-delay="6">
          <div class="subject-panel">
            <img src="/images/mascots/mascot-teacher.webp" alt="One-to-one coaching for O-Level English, Maths, GP and H2 Economics" width="560" height="640" class="sticker sticker--right" loading="lazy" />
          </div>
          <div class="programme-body">
            <span class="programme-level">All subjects</span>
            <h3>One-to-one coaching</h3>
            <p>Lessons built around your child&rsquo;s own gaps, at times that suit you. Useful for one paper or topic before an exam.</p>
            <div class="programme-meta">
              <span class="programme-price">SGD 120&ndash;140/session</span>
              <span class="programme-link">Learn more &rarr;</span>
            </div>
          </div>
        </a>
      </div>

      <p class="programmes-pricing-link" data-animate="reveal-up"><a href="/pricing/">See the fees for every level, with our notes and practice papers <span class="nobr">included &rarr;</span></a></p>

      <!-- Programme Selector Quiz (#8) -->
      <div class="quiz-section" data-animate="reveal-up">
        <div class="quiz-card">
          <span class="eyebrow">Not sure which class fits?</span>
          <h3 class="quiz-heading">Answer four quick questions</h3>
          <div class="quiz-body" id="programme-quiz">
            <div class="quiz-step" data-step="1">
              <p class="quiz-question">What level is your child in?</p>
              <div class="quiz-options">
                <button class="btn quiz-option" data-value="sec1-2" data-next="1a">Sec 1 or 2</button>
                <button class="btn quiz-option" data-value="sec3-4" data-next="1a">Sec 3 or 4</button>
                <button class="btn quiz-option" data-value="jc" data-next="1b">JC 1 or 2</button>
              </div>
            </div>
            <div class="quiz-step" data-step="1a" hidden>
              <p class="quiz-question">Which subject?</p>
              <div class="quiz-options">
                <button class="btn quiz-option" data-value="english" data-next="2">O-Level English</button>
                <button class="btn quiz-option" data-value="maths" data-next="2">O-Level Mathematics</button>
              </div>
            </div>
            <div class="quiz-step" data-step="1b" hidden>
              <p class="quiz-question">Which subject?</p>
              <div class="quiz-options">
                <button class="btn quiz-option" data-value="gp" data-next="2">H1 General Paper</button>
                <button class="btn quiz-option" data-value="econs" data-next="2">H2 Economics</button>
              </div>
            </div>
            <div class="quiz-step" data-step="2" hidden>
              <p class="quiz-question">What&rsquo;s the biggest problem right now?</p>
              <div class="quiz-options">
                <button class="btn quiz-option" data-value="comprehension" data-next="3">Understanding what questions ask</button>
                <button class="btn quiz-option" data-value="writing" data-next="3">Writing and structuring answers</button>
                <button class="btn quiz-option" data-value="overall" data-next="3">The overall grade</button>
              </div>
            </div>
            <div class="quiz-step" data-step="3" hidden>
              <p class="quiz-question">Group class or one-to-one?</p>
              <div class="quiz-options">
                <button class="btn quiz-option" data-value="group" data-next="result">A small group (up to 6)</button>
                <button class="btn quiz-option" data-value="individual" data-next="result">One-to-one</button>
              </div>
            </div>
            <div class="quiz-result" id="quiz-result" hidden>
              <div class="quiz-result-icon icon-circle icon-circle--green">&#10003;</div>
              <h4 class="quiz-result-heading" id="quiz-result-title"></h4>
              <p class="quiz-result-desc" id="quiz-result-desc"></p>
              <a href="/programmes/" class="btn btn-accent quiz-result-cta" id="quiz-result-link">View programme details</a>
              <button class="quiz-restart" id="quiz-restart">Start again</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== MEET YOUR TUTOR ===== -->
  <section class="section founder-band">
    <div class="container">
      <div class="founder-band__inner" data-animate="reveal-up">
        <div class="founder-band__avatar" aria-hidden="true"><span>JL</span></div>
        <div class="founder-band__body">
          <span class="eyebrow">Meet your tutor</span>
          <h2 class="founder-band__title">A lawyer&rsquo;s rigour, turned into a method your child can follow</h2>
          <p class="founder-band__lead"><strong>Jeremy Lim</strong> started A-Worthy after working as a corporate lawyer. In law, you answer the exact question asked, with evidence. He built the SHARP Method to teach students to do the same in an exam, step by step.</p>
          <ul class="founder-band__creds">
            <li>LLB (Hons), NUS Faculty of Law</li>
            <li>500+ students taught</li>
            <li>Creator of the SHARP Method</li>
          </ul>
          <a href="/about/" class="founder-band__link">Read Jeremy&rsquo;s story &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== A-WORTHY WHITEBOARD ===== -->
  <section class="section whiteboard-band">
    <div class="container">
      <div class="wb-head" data-animate="reveal-up">
        <div class="wb-head__text">
          <span class="eyebrow">Our online classroom</span>
          <h2 class="section-heading">Lessons happen on the <span class="wb-name">A-Worthy Whiteboard</span></h2>
          <p class="wb-sub">Live video, one page to write on together, and every lesson recorded. It runs in a browser tab, with nothing to install.</p>
        </div>
        <img src="/images/mascots/mascot-teacher.webp" alt="" width="560" height="640" class="wb-head__sticker sticker sticker--right" loading="lazy" />
      </div>

      <div class="wb-grid">
        <div class="wb-feature" data-animate="reveal-up" data-animate-delay="1">
          <div class="wb-feature__icon icon-circle icon-circle--green" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="14" height="12" rx="2"/><path d="M22 8l-6 4 6 4z"/></svg>
          </div>
          <h3 class="wb-feature__title">Live, face to face</h3>
          <p class="wb-feature__desc">Tutor and students see each other in real time, at most 6 to a group.</p>
        </div>

        <div class="wb-feature" data-animate="reveal-up" data-animate-delay="2">
          <div class="wb-feature__icon icon-circle icon-circle--pink" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/></svg>
          </div>
          <h3 class="wb-feature__title">One shared page</h3>
          <p class="wb-feature__desc">The working appears line by line as the tutor writes. Your child writes on the same page.</p>
        </div>

        <div class="wb-feature" data-animate="reveal-up" data-animate-delay="3">
          <div class="wb-feature__icon icon-circle icon-circle--blue" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><polyline points="9 15 11 17 15 13"/></svg>
          </div>
          <h3 class="wb-feature__title">Past papers, marked live</h3>
          <p class="wb-feature__desc">The tutor marks your child&rsquo;s answers on the paper itself, paragraph by paragraph, diagram by diagram.</p>
        </div>

        <div class="wb-feature" data-animate="reveal-up" data-animate-delay="4">
          <div class="wb-feature__icon icon-circle icon-circle--gold" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
          </div>
          <h3 class="wb-feature__title">Every lesson recorded</h3>
          <p class="wb-feature__desc">Rewatch any lesson. Miss one, and the recording, worksheet and homework reach your child within 24 hours.</p>
        </div>
      </div>
      <p class="wb-more"><a href="/whiteboard/">How lessons work on the Whiteboard &rarr;</a></p>
    </div>
  </section>

  <section id="reviews" class="section section--sand testimonials-section">
    <div class="container">
      <div class="testimonials-head">
        <div>
          <span class="eyebrow" data-animate="reveal-up">What families say</span>
          <h2 class="section-heading" data-animate="reveal-up">What parents and students tell us</h2>
        </div>
        <img src="/images/mascots/mascot-dad.webp" alt="" width="360" height="508" class="testimonials-head__mascot sticker sticker--right" loading="lazy" />
      </div>

      <div class="testimonials-grid">
        <div class="testimonial-card card--elevated" data-animate="reveal-up" data-animate-delay="1">
          <div class="testimonial-stars" aria-label="5 out of 5 stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <blockquote>
            "The moment my son learned the SHARP Method's &lsquo;See&rsquo; step for inference questions, his comprehension marks jumped from 12/25 to 20/25 — no more guessing."
          </blockquote>
          <div class="testimonial-author">
            <div class="testimonial-avatar-circle icon-circle icon-circle--gold">
              <span>LT</span>
            </div>
            <div>
              <strong>Linda T.</strong>
              <span>Mother of a Sec 4 student</span>
            </div>
          </div>
        </div>

        <div class="testimonial-card card--elevated" data-animate="reveal-up" data-animate-delay="2">
