        </div>
        <div class="pricing-card subject--gp card--elevated">
          <div class="subject-panel subject-panel--sm pricing-card__panel" aria-hidden="true"><img src="/images/mascots/mascot-lightbulb.webp" alt="" width="399" height="546" class="sticker" loading="lazy" /></div>
          <h3 class="pricing-card__name">H1 General Paper</h3>
          <p class="pricing-card__level">JC 1 &ndash; 2</p>
          <p class="pricing-card__price">SGD 360&ndash;400<span>/month</span></p>
          <p class="pricing-card__levels">JC 1: SGD 360 &middot; JC 2: SGD 400</p>
          <ul class="pricing-card__details">
            <li>90 min sessions</li>
            <li>Weekly, fifth-week lessons included</li>
            <li>Max 6 students</li>
