        </div>
        <div class="pricing-card subject--preib card--elevated">
          <div class="subject-panel subject-panel--sm pricing-card__panel" aria-hidden="true"><img src="/images/mascots/mascot-graph.webp" alt="" width="418" height="550" class="sticker" loading="lazy" /></div>
          <h3 class="pricing-card__name">Pre-IB Mathematics</h3>
          <p class="pricing-card__level">Year 3 &ndash; 4</p>
          <p class="pricing-card__price">SGD 280&ndash;320<span>/month</span></p>
          <p class="pricing-card__levels">Year 3: SGD 280 &middot; Year 4: SGD 320</p>
          <ul class="pricing-card__details">
            <li>90 min sessions</li>
            <li>Weekly, fifth-week lessons included</li>
            <li>Max 6 students</li>
            <li>Materials included</li>
            <li>Free assessment</li>
          </ul>
