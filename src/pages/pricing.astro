  <!-- A link to #pricing-faq-pay (the terms line, the chatbot) opens that answer -->
  <script is:inline>
    (function () {
      function openTarget() {
        var el = location.hash && document.getElementById(location.hash.slice(1));
        if (el && el.tagName === 'DETAILS') el.open = true;
      }
      openTarget();
      window.addEventListener('hashchange', openTarget);
    })();
  </script>

  <Footer slot="footer" />
</BaseLayout>

<style>
