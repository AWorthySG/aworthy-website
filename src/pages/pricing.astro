---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<BaseLayout title="Tuition Fees Singapore | English, Maths, GP & Econs | A-Worthy" description="O-Level English, Maths and Pre-IB Maths from S$280/month; H1 GP and H2 Economics from S$360/month. All materials included. Book a free assessment.">
  <Header slot="header" />

  <!-- ===== HERO ===== -->
  <section class="pricing-hero">
    <div class="container">
      <p class="eyebrow">Pricing</p>
      <h1 class="pricing-hero__heading">Tuition pricing in Singapore &mdash; <span class="accent-word">transparent</span> and all-inclusive</h1>
      <p class="pricing-hero__sub">No hidden fees and no lock-in contracts. Every A-Worthy programme (O-Level English, O-Level Mathematics, Pre-IB Mathematics, H1 General Paper and H2 Economics) includes materials, assessments and WhatsApp support in the monthly fee.</p>
    </div>
  </section>

  <!-- ===== PRICING TABLE ===== -->
  <section class="section pricing-table-section">
    <div class="container">
      <div class="pricing-table-wrap" data-animate="reveal-up">
        <table class="pricing-table">
          <thead>
            <tr>
              <th scope="col" class="pricing-table__label-col"></th>
              <th scope="col" class="pricing-table__th--popular subject--english">
                <span class="chip chip--gold pricing-table__popular-badge">Most popular</span>
                <img src="/images/mascots/mascot-grade-a.webp" alt="" width="414" height="553" class="pricing-table__sticker" />
                <span class="pricing-table__programme-name">O-Level English</span>
                <span class="pricing-table__programme-level">Sec 1 &ndash; 4</span>
              </th>
              <th scope="col" class="subject--maths">
                <img src="/images/mascots/mascot-maths.webp" alt="" width="417" height="553" class="pricing-table__sticker" />
                <span class="pricing-table__programme-name">O-Level Maths</span>
                <span class="pricing-table__programme-level">Sec 1 &ndash; 4</span>
              </th>
              <th scope="col" class="subject--preib">
                <img src="/images/mascots/mascot-graph.webp" alt="" width="418" height="550" class="pricing-table__sticker" />
                <span class="pricing-table__programme-name">Pre-IB Maths</span>
                <span class="pricing-table__programme-level">Year 3 &ndash; 4</span>
              </th>
              <th scope="col" class="subject--gp">
                <img src="/images/mascots/mascot-lightbulb.webp" alt="" width="399" height="546" class="pricing-table__sticker" />
                <span class="pricing-table__programme-name">H1 General Paper</span>
                <span class="pricing-table__programme-level">JC 1 &ndash; 2</span>
              </th>
              <th scope="col" class="subject--econ">
                <img src="/images/mascots/mascot-economics.webp" alt="" width="426" height="551" class="pricing-table__sticker" />
                <span class="pricing-table__programme-name">H2 Economics</span>
                <span class="pricing-table__programme-level">JC 1 &ndash; 2</span>
              </th>
              <th scope="col" class="subject--coaching">
                <img src="/images/mascots/mascot-teacher.webp" alt="" width="560" height="640" class="pricing-table__sticker" />
                <span class="pricing-table__programme-name">1-to-1 Coaching</span>
                <span class="pricing-table__programme-level">All Subjects</span>
              </th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td scope="row" class="pricing-table__row-label">Monthly Fee</td>
              <td><strong>SGD 280</strong><span class="pricing-table__note">Sec 1&ndash;2</span><strong>SGD 320</strong><span class="pricing-table__note">Sec 3&ndash;4</span></td>
              <td><strong>SGD 280</strong><span class="pricing-table__note">Sec 1&ndash;2</span><strong>SGD 320</strong><span class="pricing-table__note">Sec 3&ndash;4</span></td>
              <td><strong>SGD 280</strong><span class="pricing-table__note">Year 3</span><strong>SGD 320</strong><span class="pricing-table__note">Year 4</span></td>
              <td><strong>SGD 360</strong><span class="pricing-table__note">JC 1</span><strong>SGD 400</strong><span class="pricing-table__note">JC 2</span></td>
              <td><strong>SGD 360</strong><span class="pricing-table__note">JC 1</span><strong>SGD 400</strong><span class="pricing-table__note">JC 2</span></td>
              <td><strong>SGD 120</strong><span class="pricing-table__note">per session, O-Level &amp; IB</span><strong>SGD 140</strong><span class="pricing-table__note">per session, JC</span></td>
            </tr>
            <tr>
              <td scope="row" class="pricing-table__row-label">Session Duration</td>
              <td>90 min</td>
              <td>90 min</td>
              <td>90 min</td>
              <td>90 min</td>
              <td>90 min</td>
              <td>60&ndash;90 min</td>
            </tr>
            <tr>
              <td scope="row" class="pricing-table__row-label">Lessons</td>
              <td>Weekly</td>
              <td>Weekly</td>
              <td>Weekly</td>
              <td>Weekly</td>
              <td>Weekly</td>
              <td>Flexible</td>
            </tr>
            <tr>
              <td scope="row" class="pricing-table__row-label">Class Size</td>
              <td>Max 6</td>
              <td>Max 6</td>
              <td>Max 6</td>
              <td>Max 6</td>
              <td>Max 6</td>
              <td>1</td>
            </tr>
            <tr>
              <td scope="row" class="pricing-table__row-label">Materials</td>
              <td>Included</td>
              <td>Included</td>
              <td>Included</td>
              <td>Included</td>
              <td>Included</td>
              <td>Included</td>
            </tr>
            <tr>
              <td scope="row" class="pricing-table__row-label">Assessment</td>
              <td>Free</td>
              <td>Free</td>
              <td>Free</td>
              <td>Free</td>
              <td>Free</td>
              <td>Free</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="pricing-terms">One fixed fee a month, paid by the 1st, and a fifth-week lesson costs nothing extra. Sibling discount 10%, two or more subjects 5%. Away for a few weeks? One free hold of up to four weeks a year. <a href="#pricing-faq-pay">Payment and hold terms</a></p>

      <!-- Mobile pricing cards (visible on small screens) -->
      <h2 class="sr-only">Programme pricing</h2>
      <div class="pricing-cards" data-animate="reveal-up">
        <div class="pricing-card subject--english card--elevated pricing-card--popular">
          <div class="subject-panel subject-panel--sm pricing-card__panel" aria-hidden="true"><img src="/images/mascots/mascot-grade-a.webp" alt="" width="414" height="553" class="sticker" loading="lazy" /></div>
          <span class="chip chip--gold pricing-card__popular-badge">Most popular</span>
          <h3 class="pricing-card__name">O-Level English</h3>
          <p class="pricing-card__level">Sec 1 &ndash; 4</p>
          <p class="pricing-card__price">SGD 280&ndash;320<span>/month</span></p>
          <p class="pricing-card__levels">Sec 1&ndash;2: SGD 280 &middot; Sec 3&ndash;4: SGD 320</p>
