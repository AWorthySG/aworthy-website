<style>
  /* ===== SUBJECT ACCENT: O-Level Mathematics =====
     Used only where a surface is deliberately "subject-coloured" (the quote
     rail, the mid-page CTA rail, the diagram strokes, the playbook chrome).
     Cards default to ink, actions are the sitewide red. The colour is the LMS
     subject token, which carries its own dark-mode value (no override here). */
  :root { --subject-accent: var(--subject-maths); --subject-accent-text: var(--subject-maths-text); }

  /* ===== DESIGN TOKENS ===== */
  :root {
    --prog-bg: var(--bg-primary);
    --prog-bg-card: var(--bg-card);
    --prog-border: var(--border-color);
    --prog-text: var(--text-primary);
    --prog-text-secondary: var(--text-secondary);
    --prog-accent: var(--subject-accent);
    --prog-font: var(--font-body);
    --prog-mono: var(--font-mono);
  }

  /* Keeps hyphenated names ("Pre-IB", "A-Worthy", "O-Level") whole at line ends */
  .nb { white-space: nowrap; }

  /* ===== HERO — the LMS welcome card: a white ink card with the subject-tint
     wash (global .hero-card), eyebrow + squiggled headline + intake bubble on
     the left and the subject sticker on the right at >=1024px; on narrower
     screens the sticker sits centred above the copy. The container matches the
     other subject pages (1080px) and narrows at 1280px+ so the card stays clear
     of the fixed "On this page" card. ===== */
  .prog-hero {
    background: transparent;
    padding: 1.25rem 0 1rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .prog-hero .container { position: relative; z-index: 1; max-width: 1080px; }
  /* Narrowed at 1280px+ so the hero card clears the fixed "On this page" TOC.
     The cap is in rem (67.5rem = 1080px at the 16px root) so it grows with the
     112.5% / 125% / 150% root on large monitors — as a px cap the 150% type at
     2560px squeezed the copy column and wrapped the intake bubble. */
  @media (min-width: 1280px) { .prog-hero .container { max-width: min(67.5rem, 100vw - 360px); } }

  .prog-hero__card {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .prog-hero__copy { width: 100%; min-width: 0; }

  .prog-hero__sticker {
    order: -1;
    z-index: 1; /* order:-1 paints it before the card's ::before tint wash, which greyed it out */
    width: min(200px, 48vw);
    height: auto;
    margin: 0 auto 0.75rem;
  }

  .prog-hero__heading {
    font-family: var(--prog-font);
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    font-weight: 900;
    line-height: 1.12;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
    letter-spacing: -0.03em;
  }

  /* The red squiggle (global .squiggle) is centred while the copy is centred */
  .prog-hero__heading::after { margin-left: auto; margin-right: auto; }

  .prog-hero__sub {
    font-family: var(--prog-font);
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--prog-text-secondary);
    max-width: 40rem; /* 640px at the 16px root; rem so the measure keeps pace with the 112.5–150% root on big monitors */
    margin: 0 auto;
  }

  /* Intake line rides on the global .speech-bubble (LMS welcome-card callout);
     the bottom margin leaves room for the bubble's tail */
  .prog-hero__intake {
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 1rem auto 0.75rem;
    text-align: left;
  }
  .prog-hero__intake strong { font-weight: 800; }

  @media (min-width: 1024px) {
    .prog-hero { text-align: left; }
    .prog-hero__card {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 11.25rem;
      align-items: center;
      gap: 2rem;
    }
    .prog-hero__sticker { order: 0; width: min(11.25rem, 210px); justify-self: center; margin: 0; }
    .prog-hero__heading { font-size: clamp(2.2rem, 3.1vw, 2.6rem); }
    /* The forced break leaves an orphaned "Tuition" line in the card column — let the two lines balance instead */
    .prog-hero__heading br { display: none; }
    .prog-hero__heading { text-wrap: balance; }
    .prog-hero__heading::after { margin-left: 0; margin-right: 0; }
    .prog-hero__sub { margin: 0; }
    .prog-hero__intake { margin: 1rem 0 0.75rem; }
  }

  /* Landscape phones (~390px tall): the stacked sticker and eyebrow pushed the
     headline to y≈320, so its second line fell below the first screen. Use the
     desktop welcome-card layout here too — sticker in its own column (sized by
     global.css's landscape rule), copy left-aligned — at desktop card size. */
  @media (max-height: 500px) and (orientation: landscape) {
    .prog-hero { text-align: left; }
    .prog-hero__card {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: start; /* the card is taller than the screen: keep the sticker up beside the headline */
      gap: 1.5rem;
    }
    .prog-hero__sticker { order: 0; margin: 0; }
    .prog-hero__heading { font-size: 2.2rem; text-wrap: balance; }
    .prog-hero__heading br { display: none; }
    .prog-hero__heading::after { margin-left: 0; margin-right: 0; }
    .prog-hero__sub { margin: 0; }
    .prog-hero__intake { margin: 1rem 0 0.75rem; }
  }

  /* ===== NAV — solid strip, grey tabs, red active rule ===== */
  /* Solid, never translucent (the LMS system retires frosted panels): a
     translucent fill let section headings read through the bar while
     scrolling. Matches the English and GP pages. */
  .prog-nav {
    background: var(--bg-primary);
    border-bottom: 1px solid var(--border-color);
    padding: 0.5rem 0;
    position: sticky;
    top: var(--nav-offset);
    z-index: var(--z-subject-selector);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .prog-nav::-webkit-scrollbar {
    display: none;
  }

  .prog-nav__inner {
    display: flex;
    justify-content: center;
    gap: 2rem;
    flex-wrap: nowrap;
    min-width: max-content;
  }

  .prog-nav__link {
    font-family: var(--prog-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
    text-decoration: none;
    padding: 0.4rem 0.25rem;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    border-bottom: 2px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
    touch-action: manipulation;
  }

  .prog-nav__link:hover {
    color: var(--text-primary);
    border-bottom-color: var(--ink-faint);
  }

  .prog-nav__link.is-active {
    color: var(--color-accent-text);
    border-bottom-color: var(--color-accent);
  }

  /* Tablets and small laptops (769–1199px): the nine tabs at a 2rem gap are ~1180px wide, so on
     a 1024px iPad the strip was clipped at "FAQ" with "Schedule" off-screen
     and no hint that it scrolls. Same treatment as phones (<=768px, below):
     tighter gap, edge padding, and a right-edge fade that reads as scrollable. */
  @media (min-width: 769px) and (max-width: 1199px) {
    .prog-nav {
      -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 40px), transparent);
      mask-image: linear-gradient(to right, #000 calc(100% - 40px), transparent);
    }
    .prog-nav__inner {
      gap: 1.25rem;
      padding-inline: var(--page-padding) 2.5rem;
    }
  }

  /* ===== SECTIONS ===== */
  .prog-section {
    background: transparent;
    padding: 1.25rem 0;
    scroll-margin-top: calc(var(--nav-offset) + 48px);
  }

  .prog-section + .prog-section {
    border-top: 1px solid var(--prog-border);
  }

  .prog-section__heading {
    font-family: var(--prog-font);
    font-size: clamp(1.8rem, 3.5vw, 2.4rem);
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
    letter-spacing: -0.03em;
  }

  /* Red marker squiggle under every section heading (the sitewide motif) */
  .prog-section__heading::after {
    content: '';
    display: block;
    width: 72px;
    height: 12px;
    margin-top: 0.4rem;
    background: var(--swash) left center / contain no-repeat;
  }

  .prog-section__sub {
    font-family: var(--prog-font);
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--prog-text-secondary);
    max-width: 37.5rem; /* 600px at the 16px root; as px it fell to ~50 characters a line at 2560px */
    margin-bottom: 1rem;
  }

  /* ===== CARD GRID ===== */
  .card-grid {
    display: grid;
    gap: 1rem;
  }

  .card-grid--1 {
    grid-template-columns: minmax(0, 1fr);
    max-width: 50rem; /* 800px at the 16px root; as px the lone programme card shrank to a third of a 2560px screen */
  }

  .card-grid--2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  /* Two columns hold down to 641px: a single full-width column on a 768px
     iPad ran the SHARP and framework paragraphs at ~105 characters a line
     (and the 820px iPad already got two columns). */
  @media (max-width: 720px) {
    .card-grid--2 { grid-template-columns: minmax(0, 1fr); }
  }

  /* ===== PROGRAMME CARD — white sticker, ink outline, lifts on hover
     (hover/press come from the global .prog-card rules) ===== */
  .prog-card {
    background: var(--bg-card);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
  }

  /* SHARP step cards: red letter badge before the step name, so this band
     carries the same S/H/A/R/P chrome as the playbook matrix below it. */
  #approach .prog-card__title { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
  #approach .prog-card__title .step-dot { width: 32px; height: 32px; font-size: 0.9rem; }

  .prog-card__title {
    font-family: var(--prog-font);
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }

  .prog-card__desc {
    font-family: var(--prog-font);
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
    /* ~80 characters a line (Nunito's "0" is 0.6em wide, so 60ch ≈ 36em).
       In the 800px single-card programme sections the paragraph ran ~115
       characters a line on laptops, ~100 on 1920px screens. */
    max-width: 60ch;
  }
  /* Laptops and up: running copy at >=15px (0.9rem was 14.4px) */
  @media (min-width: 1024px) {
    .prog-card__desc { font-size: 0.95rem; }
  }

  .prog-card__topics {
    list-style: none;
    padding: 0;
    margin: 0 0 auto;
    flex-grow: 1;
  }

  .prog-card__topics li {
    font-family: var(--prog-font);
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--prog-text-secondary);
    padding: 0.45rem 0;
    border-bottom: 1px solid var(--border-color);
    padding-left: 1rem;
    position: relative;
  }

  .prog-card__topics li::before {
    content: '';
    position: absolute;
    left: 0;
    /* Pinned to the FIRST line (padding 0.45rem + half of the 1.23rem line box
       - half the 0.85rem marker), not the li's centre — a wrapped item used to
       float the mascot in the gap between its two lines. */
    top: 0.64rem;
    width: 0.85rem;
    height: 0.85rem;
    background: url('/images/mascots/mascot-heart-alt-icon.webp') center / contain no-repeat;
  }

  .prog-card__topics li:last-child {
    border-bottom: none;
  }

  .prog-card__meta {
    display: flex;
    gap: 1.25rem;
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--prog-border);
    flex-wrap: wrap;
  }

  .prog-card__meta span {
    font-family: var(--prog-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--prog-text-secondary);
  }

  .prog-card__fee {
    font-family: var(--prog-font);
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--color-accent-text);
    margin-top: 0.75rem;
    margin-bottom: 0;
  }

  /* ===== LESSON FLOW — red numbered dots on a timeline ===== */
  .lesson-flow { background: var(--bg-secondary); }
  .prog-section__intro { font-family: var(--prog-font); font-size: 1.05rem; line-height: 1.7; color: var(--prog-text-secondary); max-width: 60ch; margin: 0 0 1rem; }
  .prog-section__intro em { font-style: italic; color: var(--subject-accent-text); font-weight: 700; }
  /* 42rem keeps each step's paragraph at ~85 characters a line; at 1040px it
     ran ~135 on laptops and ~120 on 1920px screens. rem, so it scales with the
     larger root on big monitors. */
  .lesson-timeline { list-style: none; padding: 0; margin: 0; max-width: 42rem; }
  .lesson-step {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 1.25rem;
    padding: 1rem 0;
    border-top: 1px solid var(--prog-border);
  }
  .lesson-step:last-child { border-bottom: 1px solid var(--prog-border); }
  .lesson-step__num {
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--color-accent);
    color: #fff;
    border: 2px solid var(--color-ink);
    box-shadow: 0 3px 0 var(--color-accent-press);
    font-family: var(--prog-font);
    font-weight: 800;
    font-size: 1.05rem;
    line-height: 1;
    letter-spacing: 0;
    font-feature-settings: "tnum" 1, "lnum" 1;
    font-variant-numeric: tabular-nums lining-nums;
  }
  .lesson-step__body { min-width: 0; }
  .lesson-step__time {
    display: inline-block;
    font-family: var(--prog-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }
  .lesson-step__title {
    font-family: var(--prog-font);
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 0.6rem;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }
  .lesson-step__desc {
    font-family: var(--prog-font);
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--prog-text-secondary);
    margin: 0;
    text-wrap: pretty;
  }
  .lesson-step__desc em { font-style: italic; color: var(--subject-accent-text); font-weight: 700; }
  .lesson-flow__note { margin-top: 0.75rem; font-size: 0.85rem; color: var(--text-muted); font-style: italic; max-width: 60ch; }
  /* The shared footnote (global.css) has no measure: ~155–195 characters a
     line from 1024px up */
  .ba-footnote { max-width: 60ch; }
  @media (max-width: 720px) {
    .lesson-step { grid-template-columns: 44px 1fr; gap: 0.9rem; padding: 1.25rem 0; }
    .lesson-step__num { width: 40px; height: 40px; font-size: 0.95rem; }
    .lesson-step__desc { font-size: 0.92rem; }
  }

  /* ===== INLINE CTA ===== */
  .prog-inline-cta { text-align: center; padding: 1rem 0 0; }
  /* The playbook CTA sits outside any .container (playbook.css gives it no
     side padding), so on phones its full-width button ran edge to edge of
     the screen and the line above it touched the edges */
  .playbook-cta { padding-inline: var(--page-padding); }

  /* ===== CTA ===== */
  .prog-cta {
    background: transparent;
    border-top: 1px solid var(--prog-border);
    padding: 1.25rem 0;
  }

  .prog-cta__inner {
    text-align: center;
    /* rem, not px (37.5rem = 600px at the 16px root): with the 112.5–150% root
       on large monitors a 600px box minus the container padding squeezed the
       heading to three lines and stacked the two buttons */
    max-width: 37.5rem;
    margin: 0 auto;
  }

  .prog-cta__heading {
    font-family: var(--prog-font);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
    letter-spacing: -0.03em;
  }

  .prog-cta__sub {
    font-family: var(--prog-font);
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--prog-text-secondary);
    margin-bottom: 1rem;
  }

  .prog-cta__actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* Look comes from the global .btn / .btn-accent — size only here */
  .prog-cta__btn {
    padding: 0.85rem 1.9rem;
  }

  /* WhatsApp keeps its brand green, inside the same ink pill + hard shadow */
  .prog-cta__btn--whatsapp {
    background: var(--color-whatsapp);
    color: #0B1F14;
  }
  .prog-cta__btn--whatsapp:hover {
    background: var(--color-whatsapp-dark);
    color: #0B1F14;
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 768px) {
    .prog-hero {
      padding: 1rem 0 0.75rem;
    }

    .prog-nav {
      padding: 0.5rem 0;
      /* Fade the right edge so the clipped tab row reads as scrollable */
      -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 40px), transparent);
      mask-image: linear-gradient(to right, #000 calc(100% - 40px), transparent);
    }

    .prog-section {
      padding: 1rem 0;
    }

    .prog-section__sub {
      margin-bottom: 0.75rem;
    }

    .prog-nav__inner {
      gap: 1rem;
      /* the last tab clears the 40px fade */
      padding-inline: var(--page-padding) 2.5rem;
    }

    .prog-card {
      padding: 1.25rem;
    }

    .prog-cta {
      padding: 1.25rem 0;
    }

    .faq-section, .recommended-reading, .subject-testimonials, .related-section { padding: 1rem 0; }
  }

  @media (max-width: 480px) {
    .prog-hero {
      padding: 0.75rem 0 0.5rem;
    }

    .prog-hero__sticker {
      width: 150px;
    }

    .prog-hero__heading {
      font-size: 1.8rem;
      margin-bottom: 0.5rem;
    }

    .prog-hero__sub {
      font-size: 0.95rem;
    }

    .prog-section {
      padding: 0.75rem 0;
    }

    .prog-section__heading {
      margin-bottom: 0.5rem;
    }

    .prog-section__sub {
      margin-bottom: 0.5rem;
    }

    .prog-nav__inner {
      gap: 0.6rem;
    }

    .prog-nav__link {
      font-size: 0.75rem;
      padding: 0.5rem 0.3rem;
      min-height: 44px;
      display: inline-flex;
      align-items: center;
    }

    .prog-cta__actions {
      flex-direction: column;
      align-items: center;
    }

    .prog-cta__btn {
      width: 100%;
      text-align: center;
    }

    .prog-card { padding: 1rem; }
    .faq-section, .recommended-reading, .subject-testimonials, .related-section { padding: 0.75rem 0; }
  }

  /* ===== STICKY TOC — a small ink card in the right margin ===== */
  .sticky-toc {
    position: fixed;
    top: calc(var(--nav-offset) + 44px + 1.5rem); /* 44px = the breadcrumb strip, so the card never sits on it at load */
    right: 1.5rem;
    z-index: 50;
    max-width: 200px;
    display: none;
    background: var(--bg-card);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-md);
    padding: 0.9rem 1rem 0.9rem 0.9rem;
  }
  /* Only where it fits beside the content. From 1280 to 1680px the 190px card
     covered the page by 46–155px and ran into the WhatsApp, chat and
     back-to-top floats; the sticky section-nav strip already gives in-page
     navigation at those widths. On wide monitors it sits in the margin,
     narrowed, and stops above the floats and the bottom sticky bar. */
  @media (min-width: 1920px) {
    .sticky-toc {
      display: block;
      right: 1rem;
      max-width: 170px;
      max-height: calc(100vh - (var(--nav-offset) + 44px + 1.5rem) - 12rem - var(--sticky-bar-h, 0px));
      overflow-y: auto;
      overscroll-behavior: contain;
    }
  }

  /* The TOC only appears once the reader is past the hero. Until then the
     section-nav strip (z-index above it) painted straight across the card on
     pages with a short hero, and the card crowded the hero. JS-gated, so a
     no-JS visitor still gets the plain sticky card. */
  html.js .sticky-toc { opacity: 0; visibility: hidden; pointer-events: none; transition: opacity 0.25s ease, visibility 0.25s ease; }
  html.js .sticky-toc.is-ready { opacity: 1; visibility: visible; pointer-events: auto; }
  @media (prefers-reduced-motion: reduce) { html.js .sticky-toc { transition: none; } }

  .sticky-toc-eyebrow {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
    padding-left: 0.85rem;
  }
  .sticky-toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 2px solid var(--ink-faint);
  }
  /* The items are created by the inline script, so they carry no scope id */
  .sticky-toc :global(.sticky-toc-item) {
    padding: 0.3rem 0 0.3rem 0.85rem;
    margin: 0;
  }
  .sticky-toc :global(.sticky-toc-link) {
    font-size: 0.78rem;
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 700;
    transition: color 0.2s ease;
    display: block;
  }
  .sticky-toc :global(.sticky-toc-link:hover),
  .sticky-toc :global(.sticky-toc-link.is-active) {
    color: var(--color-accent-text);
  }
  .sticky-toc :global(.sticky-toc-item.is-active) {
    border-left: 2px solid var(--color-accent);
    margin-left: -2px;
  }

  /* ===== RELATED LINKS — the other subjects as LMS subject cards (global
     .subject-card: sticker on its pastel panel), then plain ink link cards ===== */
  .related-section { background: var(--bg-secondary); padding: 1.25rem 0; }
  .related-subjects {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  /* Equal panel heights: the subject stickers differ by a few px in aspect ratio,
     which staggered the dashed dividers and the titles underneath them. */
  .related-section .subject-panel--sm { min-height: 160px; }
  /* Keep the subject dot beside the first line when the meta text wraps */
  .related-subjects .subject-card__meta { align-items: flex-start; }
  .related-subjects .subject-dot { margin-top: 0.42em; }
  .related-links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .related-link {
    display: block;
    text-decoration: none;
    padding: 1.25rem;
    min-height: 44px;
    background: var(--bg-card);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-md);
    transition: transform 0.22s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.22s ease;
  }
  @media (hover: hover) {
    .related-link:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 0 var(--ink-shadow), 0 12px 24px rgba(70, 50, 20, 0.10);
    }
  }
  .related-link strong {
    display: block;
    font-size: 0.9rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }
  .related-link span {
    font-size: 0.78rem;
    color: var(--text-muted);
    line-height: 1.4;
  }
  @media (max-width: 1024px) {
    .related-links { grid-template-columns: 1fr 1fr; }
    .related-subjects { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 480px) {
    .related-links { grid-template-columns: 1fr; }
    .related-subjects { gap: 0.75rem; }
  }

  /* ===== SCHEDULE TABLE — white table inside an ink-outlined sticker ===== */
  .schedule-table-wrap {
    overflow-x: auto; margin: 1rem 0; -webkit-overflow-scrolling: touch;
    background: var(--bg-card); border: 2px solid var(--color-ink); border-radius: var(--radius-md);
  }
  .schedule-table { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  .schedule-table th, .schedule-table td { padding: 0.75rem 1.25rem; text-align: left; border-bottom: 1px solid var(--border-color); }
  .schedule-table th { background: var(--bg-muted); font-family: var(--font-mono); font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-secondary); }
  .schedule-table td { color: var(--text-primary); }
  .schedule-table tbody tr:last-child td { border-bottom: none; }
  .schedule-table tbody tr:hover { background: var(--bg-muted); }
  .schedule-note { margin-top: 1rem; font-size: 0.9rem; color: var(--text-secondary); }
  .schedule-note a { color: var(--color-accent-text); font-weight: 700; text-decoration: underline; }
  /* Phones: each row becomes a stacked card (label left, value right) so the
     Status chips are never off-canvas behind a hidden horizontal scroll */
  @media (max-width: 640px) {
    .schedule-table, .schedule-table tbody, .schedule-table tr { display: block; }
    .schedule-table thead { display: none; }
    .schedule-table tr { padding: 0.6rem 1rem; }
    .schedule-table tbody tr + tr { border-top: 1px solid var(--border-color); }
    .schedule-table tbody tr:hover { background: transparent; }
    .schedule-table td {
      display: flex; justify-content: space-between; align-items: center; gap: 1rem;
      padding: 0.3rem 0; border: 0; font-size: 0.9rem; text-align: right;
    }
    .schedule-table td::before {
      content: attr(data-label);
      font-family: var(--font-mono); font-size: 0.72rem; font-weight: 700;
      letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-secondary);
      text-align: left; flex-shrink: 0;
    }
    .schedule-table td:first-child { font-weight: 800; }
  }

  /* ===== FAQ — one ink card, hairline-divided items ===== */
  .faq-section {
    padding: 1.25rem 0;
    background: var(--bg-secondary);
    scroll-margin-top: calc(var(--nav-offset) + 48px);
  }
  .faq-list {
    max-width: 50rem; /* 800px at the 16px root */
    margin: 0 auto;
    background: var(--bg-card);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-md);
    padding: 0.25rem 1.25rem;
  }
  .faq-item {
    border-bottom: 1px solid var(--border-color);
    padding: 0.85rem 0;
  }
  .faq-item:last-child {
    border-bottom: none;
  }
  .faq-question {
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--text-primary);
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    min-height: 44px;
    touch-action: manipulation;
    transition: color var(--transition-fast);
  }
  .faq-question::-webkit-details-marker { display: none; }
  .faq-question:hover,
  .faq-item[open] .faq-question {
    color: var(--color-accent-text);
  }
  .faq-question::after {
    content: '+';
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--color-accent-text);
    flex-shrink: 0;
    transition: transform var(--transition-fast);
  }
  .faq-item[open] .faq-question::after {
    content: '\2212';
  }
  .faq-answer {
    padding-top: 0.5rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }
  .faq-answer p {
    margin: 0;
    max-width: 60ch; /* ~100 characters a line in the 800px card on laptops */
  }

  /* ===== RECOMMENDED READING — ink cards ===== */
  .recommended-reading {
    padding: 1.25rem 0;
  }
  .reading-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }
  .reading-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    background: var(--bg-card);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
    text-decoration: none;
  }
  .reading-card:hover .reading-card-arrow {
    transform: translateX(4px);
  }
  .reading-card h3 {
    color: var(--text-primary);
    font-size: 0.95rem;
    margin: 0;
    font-weight: 800;
  }
  .reading-card-arrow {
    color: var(--color-accent-text);
    font-size: 1.2rem;
    font-weight: 800;
    flex-shrink: 0;
    margin-left: 1rem;
    transition: transform var(--transition-fast);
  }

  /* ===== SUBJECT TESTIMONIALS — ink cards with a subject-coloured rail ===== */
  .subject-testimonials {
    padding: 1.25rem 0;
  }
  .subject-testimonial-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1rem;
  }
  .subject-quote {
    background: var(--bg-card);
    border: 2px solid var(--color-ink);
    border-left: 6px solid var(--subject-accent);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    margin: 0;
    position: relative;
    overflow: hidden;
    transition: transform 0.22s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.22s ease;
  }
  @media (hover: hover) {
    .subject-quote:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 0 var(--ink-shadow), 0 12px 24px rgba(70, 50, 20, 0.10);
    }
  }
  .subject-quote::before {
    content: '\201C';
    position: absolute;
    top: -1rem;
    right: 0.75rem;
    font-family: var(--font-heading);
    font-size: 4.5rem;
    font-weight: 900;
    line-height: 1;
    color: var(--subject-accent);
    opacity: 0.16;
    pointer-events: none;
  }
  .subject-quote > * {
    position: relative;
    z-index: 1;
  }
  .subject-quote p {
    color: var(--text-primary);
    font-style: italic;
    line-height: 1.6;
    margin: 0 0 0.75rem;
  }
  .subject-quote cite {
    color: var(--text-muted);
    font-size: 0.85rem;
    font-style: normal;
    font-weight: 700;
  }

  /* ===== SUBJECT RECEIPTS — coloured stat dots before each number ===== */
  .subject-receipts dt { display: flex; align-items: center; gap: 0.35rem; }
  .subject-receipts dt .stat-dot { width: 12px; height: 12px; margin-right: 0; }
  /* Five stats: one row on desktop/tablet, 2-up on phones (the sitewide rule —
     never a single column of giant numbers); the shared 3-column grid lives in
     global.css, so this override carries the section class for specificity */
  .subject-receipts-section .subject-receipts dl { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1.5rem; }
  /* The shared rail is capped at 960px; with the 150% root at 2560px the five
     72px numbers overran their columns ("180+" ran into "4.9"). Same width at
     the 16px root, scales with the root above it. */
  .subject-receipts-section .subject-receipts { max-width: 60rem; }
  .subject-receipts-section .subject-receipts dt { font-size: clamp(2rem, 3.3vw, 3rem); }
  @media (max-width: 720px) {
    .subject-receipts-section .subject-receipts dl { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem 1.25rem; }
    .subject-receipts-section .subject-receipts dt { font-size: clamp(1.9rem, 7vw, 2.4rem); }
    .subject-receipts-section .subject-receipts dl > div:last-child { grid-column: 1 / -1; }
  }

  /* ===== MID-PAGE CTA BAND — ink card with a subject-coloured rail ===== */
  .prog-midcta { padding-top: 0; }
  .prog-midcta__inner { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; border: 2px solid var(--color-ink); border-left: 6px solid var(--subject-accent); border-radius: var(--radius-md); background: var(--prog-bg-card); padding: 1.5rem 1.75rem; }
  .prog-midcta__heading { font-size: 1.25rem; font-weight: 800; margin: 0 0 0.3rem; font-family: var(--font-body); letter-spacing: -0.02em; }
  .prog-midcta__sub { font-size: 0.92rem; line-height: 1.55; color: var(--prog-text-secondary); margin: 0; max-width: 35rem; }
  .prog-midcta__actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  /* Laptops and up: running copy at >=15px (0.92rem was 14.7px) */
  @media (min-width: 1024px) { .prog-midcta__sub { font-size: 0.95rem; } }
  @media (max-width: 700px) {
    .prog-midcta__inner { flex-direction: column; align-items: stretch; text-align: center; }
    .prog-midcta__actions { justify-content: center; }
  }

  /* ===== SHARP PLAYBOOK — local overrides on the shared playbook.css so the
     matrix reads as an ink-outlined sticker (the shared file is not ours to edit) ===== */
  .playbook-matrix { gap: 2px; background: var(--color-ink); border: 2px solid var(--color-ink); }
  .playbook-matrix__col-label, .playbook-matrix__step { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; }
  /* Light mode: header chrome is the ink navy (dark mode keeps playbook.css's light-accent flip) */
  :global(html:not([data-theme="dark"])) .playbook-matrix__col-label,
  :global(html:not([data-theme="dark"])) .playbook-matrix__step { background: var(--color-ink); color: #fff; }
  .playbook-matrix__cell strong { font-weight: 800; }
  .playbook-step-name { font-size: 0.72rem; }
  .playbook-section-name { font-weight: 700; }
  @media (max-width: 900px) {
    .playbook-matrix { gap: 0.75rem; background: transparent; border: none; }
    .playbook-matrix__row { border: 2px solid var(--color-ink); border-radius: var(--radius-md); }
  }
  /* Tablet portrait: the six stacked topic cards ran ~2,400px in one column
     of 700px-wide cards; two per row (the header row is hidden here) */
  @media (min-width: 641px) and (max-width: 900px) {
    .playbook-matrix { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /* ===== REAL MATERIALS GALLERY — ink cards that lift, dark lightbox ===== */
  .notes-gallery { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; margin-bottom: 1.25rem; }
  .notes-gallery--two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  /* Laptops and up: the four report pages sit in one row, at the same scale as
     the notes above. Two-up they were 540px wide on a 1366px laptop and 713px
     on a 1920px screen — each page taller than the screen. */
  @media (min-width: 1025px) {
    .notes-gallery--two { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  .notes-shot {
    display: flex; flex-direction: column; padding: 0; border: 2px solid var(--color-ink); border-radius: var(--radius-md);
    background: var(--prog-bg-card); overflow: hidden; cursor: zoom-in; text-align: left; font: inherit; color: inherit;
    transition: transform 0.22s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.22s ease;
  }
  @media (hover: hover) {
    .notes-shot:hover { transform: translateY(-2px); box-shadow: 0 6px 0 var(--ink-shadow), 0 12px 24px rgba(70, 50, 20, 0.10); }
  }
  .notes-shot:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 3px; }
  .notes-shot img { display: block; width: 100%; height: auto; border-bottom: 2px solid var(--color-ink); }
  .notes-shot__cap { padding: 0.7rem 0.9rem; font-size: 0.85rem; line-height: 1.4; color: var(--prog-text-secondary); }
  .notes-footnote { font-size: 0.92rem; line-height: 1.6; color: var(--prog-text-secondary); max-width: 680px; margin: 0; }

  .notes-lightbox {
    position: fixed; inset: 0; z-index: var(--z-modal); display: none; align-items: center; justify-content: center;
    padding: 2rem; background: rgba(0, 0, 0, 0.82);
  }
  .notes-lightbox.is-open { display: flex; }
  .notes-lightbox__img { max-width: min(92vw, 720px); max-height: 88vh; width: auto; height: auto; border-radius: var(--radius-sm); border: 2px solid rgba(255, 255, 255, 0.4); box-shadow: 0 30px 70px -20px rgba(0, 0, 0, 0.6); }
  .notes-lightbox__close {
    position: absolute; top: 1.25rem; right: 1.25rem; width: 44px; height: 44px; border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.5); background: rgba(255, 255, 255, 0.1); color: #fff;
    font-size: 1.4rem; line-height: 1; cursor: pointer; display: grid; place-items: center;
  }
  .notes-lightbox__close:hover { background: rgba(255, 255, 255, 0.2); }

  /* Tablets and landscape phones: two per row. One column made every page a
     ~700px-wide, ~1,000px-tall image on an iPad — ten screens of scrolling. */
  @media (max-width: 900px) {
    .notes-gallery, .notes-gallery--two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) {
    .notes-gallery, .notes-gallery--two { grid-template-columns: minmax(0, 1fr); }
  }
</style>

<script is:inline>
(function(){
  var toc = document.getElementById('sticky-toc-list');
  if (!toc) return;
  var sections = document.querySelectorAll('section[id]');
  sections.forEach(function(s) {
    var heading = s.querySelector('h2, h1');
    if (!heading) return;
    var eyebrow = s.querySelector('.eyebrow');
    var label = eyebrow ? eyebrow.textContent.trim() : heading.textContent.substring(0, 22) + (heading.textContent.length > 22 ? '…' : '');
    var li = document.createElement('li');
    li.className = 'sticky-toc-item';
    var a = document.createElement('a');
    a.className = 'sticky-toc-link';
    a.href = '#' + s.id;
    a.textContent = label;
    li.appendChild(a);
    toc.appendChild(li);
  });

  if (!toc.children.length) { document.getElementById('sticky-toc').style.display = 'none'; return; }

  // Reveal the TOC only after the hero has scrolled away, so the fixed card
  // never sits over the hero card or under the sticky section-nav strip.
  (function () {
    var card = document.getElementById('sticky-toc');
    var nav = document.querySelector('.prog-nav');
    if (!card || !nav) return;
    // Runs on BaseLayout's shared scroll loop. The card only exists at 1920px+,
    // so narrower screens skip the layout read entirely, and the nav offset is
    // read once per resize rather than on every frame.
    var wide = window.matchMedia('(min-width: 1920px)');
    var offset = 116, ready = false;
    function readOffset() { offset = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--nav-offset')) || 116; }
    readOffset();
    window.addEventListener('resize', readOffset, { passive: true });
    window.aworthyOnScroll(function () {
      if (!wide.matches) return;
      var past = nav.getBoundingClientRect().top <= offset + 2;
      if (past === ready) return;
      ready = past;
      card.classList.toggle('is-ready', past);
    });
  })();

  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        toc.querySelectorAll('.sticky-toc-item').forEach(function(li) { li.classList.remove('is-active'); });
        toc.querySelectorAll('.sticky-toc-link').forEach(function(a) { a.classList.remove('is-active'); });
        var link = toc.querySelector('a[href="#' + entry.target.id + '"]');
        if (link) { link.classList.add('is-active'); link.parentElement.classList.add('is-active'); }
      }
    });
  }, { threshold: 0.2, rootMargin: '-20% 0px -60% 0px' });
  sections.forEach(function(s) { observer.observe(s); });
})();
</script>

<script is:inline>
(function(){
  var navLinks = document.querySelectorAll('.prog-nav__link');
  if (!navLinks.length) return;
  var sections = [];
  navLinks.forEach(function(link) {
    var id = link.getAttribute('href');
    if (id && id.charAt(0) === '#') {
      var el = document.querySelector(id);
      if (el) sections.push({ el: el, link: link });
    }
  });
  if (!sections.length) return;
  var obs = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        navLinks.forEach(function(l) { l.classList.remove('is-active'); });
        sections.forEach(function(s) {
          if (s.el === entry.target) s.link.classList.add('is-active');
        });
      }
    });
  }, { threshold: 0.15, rootMargin: '-20% 0px -60% 0px' });
  sections.forEach(function(s) { obs.observe(s.el); });
})();
</script>

<script is:inline>
function initNotesLightbox() {
  var box = document.getElementById('notes-lightbox');
  var img = document.getElementById('notes-lightbox-img');
  var closeBtn = document.getElementById('notes-lightbox-close');
  var shots = document.querySelectorAll('.notes-shot');
  if (!box || !img || !shots.length) return;

  function open(src, alt) {
    img.src = src;
    img.alt = alt;
    box.classList.add('is-open');
    closeBtn.focus();
  }
  function close() {
    box.classList.remove('is-open');
    img.src = '';
  }

  shots.forEach(function(btn) {
    btn.addEventListener('click', function() {
      var full = btn.getAttribute('data-full');
      var altText = btn.querySelector('img') ? btn.querySelector('img').alt : '';
      open(full, altText);
    });
  });
  closeBtn.addEventListener('click', close);
  box.addEventListener('click', function(e) { if (e.target === box) close(); });
  document.addEventListener('keydown', function(e) { if (e.key === 'Escape' && box.classList.contains('is-open')) close(); });
}
initNotesLightbox();
</script>

