  .prog-midcta__heading { font-size: 1.25rem; font-weight: 800; margin: 0 0 0.3rem; font-family: var(--font-body); letter-spacing: -0.015em; color: var(--text-primary); }
  .prog-midcta__sub { font-size: 0.92rem; line-height: 1.55; color: var(--prog-text-secondary); margin: 0; max-width: 35rem; }
  .prog-midcta__actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  @media (max-width: 700px) {
    .prog-midcta__inner { flex-direction: column; align-items: stretch; text-align: center; }
    .prog-midcta__actions { justify-content: center; }
  }

  /* ===== RESPONSIVE PASS ===== */
  /* The playbook CTA sits between sections, outside any .container, so on
     phones its line touched the screen edges and the full-width button ran
     edge to edge (same fix as the Maths pages). */
  .playbook-cta { padding-inline: var(--page-padding); }

  /* Materials galleries: one 700px-wide page per row on tablet portrait and
