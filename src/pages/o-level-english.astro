<!-- Per-subject accent — the LMS English blue (--subject-english, sampled from
     the LMS dashboard). Only --subject-accent / --subject-accent-text change;
     the action colour (--color-accent) stays the sitewide red. The global
     tokens already carry their dark-mode values, so there is no dark override. -->
<style is:global>
  :root {
    --subject-accent: var(--subject-english);
    --subject-accent-text: var(--subject-english-text);
  }
</style>

<style>
  /* ===== SUBJECT PAGE: O-Level English (sticker-book system) ===== */
  .frameworks-cta { text-align: center; margin-top: 2rem; }

  :root {
    --prog-bg: var(--bg-primary);
    --prog-bg-card: var(--bg-card);
    --prog-border: var(--border-color);
    --prog-text: var(--text-primary);
    --prog-text-secondary: var(--text-secondary);
    --prog-accent: var(--subject-accent);
    --prog-font: var(--font-body);
    --prog-mono: var(--font-mono);
    /* Dark ink for text on the WhatsApp green (white fails AA on #25D366) */
    --wa-ink: #0E2B19;
  }

  /* ===== HERO — the LMS welcome card: a white ink card with the subject-tint
     wash (global .hero-card; .subject--english on the section resolves the
     tint). Sticker centred above the copy on narrow screens; from 1024px the
     copy sits left and the sticker in a right column. The section itself
     stays on the cream canvas. ===== */
  .prog-hero { background: var(--prog-bg); padding: 1.25rem 0 0.75rem; text-align: center; position: relative; overflow: hidden; }
  .prog-hero::before { content: ''; position: absolute; top: -20%; right: -10%; width: 600px; height: 600px; border-radius: 50%; background: radial-gradient(circle, color-mix(in srgb, var(--subject-accent) 12%, transparent) 0%, transparent 70%); pointer-events: none; z-index: 0; }
  :global([data-theme="dark"]) .prog-hero::before { background: radial-gradient(circle, color-mix(in srgb, var(--subject-accent) 8%, transparent) 0%, transparent 70%); }
  /* Card, copy measure and sticker are sized in rem (1080px / 640px / 180px at
     the 16px root, so nothing changes up to 1440px): in px they stayed put
     while html scales to 112.5–150% on big monitors, and at 2560 the hero was
     a narrow box with a 7-line intro lost in the page's whitespace. */
  .prog-hero .container { position: relative; z-index: 1; max-width: 67.5rem; }
  /* Keep the card clear of the fixed "On this page" TOC (190px + 1.5rem at the right edge from 1280px) */
  .prog-hero__copy { min-width: 0; }
  .prog-hero__sticker { width: min(200px, 48vw); margin: 0 auto 0.75rem; }
  .prog-hero__heading { font-family: var(--prog-font); font-size: clamp(2.4rem, 5vw, 3.6rem); font-weight: 900; line-height: 1.12; color: var(--text-primary); margin-bottom: 0.75rem; letter-spacing: -0.03em; }
  /* Red marker squiggle under the headline (LMS: "Welcome to the A-Worthy World") */
  .prog-hero__heading::after { content: ''; display: block; width: 72px; height: 12px; margin: 0.45rem auto 0; background: var(--swash) left center / contain no-repeat; }
  .prog-hero__sub { font-family: var(--prog-font); font-size: 1.1rem; line-height: 1.7; color: var(--prog-text-secondary); max-width: 40rem; margin: 0 auto; }
  /* From 1024px, not 1025: iPad landscape (1024x768) got the stacked
     phone layout, a 700px-tall card that filled the whole first screen. */
  @media (min-width: 1024px) {
    .prog-hero__card { display: flex; align-items: center; gap: 1.5rem; text-align: left; }
    .prog-hero__copy { flex: 1 1 auto; }
    .prog-hero__sticker { order: 2; flex: 0 0 auto; width: min(11.25rem, 207px); margin: 0; }
    .prog-hero__heading { font-size: clamp(2.2rem, 3vw, 2.8rem); }
    .prog-hero__heading::after { margin-left: 0; margin-right: 0; }
    .prog-hero__sub { margin: 0; }
  }
  /* Landscape phones (~390px tall): the sticker stacked above the headline
     pushed "in Singapore" below the first screen. Put it beside the copy
     (global.css already caps it at 112px tall here) and step the headline
     down so it holds to two lines. */
  @media (max-height: 500px) and (orientation: landscape) and (max-width: 1023px) {
    /* top-aligned: centred, the sticker sat under the WhatsApp and chat floats */
    .prog-hero__card { display: flex; align-items: flex-start; gap: 1.25rem; text-align: left; }
    .prog-hero__copy { flex: 1 1 auto; }
    .prog-hero__sticker { order: 2; flex: 0 0 auto; margin: 0; }
    .prog-hero__heading { font-size: clamp(1.75rem, 4.2vw, 2.2rem); }
    .prog-hero__heading::after { margin-left: 0; margin-right: 0; }
    .prog-hero__sub { margin: 0; }
  }

  /* ===== SECTION NAV — a solid sticky strip under the header ===== */
  /* Solid, never translucent (the LMS system retires frosted panels): the old
     rgba + backdrop-filter let section headings and their squiggles read
     straight through the bar while scrolling. The token resolves per theme,
     so no dark override is needed. */
  .prog-nav { background: var(--bg-primary); border-bottom: 1px solid var(--border-color); padding: 0.25rem 0; position: sticky; top: var(--nav-offset); z-index: var(--z-subject-selector); overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
  .prog-nav::-webkit-scrollbar { display: none; }
  .prog-nav__inner { display: flex; justify-content: center; gap: 1.75rem; flex-wrap: nowrap; min-width: max-content; }
  /* Scroll affordance: below ~1100px the links overflow and, with the scrollbar
     hidden, the strip used to guillotine the last link mid-word with no cue
     that it scrolls. This sticky chip rides the right edge of the scrollport
     and fades the trailing link into the bar colour. It is an opaque overlay,
     not a mask, so the bar itself stays solid. */
  .prog-nav__inner::after { content: ''; position: sticky; right: 0; flex: 0 0 2.5rem; align-self: stretch; margin-left: -2.5rem; background: linear-gradient(90deg, transparent, var(--bg-primary)); pointer-events: none; }
  .prog-nav__link { font-family: var(--prog-mono); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-secondary); text-decoration: none; padding: 0.4rem 0.3rem; min-height: 44px; display: inline-flex; align-items: center; border-bottom: 2px solid transparent; transition: color 0.2s ease, border-color 0.2s ease; touch-action: manipulation; }
  .prog-nav__link:hover { color: var(--text-primary); border-bottom-color: var(--ink-faint); }
  .prog-nav__link.is-active { color: var(--color-accent-text); border-bottom-color: var(--color-accent); }

  /* ===== SECTIONS ===== */
  .prog-section { background: var(--prog-bg); padding: 1.25rem 0; scroll-margin-top: calc(var(--nav-offset) + 48px); }
  .prog-section + .prog-section { border-top: 1px solid var(--prog-border); }
  .prog-section__heading { font-family: var(--prog-font); font-size: clamp(1.8rem, 3.5vw, 2.4rem); font-weight: 800; color: var(--text-primary); margin-bottom: 0.5rem; letter-spacing: -0.02em; }
  /* Red marker squiggle under every section heading (the sitewide motif) */
  .prog-section__heading::after { content: ''; display: block; width: 72px; height: 12px; margin-top: 0.4rem; background: var(--swash) left center / contain no-repeat; }
  .prog-section__sub { font-family: var(--prog-font); font-size: 1.05rem; line-height: 1.7; color: var(--prog-text-secondary); max-width: 37.5rem; margin-bottom: 1rem; }
  .card-grid { display: grid; gap: 1rem; }
  .card-grid--1 { grid-template-columns: minmax(0, 1fr); max-width: 50rem; }
  .card-grid--2 { grid-template-columns: repeat(2, 1fr); }

  /* ===== PROGRAMME CARD — white sticker card, 2px ink ===== */
  .prog-card { background: var(--bg-card); border: 2px solid var(--color-ink); border-radius: var(--radius-md); padding: 1.25rem; transition: transform 0.22s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.22s ease; display: flex; flex-direction: column; }
  .prog-card__title { font-family: var(--prog-font); font-size: 1.15rem; font-weight: 800; color: var(--text-primary); margin-bottom: 0.75rem; letter-spacing: -0.015em; }
  .prog-card__desc { font-family: var(--prog-font); font-size: 0.9rem; line-height: 1.65; color: var(--text-secondary); margin-bottom: 0.75rem; }
  .prog-card__topics { list-style: none; padding: 0; margin: 0 0 auto; flex-grow: 1; }
  .prog-card__topics li { font-family: var(--prog-font); font-size: 0.82rem; line-height: 1.5; color: var(--prog-text-secondary); padding: 0.45rem 0; border-bottom: 1px solid var(--border-color); padding-left: 1.3rem; position: relative; }
  /* Pinned to the FIRST line (0.45rem padding + half the 1.23rem line box - half
     the marker), not the li's centre — a wrapped item used to float the mascot
     in the gap between its lines. */
  .prog-card__topics li::before { content: ''; position: absolute; left: 0; top: 0.64rem; width: 0.85rem; height: 0.85rem; background: var(--sticker-bullet) center / contain no-repeat; }
  .prog-card__topics li:last-child { border-bottom: none; }
  .prog-card__meta { display: flex; gap: 1.25rem; margin-top: 1rem; padding-top: 0.75rem; border-top: 2px dashed var(--ink-faint); flex-wrap: wrap; }
  .prog-card__meta span { font-family: var(--prog-mono); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-secondary); }
  .prog-card__fee { font-family: var(--prog-font); font-size: 1.1rem; font-weight: 800; color: var(--color-accent-text); margin-top: 0.75rem; margin-bottom: 0; }

  /* ===== LESSON FLOW ===== */
  .lesson-flow { background: var(--bg-secondary); }
  .prog-section__intro { font-family: var(--prog-font); font-size: 1.05rem; line-height: 1.7; color: var(--prog-text-secondary); max-width: 720px; margin: 0 0 1rem; }
  .prog-section__intro em { font-style: italic; color: var(--subject-accent-text); font-weight: 700; }
  .lesson-timeline { list-style: none; padding: 0; margin: 0; max-width: 42rem; } /* ~80 characters a line, as on the GP and maths pages */
  .lesson-step {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 1.25rem;
    padding: 1rem 0;
    border-top: 1px solid var(--prog-border);
  }
  .lesson-step:last-child { border-bottom: 1px solid var(--prog-border); }
  /* Step number — red circle with an ink outline */
  .lesson-step__num {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: inline-grid;
    place-items: center;
    background: var(--color-accent);
    color: #fff;
    border: 2px solid var(--color-ink);
    box-shadow: 0 3px 0 var(--color-accent-press);
    font-family: var(--prog-font);
    font-weight: 900;
    font-size: 1.05rem;
    line-height: 1;
    letter-spacing: -0.02em;
    font-feature-settings: "tnum" 1, "lnum" 1;
    font-variant-numeric: tabular-nums lining-nums;
  }
  .lesson-step__body { min-width: 0; }
  .lesson-step__time {
    display: inline-block;
    font-family: var(--prog-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }
  .lesson-step__title {
    font-family: var(--prog-font);
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 0.6rem;
    letter-spacing: -0.015em;
    line-height: 1.25;
  }
  .lesson-step__desc {
    font-family: var(--prog-font);
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--prog-text-secondary);
    margin: 0;
    text-wrap: pretty;
  }
  .lesson-step__desc em { font-style: italic; color: var(--subject-accent-text); font-weight: 700; }
  .lesson-flow__note { margin-top: 0.75rem; font-size: 0.85rem; color: var(--text-muted); font-style: italic; max-width: 60ch; }
  @media (max-width: 720px) {
    .lesson-step { grid-template-columns: 1fr; gap: 0.6rem; padding: 1.25rem 0; }
    .lesson-step__desc { font-size: 0.92rem; }
  }

  /* ===== CTAs — page-scoped classes only size the global .btn look ===== */
  .prog-inline-cta { text-align: center; padding: 1rem 0 0; }
  .prog-cta { background: var(--prog-bg); border-top: 1px solid var(--prog-border); padding: 1.25rem 0; }
  /* rem, not px: at 600px the box minus the container's 4rem gutters left
     ~460px at 1920/2560, so the two CTA buttons stacked and the heading
     broke "O-" / "Level" across lines. */
  .prog-cta__inner { text-align: center; max-width: 42rem; margin: 0 auto; }
  .prog-cta__heading { font-family: var(--prog-font); font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 800; color: var(--text-primary); margin-bottom: 0.75rem; letter-spacing: -0.02em; }
  .prog-cta__sub { font-family: var(--prog-font); font-size: 1.05rem; line-height: 1.7; color: var(--prog-text-secondary); margin-bottom: 1rem; }
  .prog-cta__actions { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }
  .prog-cta__btn { padding: 0.85rem 1.9rem; }
  /* WhatsApp stays WhatsApp green, but wears the same ink outline + hard shadow */
  .prog-cta__btn--whatsapp { background: var(--color-whatsapp); color: var(--wa-ink); }
  .prog-cta__btn--whatsapp:hover, .prog-cta__btn--whatsapp:focus-visible { background: var(--color-whatsapp-dark); color: var(--wa-ink); }
  @media (max-width: 768px) { .prog-hero { padding: 1rem 0 0.75rem; } .prog-section { padding: 1rem 0; } .prog-section__sub { margin-bottom: 0.75rem; } .prog-nav__inner { gap: 1rem; } .card-grid--2 { grid-template-columns: 1fr; } .prog-card { padding: 1.25rem; } .prog-cta { padding: 1.25rem 0; } .faq-section, .recommended-reading, .subject-testimonials, .related-section { padding: 1rem 0; } }
  @media (max-width: 480px) { .prog-hero { padding: 0.75rem 0 0.5rem; } .prog-hero__sticker { width: 150px; } .prog-hero__heading { font-size: 1.8rem; margin-bottom: 0.5rem; } .prog-hero__sub { font-size: 0.95rem; } .prog-section { padding: 0.75rem 0; } .prog-section__heading { margin-bottom: 0.5rem; } .prog-section__sub { margin-bottom: 0.5rem; } .prog-nav__inner { gap: 0.6rem; } .prog-nav__inner::after { flex-basis: 1.5rem; margin-left: -1.5rem; } .prog-nav__link { font-size: 0.75rem; padding: 0.5rem 0; min-height: 44px; display: inline-flex; align-items: center; } .prog-cta__actions { flex-direction: column; align-items: center; } .prog-cta__btn { width: 100%; text-align: center; } .prog-card__meta span { font-size: 0.75rem; } .lesson-step__time { font-size: 0.75rem; } .prog-card { padding: 1rem; } .faq-section, .recommended-reading, .subject-testimonials, .related-section { padding: 0.75rem 0; } }

  /* ===== STICKY TOC — a small ink card ===== */
  .sticky-toc {
    position: fixed;
    top: calc(var(--nav-offset) + 44px + 1.5rem); /* 44px = the breadcrumb strip, so the card never sits on it or the hero card at load */
    right: 1.5rem;
    z-index: 50;
    max-width: 190px;
    display: none;
    background: var(--bg-card);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-md);
    padding: 0.9rem 1rem;
  }
  /* Only where it fits beside the content. From 1280 to 1680px the 190px card
     covered the page by 46–155px and ran into the WhatsApp, chat and
     back-to-top floats; the sticky section-nav strip already gives in-page
     navigation at those widths. On wide monitors it sits in the margin,
     narrowed, and stops above the floats and the bottom sticky bar. */
  @media (min-width: 1920px) {
    .sticky-toc {
      display: block;
      right: 1rem;
      max-width: 170px;
      max-height: calc(100vh - (var(--nav-offset) + 44px + 1.5rem) - 12rem - var(--sticky-bar-h, 0px));
      overflow-y: auto;
      overscroll-behavior: contain;
    }
  }

  /* The TOC only appears once the reader is past the hero. Until then the
     section-nav strip (z-index above it) painted straight across the card on
     pages with a short hero, and the card crowded the hero. JS-gated, so a
     no-JS visitor still gets the plain sticky card. */
  html.js .sticky-toc { opacity: 0; visibility: hidden; pointer-events: none; transition: opacity 0.25s ease, visibility 0.25s ease; }
  html.js .sticky-toc.is-ready { opacity: 1; visibility: visible; pointer-events: auto; }
  @media (prefers-reduced-motion: reduce) { html.js .sticky-toc { transition: none; } }

  .sticky-toc-eyebrow {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }
  .sticky-toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 2px solid var(--ink-faint);
  }
  /* Items are created by the TOC script, so they carry no scope attribute — :global() */
  .sticky-toc-list :global(.sticky-toc-item) {
    padding: 0.3rem 0 0.3rem 0.75rem;
  }
  .sticky-toc-list :global(.sticky-toc-link) {
    font-size: 0.78rem;
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 700;
    transition: color 0.2s ease;
    display: block;
  }
  .sticky-toc-list :global(.sticky-toc-link:hover),
  .sticky-toc-list :global(.sticky-toc-link.is-active) {
    color: var(--color-accent-text);
  }
  .sticky-toc-list :global(.sticky-toc-item.is-active) {
    border-left: 2px solid var(--color-accent);
    margin-left: -2px;
  }

  /* ===== RELATED LINKS — ink cards that lift; the other subjects render as
     LMS subject cards (global .subject-card: sticker on its pastel panel,
     dashed divider, title + subject dot) in their own row ===== */
  .related-section { background: var(--bg-secondary); padding: 1.25rem 0; }
  .related-links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .related-section .related-subjects__label { display: block; margin: 1.25rem 0 0.75rem; }
  .related-subjects {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }
  /* Equal panel heights: the subject stickers differ by a few px in aspect ratio */
  .related-section .subject-panel--sm { min-height: 160px; }
  /* The subject dot sits on the FIRST line of the meta, not the centre of a
     wrapped two-line one (where it read as a stray dot starting line 2). */
  .subject-card__meta { align-items: flex-start; }
  .subject-card__meta .subject-dot { margin-top: 0.42em; flex: 0 0 auto; }
  .related-link {
    display: block;
    text-decoration: none;
    padding: 1.25rem;
    min-height: 44px;
    background: var(--bg-card);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-md);
    transition: transform 0.22s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.22s ease;
  }
  @media (hover: hover) {
    .related-link:hover { transform: translateY(-2px); box-shadow: 0 6px 0 var(--ink-shadow), 0 12px 24px rgba(70, 50, 20, 0.10); }
  }
  .related-link:active { transform: translateY(1px); box-shadow: 0 2px 0 var(--ink-shadow); }
  .related-link strong {
    display: block;
    font-size: 0.9rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }
  .related-link span {
    font-size: 0.78rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }
  @media (max-width: 1024px) {
    .related-links, .related-subjects { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 480px) {
    .related-links { grid-template-columns: 1fr; }
  }

  /* ===== SCHEDULE — table inside an ink card ===== */
  .schedule-table-wrap { overflow-x: auto; margin: 1rem 0; -webkit-overflow-scrolling: touch; scrollbar-width: none; -ms-overflow-style: none; background: var(--bg-card); border: 2px solid var(--color-ink); border-radius: var(--radius-md); }
  .schedule-table { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  .schedule-table th, .schedule-table td { padding: 0.75rem 1.25rem; text-align: left; border-bottom: 1px solid var(--border-color); }
  .schedule-table th { background: var(--bg-muted); font-family: var(--font-mono); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-secondary); font-weight: 700; border-bottom: 2px solid var(--color-ink); }
  .schedule-table td { color: var(--text-primary); }

  /* Phones: the 4-column schedule becomes labelled cards — it was 466px wide
     inside a 350px wrapper whose scrollbar is hidden, so the Status chip was
     unreachable. Same treatment as the other subject pages. */
  @media (max-width: 640px) {
    .schedule-table, .schedule-table tbody, .schedule-table tr { display: block; }
    .schedule-table thead { display: none; }
    .schedule-table tr { padding: 0.6rem 1rem; }
    .schedule-table tbody tr + tr { border-top: 1px solid var(--border-color); }
    .schedule-table tbody tr:hover { background: transparent; }
    .schedule-table td {
      display: flex; justify-content: space-between; align-items: center; gap: 1rem;
      padding: 0.3rem 0; border: 0; font-size: 0.9rem; text-align: right;
    }
    .schedule-table td::before {
      content: attr(data-label);
      font-family: var(--font-mono); font-size: 0.72rem; font-weight: 700;
      letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-secondary);
      text-align: left; flex-shrink: 0;
    }
    .schedule-table td:first-child { font-weight: 800; }
  }

  .schedule-table tbody tr:last-child td { border-bottom: none; }
  .schedule-table tbody tr:hover { background: var(--bg-muted); }
  .schedule-note { margin-top: 1rem; font-size: 0.9rem; color: var(--text-secondary); }
  @media (max-width: 640px) {
    .schedule-table th, .schedule-table td { padding: 0.75rem; font-size: 0.85rem; }
  }

  /* ===== FAQ — one ink card, hairline-divided items (as on the other
     subject pages) ===== */
  .faq-section {
    padding: 1.25rem 0;
    background: var(--bg-secondary);
    scroll-margin-top: calc(var(--nav-offset) + 48px);
  }
  .faq-list {
    max-width: 50rem; /* 800px at the 16px root */
    margin: 0 auto;
    background: var(--bg-card);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-md);
    padding: 0.25rem 1.25rem;
  }
  .faq-item {
    border-bottom: 1px solid var(--border-color);
    padding: 0.85rem 0;
  }
  .faq-item:last-child {
    border-bottom: none;
  }
  .faq-question {
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--text-primary);
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    min-height: 44px;
    touch-action: manipulation;
    transition: color var(--transition-fast);
  }
  .faq-question::-webkit-details-marker { display: none; }
  .faq-question:hover,
  .faq-item[open] .faq-question {
    color: var(--color-accent-text);
  }
  .faq-question::after {
    content: '+';
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--color-accent-text);
    flex-shrink: 0;
    transition: transform var(--transition-fast);
  }
  .faq-item[open] .faq-question::after {
    content: '\2212';
  }
  .faq-answer {
    padding-top: 0.5rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }
  .faq-answer p {
    margin: 0;
  }

  /* ===== RECOMMENDED READING ===== */
  .recommended-reading {
    padding: 1.25rem 0;
  }
  .reading-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }
  .reading-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    background: var(--bg-card);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
    text-decoration: none;
    transition: transform 0.22s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.22s ease;
  }
  .reading-card:hover .reading-card-arrow {
    transform: translateX(4px);
  }
  .reading-card-arrow {
    transition: transform var(--transition-fast);
  }
  .reading-card h3 {
    color: var(--text-primary);
    font-size: 0.95rem;
    margin: 0;
    font-weight: 800;
  }
  .reading-card-arrow {
    color: var(--color-accent-text);
    font-size: 1.2rem;
    font-weight: 800;
    flex-shrink: 0;
    margin-left: 1rem;
  }

  /* ===== SUBJECT TESTIMONIALS — ink cards with a subject-coloured spine ===== */
  .subject-testimonials {
    padding: 1.25rem 0;
  }
  .subject-testimonial-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1rem;
  }
  .subject-quote {
    background: var(--bg-card);
    border: 2px solid var(--color-ink);
    border-left: 6px solid var(--subject-accent);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    margin: 0;
    position: relative;
    overflow: hidden;
  }
  .subject-quote::before {
    content: '\201C';
    position: absolute;
    top: -1rem;
    right: 0.75rem;
    font-family: var(--font-heading);
    font-size: 4.5rem;
    font-weight: 900;
    line-height: 1;
    color: var(--subject-accent);
    opacity: 0.35;
    pointer-events: none;
  }
  .subject-quote > * {
    position: relative;
    z-index: 1;
  }
  .subject-quote p {
    color: var(--text-primary);
    font-style: italic;
    line-height: 1.6;
    margin: 0 0 0.75rem;
  }
  .subject-quote cite {
    color: var(--text-secondary);
    font-size: 0.85rem;
    font-style: normal;
    font-weight: 700;
  }

  /* ===== SUBJECT RECEIPTS — coloured stat dots before the big numbers ===== */
  .subject-receipts dt .stat-dot { width: 12px; height: 12px; margin-right: 0.55rem; vertical-align: 0.38em; }
  /* Five stats on one desktop row, left-aligned with the section eyebrow and
     heading. The shared rail in global.css is a centred 960px box on a
     3-column grid, which pushed the band ~70px right of the heading and left a
     conspicuous empty third cell in row 2. Still 2-up on phones (the sitewide
     stats rule), with the odd fifth stat spanning the row. */
  .subject-receipts-section .subject-receipts { max-width: none; margin-inline: 0; }
  /* Explicit tracks, not auto-fit: auto-fit(170px) fitted four columns at
     820–1040px and orphaned "500+" alone on a second row (iPad landscape,
     landscape phones). Tablets get an even 3 + 2; five across from 900px. */
  .subject-receipts-section .subject-receipts dl { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
  @media (min-width: 900px) {
    .subject-receipts-section .subject-receipts dl { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  }
  .subject-receipts-section .subject-receipts dt { font-size: clamp(2rem, 3.3vw, 3rem); }
  @media (max-width: 720px) {
    .subject-receipts-section .subject-receipts dl { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem 1.25rem; }
    .subject-receipts-section .subject-receipts dt { font-size: clamp(1.9rem, 7vw, 2.4rem); }
    .subject-receipts-section .subject-receipts dl > div:last-child { grid-column: 1 / -1; }
  }

  /* ===== ORAL COMMUNICATION ===== */
  .oral-quickref {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }
  .oral-peel {
    background: var(--bg-card);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    justify-content: center;
  }
  .oral-peel__label { font-family: var(--prog-mono); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-secondary); }
  .oral-peel__chips { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; }
  .oral-peel__chip { font-size: 0.85rem; font-weight: 700; padding: 0.3rem 0.7rem; border-radius: var(--radius-pill); background: var(--tint-blue-bg); border: 1.5px solid var(--subject-accent); color: var(--text-primary); }
  .oral-peel__chip strong { color: var(--subject-accent-text); font-weight: 900; }
  .oral-peel__arrow { color: var(--text-muted); font-size: 0.8rem; }

  .oral-types { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  .oral-type { background: var(--bg-card); border: 2px solid var(--color-ink); border-radius: var(--radius-sm); padding: 0.9rem 1rem; display: flex; flex-direction: column; gap: 0.25rem; }
  .oral-type__tag { font-size: 0.85rem; font-weight: 800; color: var(--subject-accent-text); }
  .oral-type__prompt { font-size: 0.82rem; color: var(--text-muted); font-style: italic; }
  .oral-type__desc { font-size: 0.86rem; color: var(--text-secondary); line-height: 1.5; }

  .oral-anatomy { margin-bottom: 2.5rem; }
  .oral-anatomy__head { margin-bottom: 1.25rem; }
  .oral-anatomy__label { display: block; font-family: var(--prog-mono); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-secondary); margin-bottom: 0.4rem; }
  .oral-anatomy__prompt { font-size: 1rem; font-weight: 700; color: var(--text-primary); margin: 0; }
  .oral-anatomy__meta { display: inline-block; margin-left: 0.5rem; font-size: 0.78rem; font-weight: 400; color: var(--text-muted); font-style: normal; }
  .oral-anatomy__note { margin-top: 0.75rem; font-size: 0.85rem; color: var(--text-muted); font-style: italic; }

  .oral-row {
    display: grid;
    grid-template-columns: 130px 1fr 1fr;
    gap: 1rem;
    align-items: start;
    padding: 0.9rem 0;
    border-top: 2px dashed var(--ink-faint);
  }
  .oral-row:first-of-type { border-top: none; }
  .oral-row__stage { display: flex; flex-direction: column; gap: 0.35rem; }
  .oral-row__badge { align-self: flex-start; }
  .oral-row__label { font-size: 0.78rem; color: var(--text-muted); }
  .oral-row__text { font-size: 0.94rem; line-height: 1.6; color: var(--text-primary); margin: 0; }
  .oral-row__why { font-size: 0.86rem; line-height: 1.55; color: var(--text-secondary); margin: 0; }
  .oral-row__why-tag { display: block; font-family: var(--prog-mono); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.25rem; }

  .oral-spheres { margin-bottom: 2rem; }
  .oral-spheres__head { margin-bottom: 1.1rem; }
  .oral-spheres__label { display: block; font-family: var(--prog-mono); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-secondary); margin-bottom: 0.4rem; }
  .oral-spheres__prompt { font-size: 1rem; font-weight: 700; color: var(--text-primary); margin: 0 0 0.4rem; }
  .oral-spheres__sub { font-size: 0.88rem; color: var(--text-secondary); margin: 0; }
  .oral-spheres__chain { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.75rem; }
  .oral-sphere { background: var(--bg-card); border: 2px solid var(--color-ink); border-radius: var(--radius-sm); padding: 0.85rem 0.8rem; position: relative; }
  .oral-sphere::after {
    content: '→';
    position: absolute;
    right: -0.85rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
    font-size: 0.9rem;
    font-weight: 800;
  }
  .oral-sphere:last-child::after { content: none; }
  .oral-sphere__name { display: block; font-size: 0.82rem; font-weight: 800; color: var(--subject-accent-text); margin-bottom: 0.35rem; }
  .oral-sphere__line { font-size: 0.8rem; line-height: 1.5; color: var(--text-secondary); margin: 0; }

  .oral-tip { display: flex; flex-direction: column; gap: 0.35rem; background: var(--bg-muted); border: 2px solid var(--color-ink); border-left: 6px solid var(--color-accent); border-radius: var(--radius-sm); padding: 0.9rem 1.1rem; }
  .oral-tip__tag { font-family: var(--prog-mono); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; color: var(--color-accent-text); }
  .oral-tip p { font-size: 0.9rem; line-height: 1.6; color: var(--text-secondary); margin: 0; }

  /* Inside the exam (PEEL Model Answer Scheme) */
  .oral-exam { margin: 1.75rem 0; border: 2px solid var(--color-ink); border-radius: var(--radius-md); background: var(--bg-card); padding: 1.25rem 1.4rem; }
  .oral-exam__label { font-family: var(--prog-mono); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; color: var(--text-secondary); }
  .oral-exam__facts { font-size: 0.92rem; line-height: 1.6; color: var(--text-secondary); margin: 0.4rem 0 1rem; }
  .oral-exam__facts strong { color: var(--text-primary); }
  .oral-exam__parts { display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem; margin-bottom: 1rem; }
  .oral-part { border: 2px solid var(--color-ink); border-radius: var(--radius-sm); padding: 0.9rem 1rem; background: var(--bg-muted); }
  .oral-part__tag { margin-bottom: 0.45rem; }
  .oral-part__name { display: block; font-weight: 800; color: var(--text-primary); font-size: 0.98rem; }
  .oral-part__marks { display: block; font-size: 0.76rem; color: var(--text-muted); margin: 0.1rem 0 0.4rem; }
  .oral-part__desc { font-size: 0.88rem; line-height: 1.55; color: var(--text-secondary); margin: 0; }
  .oral-band { border-top: 2px dashed var(--ink-faint); padding-top: 0.9rem; }
  .oral-band__tag { display: block; font-family: var(--prog-mono); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; color: var(--text-secondary); margin-bottom: 0.3rem; }
  .oral-band p { font-size: 0.92rem; line-height: 1.6; color: var(--text-secondary); margin: 0; }
  .oral-band strong { color: var(--text-primary); }

  /* Part 2 exchange */
  .oral-exchange { margin: 0 0 1.25rem; border: 2px solid var(--color-ink); border-radius: var(--radius-md); padding: 1.25rem 1.4rem; background: var(--bg-card); }
  .oral-exchange__label { font-family: var(--prog-mono); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; color: var(--text-secondary); }
  .oral-exchange__prompt { font-size: 1.02rem; font-weight: 700; color: var(--text-primary); margin: 0.35rem 0 1rem; }
  .oral-exchange__meta { display: block; font-size: 0.76rem; font-weight: 400; color: var(--text-muted); margin-top: 0.2rem; }
  .oral-exchange__row { display: flex; gap: 0.8rem; align-items: flex-start; padding: 0.55rem 0; border-top: 2px dashed var(--ink-faint); }
  .oral-exchange__badge { flex-shrink: 0; width: 32px; height: 32px; display: grid; place-items: center; border-radius: 50%; background: var(--tint-blue-bg); border: 2px solid var(--subject-accent); color: var(--subject-accent-text); font-weight: 900; font-size: 0.85rem; }
  .oral-exchange__stage { display: block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); margin-bottom: 0.15rem; }
  .oral-exchange__text { font-size: 0.92rem; line-height: 1.6; color: var(--text-secondary); margin: 0; }
  .oral-exchange__note { margin: 0.75rem 0 0; padding-top: 0.75rem; border-top: 2px dashed var(--ink-faint); font-size: 0.85rem; line-height: 1.55; color: var(--text-muted); }

  .oral-band__quote { margin-top: 0.75rem !important; padding: 0.7rem 0.9rem; background: var(--bg-muted); border: 2px solid var(--color-ink); border-radius: var(--radius-sm); font-size: 0.88rem; font-style: italic; }
  .oral-band__quote-tag { display: block; font-family: var(--prog-mono); font-style: normal; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.25rem; }

  /* Part 1 planned speech, mapped */
  .oral-planned { margin: 0 0 1.25rem; border: 2px solid var(--color-ink); border-radius: var(--radius-md); padding: 1.25rem 1.4rem; background: var(--bg-card); }
  .oral-planned__label { font-family: var(--prog-mono); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; color: var(--text-secondary); }
  .oral-planned__prompt { font-size: 1.02rem; font-weight: 700; color: var(--text-primary); margin: 0.35rem 0 1rem; }
  .oral-planned__meta { display: block; font-size: 0.76rem; font-weight: 400; color: var(--text-muted); margin-top: 0.2rem; }
  .oral-planned__flow { display: grid; gap: 0.55rem; }
  .oral-planned__step { display: grid; grid-template-columns: 150px 1fr; gap: 0.8rem; align-items: start; padding: 0.55rem 0; border-top: 2px dashed var(--ink-faint); }
  .oral-planned__stage { font-family: var(--prog-mono); font-size: 0.75rem; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; color: var(--subject-accent-text); padding-top: 0.2rem; }
  .oral-planned__text { font-size: 0.92rem; line-height: 1.6; color: var(--text-secondary); margin: 0; }
  .oral-planned__note { margin: 0.75rem 0 0; padding-top: 0.75rem; border-top: 2px dashed var(--ink-faint); font-size: 0.85rem; line-height: 1.55; color: var(--text-muted); }

  .oral-exchange__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.4rem; }
  .oral-exchange__q { font-size: 0.95rem; font-weight: 800; color: var(--text-primary); margin: 0 0 0.4rem; }

  .oral-sets { margin: 0 0 0.9rem; }
  .oral-sets__label { display: block; font-family: var(--prog-mono); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; color: var(--text-secondary); margin-bottom: 0.45rem; }
  .oral-sets__chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .oral-sets__chip { font-size: 0.82rem; font-weight: 700; color: var(--text-primary); background: var(--tint-blue-bg); border: 1.5px solid var(--subject-accent); border-radius: var(--radius-pill); padding: 0.3rem 0.8rem; }
  .oral-sets__chip strong { color: var(--subject-accent-text); font-weight: 900; margin-right: 0.25rem; }

  .oral-source { font-size: 0.85rem; line-height: 1.6; color: var(--text-muted); margin: 0 0 1.25rem; }
  .oral-source strong { color: var(--text-secondary); }

  /* Scheme page gallery (mirrors the H2 Economics notes gallery) */
  .oral-pages { margin: 0 0 1.25rem; }
  .oral-pages__label { font-family: var(--prog-mono); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; color: var(--text-secondary); }
  .oral-pages__sub { font-size: 0.92rem; line-height: 1.6; color: var(--text-secondary); margin: 0.35rem 0 1rem; max-width: 680px; }
  .notes-gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .notes-gallery--two { grid-template-columns: repeat(2, 1fr); }
  .notes-shot {
    display: flex; flex-direction: column; padding: 0; border: 2px solid var(--color-ink); border-radius: var(--radius-md);
    background: var(--bg-card); overflow: hidden; cursor: zoom-in; text-align: left; font: inherit; color: inherit;
    transition: transform 0.22s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.22s ease;
  }
  @media (hover: hover) {
    .notes-shot:hover { transform: translateY(-2px); box-shadow: 0 6px 0 var(--ink-shadow), 0 12px 24px rgba(70, 50, 20, 0.10); }
  }
  .notes-shot:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 3px; }
  .notes-shot:active { transform: translateY(1px); box-shadow: 0 2px 0 var(--ink-shadow); }
  .notes-shot img { display: block; width: 100%; height: auto; border-bottom: 2px solid var(--color-ink); }
  /* The materials gallery mixes tall page scans with wide framework cards, so
     its rows ran ragged (one thumbnail ~5x its neighbour, leaving voids in the
     band). Cap the tall scans — anchored to the top, and the full page is one
     click away in the lightbox — and let the grid's default stretch square the
     rows up. The wide cards are below the cap, so their titles are never cut;
     a fixed aspect-ratio crop would have sliced them off. */
  .notes-gallery--mixed .notes-shot img { max-height: 300px; object-fit: cover; object-position: top center; }
  .notes-shot__cap { padding: 0.7rem 0.9rem; font-size: 0.85rem; font-weight: 700; line-height: 1.4; color: var(--text-secondary); }

  .notes-lightbox {
    position: fixed; inset: 0; z-index: var(--z-modal); display: none; align-items: center; justify-content: center;
    padding: 2rem; background: rgba(28, 27, 25, 0.88);
  }
  .notes-lightbox.is-open { display: flex; }
  .notes-lightbox__img { max-width: min(92vw, 720px); max-height: 88vh; width: auto; height: auto; border-radius: var(--radius-sm); border: 2px solid #fff; box-shadow: 0 30px 70px -20px rgba(0, 0, 0, 0.6); }
  .notes-lightbox__close {
    position: absolute; top: 1.25rem; right: 1.25rem; width: 44px; height: 44px; border-radius: 50%;
    border: 2px solid #fff; background: var(--color-accent); color: #fff;
    font-size: 1.4rem; line-height: 1; cursor: pointer; display: grid; place-items: center;
  }
  .notes-lightbox__close:hover { background: var(--color-accent-hover); }

  /* SHARP playbook matrix — page-level ink outline on the shared component.
     playbook.css floors its tracks at 180px + 5 x 140px (890px with gaps), but
     the matrix is only 817–876px wide at 901–1039px (iPad landscape
     included), so the overflow:hidden card cut the Practise column off.
     Zero-floor tracks keep the same 1.4 : 1 split and simply share the width. */
  @media (min-width: 901px) {
    .playbook-matrix { border: 2px solid var(--color-ink); grid-template-columns: minmax(0, 1.4fr) repeat(5, minmax(0, 1fr)); }
  }
  .playbook-matrix__col-label, .playbook-matrix__step { font-weight: 700; font-size: 0.72rem; letter-spacing: 0.08em; }
  /* Light mode: header chrome is the ink navy (dark mode keeps playbook.css's light-accent flip) */
