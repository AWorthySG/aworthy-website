      </div>
      <details class="prog-more">
        <summary class="btn btn--sm prog-more__toggle"><span class="prog-more__show">Show the full annotated model answer</span><span class="prog-more__hide">Hide the full annotated model answer</span></summary>
      <div class="oral-anatomy">
        <div class="oral-anatomy__head">
          <span class="oral-anatomy__label">Anatomy of a Position answer</span>
          <p class="oral-anatomy__prompt">&ldquo;Should we have such street hawkers in Singapore? Why or why not?&rdquo; <span class="oral-anatomy__meta">2024 &middot; ~2 min 30s spoken</span></p>
        </div>
        {oralAnatomy.map((row) => (
          <div class="oral-row">
            <div class="oral-row__stage">
              <span class="oral-row__badge chip chip--blue">{row.stage}</span>
