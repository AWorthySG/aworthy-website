---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<BaseLayout title="Contact & Free Assessment | A-Worthy Singapore" description="Free assessment for O-Level English or Maths, Pre-IB Maths, GP or Economics: a written report on your child's latest test or exam. Groups of up to 6.">
  <Header slot="header" />

  <!-- ===== HERO ===== -->
  <section class="contact-hero">
    <div class="container">
      <p class="eyebrow">Contact</p>
      <h1>Get a <span class="accent-word">free</span> assessment</h1>
      <p class="contact-hero__subtitle">Send us a few details and Jeremy will WhatsApp you within 24 hours. The assessment is a written feedback report on your child&rsquo;s latest test or exam: where the marks were lost, and why. It reaches you within 48 hours of sending the paper. If it&rsquo;s urgent, call <a href="tel:+6589913181">+65 8991 3181</a>.</p>
    </div>
  </section>

  <!-- ===== TWO-COLUMN: FORM + INFO ===== -->
  <section class="section contact-section">
    <div class="container contact-grid">

      <!-- Enquiry Form -->
      <div class="contact-form-col" data-animate="reveal-left">
        <div class="contact-form-col__head">
          <div>
            <p class="eyebrow">Enquiry form</p>
            <h2 class="contact-form-col__heading squiggle">Tell us about your child</h2>
          </div>
          <img src="/images/mascots/mascot-heart-alt.webp" alt="" width="278" height="406" class="contact-form-col__mascot sticker sticker--right" />
        </div>

        <form id="contact-form" class="contact-form" action="https://formspree.io/f/xgoppwye" method="POST" novalidate data-lead-form data-track="contact-form">
          <!-- Honeypot — hidden from real users, catches bots -->
          <div class="form-hp" aria-hidden="true" tabindex="-1">
            <label for="website">Website</label>
            <input type="text" name="_gotcha" id="website" tabindex="-1" autocomplete="off" />
          </div>
          <input type="hidden" name="_subject" value="Contact form enquiry" />

          <div class="form-row">
            <div class="form-group">
              <label for="parent-name">What should we call you? <span class="required">*</span></label>
              <input type="text" id="parent-name" name="parentName" required autocomplete="name" aria-describedby="form-errors" placeholder="e.g. Sarah" />
            </div>
            <div class="form-group">
              <label for="phone">WhatsApp or phone number <span class="required">*</span></label>
              <input type="tel" id="phone" name="phone" required autocomplete="tel" aria-describedby="form-errors" placeholder="+65 9123 4567" />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="student-level">What level is your child in? <span class="required">*</span></label>
              <select id="student-level" name="studentLevel" required aria-describedby="form-errors">
                <option value="">Choose a level</option>
                <option value="Sec 1">Sec 1</option>
                <option value="Sec 2">Sec 2</option>
                <option value="Sec 3">Sec 3</option>
                <option value="Sec 4">Sec 4</option>
                <option value="Year 3 (IB)">Year 3 (IB)</option>
                <option value="Year 4 (IB)">Year 4 (IB)</option>
                <option value="JC 1">JC 1</option>
                <option value="JC 2">JC 2</option>
              </select>
            </div>
            <div class="form-group">
              <label for="email">Email <span class="optional">(optional)</span></label>
              <input type="email" id="email" name="email" autocomplete="email" aria-describedby="form-errors" placeholder="e.g. sarah@gmail.com" />
            </div>
          </div>

          <fieldset class="form-group form-fieldset" id="subjects-fieldset" aria-describedby="form-errors">
            <legend>Which subject(s)? <span class="required">*</span></legend>
            <div class="checkbox-group">
              <label class="check-label"><input type="checkbox" name="subjects" value="O-Level English (Sec 1-4)" data-key="english" data-name="O-Level English" /><span class="check-box" aria-hidden="true"></span><span>O-Level English (Sec 1&ndash;4)</span></label>
              <label class="check-label"><input type="checkbox" name="subjects" value="O-Level Mathematics (Sec 1-4)" data-key="maths" data-name="O-Level Mathematics" /><span class="check-box" aria-hidden="true"></span><span>O-Level Mathematics (Sec 1&ndash;4)</span></label>
              <label class="check-label"><input type="checkbox" name="subjects" value="Pre-IB Mathematics (Year 3-4)" data-key="preib" data-name="Pre-IB Mathematics" /><span class="check-box" aria-hidden="true"></span><span>Pre-IB Mathematics (Year 3&ndash;4)</span></label>
              <label class="check-label"><input type="checkbox" name="subjects" value="H1 General Paper (JC)" data-key="gp" data-name="H1 General Paper" /><span class="check-box" aria-hidden="true"></span><span>H1 General Paper (JC)</span></label>
              <label class="check-label"><input type="checkbox" name="subjects" value="H2 Economics (JC)" data-key="econ" data-name="H2 Economics" /><span class="check-box" aria-hidden="true"></span><span>H2 Economics (JC)</span></label>
              <label class="check-label"><input type="checkbox" name="subjects" value="One-to-one coaching" data-key="coaching" data-name="One-to-one coaching" /><span class="check-box" aria-hidden="true"></span><span>One-to-one coaching</span></label>
            </div>
          </fieldset>

          <details class="form-more">
            <summary class="form-more__summary">More details (optional)</summary>
            <div class="form-more__body">
              <div class="form-row">
                <div class="form-group">
                  <label for="student-name">Your child&rsquo;s name</label>
                  <input type="text" id="student-name" name="studentName" autocomplete="off" placeholder="e.g. Ethan" />
                </div>
                <div class="form-group">
                  <label for="referral">How did you find us?</label>
                  <select id="referral" name="referral">
                    <option value="">Choose one</option>
                    <option value="Google search">Google search</option>
                    <option value="Instagram">Instagram</option>
                    <option value="TikTok">TikTok</option>
                    <option value="Facebook">Facebook</option>
                    <option value="Online advert">Online advert</option>
                    <option value="Friend or family">Friend or family</option>
                    <option value="School or teacher">School or teacher</option>
                    <option value="Other">Other</option>
                  </select>
                </div>
              </div>
              <div class="form-group">
                <label for="message">Anything else?</label>
                <textarea id="message" name="message" rows="5" placeholder="For example, the topic your child finds hardest, or the grade they’re aiming for"></textarea>
              </div>
            </div>
          </details>

          <button type="submit" id="form-submit-btn" class="btn btn-accent btn-submit"><span>Get a Free Report</span></button>

          <div id="form-success" class="form-success" role="status" tabindex="-1" hidden>
            <p class="form-success__text">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
              <span>Thank you, we&rsquo;ve got your details. Jeremy will WhatsApp you within 24 hours. For the free assessment, please send a photo of your child&rsquo;s latest test or exam paper, and he&rsquo;ll send you a written feedback report on what went wrong within 48 hours. If it&rsquo;s urgent, call him on <a href="tel:+6589913181">+65 8991 3181</a>.</span>
            </p>
            <a id="form-success-wa" class="btn btn-whatsapp form-success__wa" href="https://wa.me/6589913181" target="_blank" rel="noopener noreferrer"><svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>Send on WhatsApp</a>
          </div>
          <div id="form-errors" class="form-errors" role="alert" hidden></div>
        </form>
      </div>

      <!-- Contact Information -->
      <div class="contact-info-col" data-animate="reveal-right">
        <p class="eyebrow">Contact details</p>
        <h2 class="contact-info-col__heading squiggle">How to reach us</h2>

        <div class="info-card">
          <div class="info-card__icon icon-circle icon-circle--blue">
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
          </div>
          <div>
            <h3>Online lessons</h3>
            <p>Live on the A-Worthy Whiteboard, from home.</p>
          </div>
        </div>

        <div class="info-card">
          <div class="info-card__icon icon-circle icon-circle--green">
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6A19.79 19.79 0 012.12 4.18 2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.362 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
          </div>
          <div>
            <h3>Reach us</h3>
            <ul class="contact-details">
              <li><strong>Phone:</strong> <a href="tel:+6589913181">+65 8991 3181</a></li>
              <li><strong>WhatsApp:</strong> <a href="https://wa.me/6589913181">+65 8991 3181</a></li>
              <li><strong>Email:</strong> <a href="mailto:jeremy@a-worthy.com">jeremy@a-worthy.com</a></li>
            </ul>
          </div>
        </div>

        <div class="info-card">
          <div class="info-card__icon icon-circle icon-circle--gold">
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <div>
            <h3>Opening hours</h3>
            <ul class="contact-details">
              <li><strong>Mon&ndash;Fri:</strong> 2:00 PM &ndash; 9:30 PM</li>
              <li><strong>Sat&ndash;Sun:</strong> 9:00 AM &ndash; 6:00 PM</li>
            </ul>
          </div>
        </div>

        <div class="online-badge">
          <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
          <div>
            <strong>Fully online</strong>
            <span>No commuting. Students join from anywhere in Singapore.</span>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ===== HOW TO ENROL ===== -->
  <section class="section enrol-section">
    <div class="container">
      <img src="/images/mascots/mascot-on-my-way.webp" alt="" width="415" height="480" class="enrol-mascot sticker" loading="lazy" />
      <p class="eyebrow">How to enrol</p>
      <h2 class="enrol-heading squiggle squiggle--center" data-animate="reveal-up">Three steps to get started</h2>

      <div class="enrol-timeline" data-animate="reveal-up">
        <div class="enrol-step">
          <div class="enrol-step-num">1</div>
          <div class="enrol-step-content">
            <h3>Send the form or WhatsApp us</h3>
            <p>Tell us your child&rsquo;s level and subject. Jeremy replies on WhatsApp within 24 hours.</p>
          </div>
        </div>
        <div class="enrol-step">
          <div class="enrol-step-num">2</div>
          <div class="enrol-step-content">
            <h3>Send a recent test or exam</h3>
            <p>WhatsApp a photo of each page to +65 8991 3181, so Jeremy can see your child&rsquo;s actual answers.</p>
          </div>
        </div>
        <div class="enrol-step">
          <div class="enrol-step-num">3</div>
          <div class="enrol-step-content">
            <h3>Get a written report</h3>
            <p>Within 48 hours, Jeremy sends you a report on where the marks were lost and why, with the class we&rsquo;d recommend: a group of up to 6, or one-to-one. It&rsquo;s your call: no obligation, no sales pitch.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== FAQ ACCORDION ===== -->
  <section class="section faq-section">
    <div class="container">
      <div class="faq-header">
        <p class="eyebrow">FAQ</p>
        <h2 class="squiggle squiggle--center">Frequently asked questions</h2>
        <p class="faq-header__subtitle">Class size, missed lessons, fees and holds.</p>
      </div>

      <div class="faq-list">
        <div class="faq-item" data-animate="reveal-up" data-animate-delay="1">
          <button class="faq-question" aria-expanded="false">
            <span>How big are the classes?</span>
            <span class="faq-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </button>
          <div class="faq-answer" hidden>
            <p>Six at most, so the tutor can comment on every student&rsquo;s answer in the lesson.</p>
          </div>
        </div>

        <div class="faq-item" data-animate="reveal-up" data-animate-delay="2">
          <button class="faq-question" aria-expanded="false">
            <span>Is there a free trial lesson?</span>
            <span class="faq-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </button>
          <div class="faq-answer" hidden>
            <p>No. Instead, you get a free assessment: a written feedback report on your child&rsquo;s latest test or exam, sent within 48 hours. If you enrol, the first month of lessons is covered by our first-month money-back guarantee.</p>
          </div>
        </div>

        <div class="faq-item" data-animate="reveal-up" data-animate-delay="3">
          <button class="faq-question" aria-expanded="false">
            <span>What if my child misses a lesson?</span>
            <span class="faq-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </button>
          <div class="faq-answer" hidden>
            <p>Every lesson is recorded. The recording, worksheet and homework reach your child within 24 hours. There are no make-up classes.</p>
          </div>
        </div>

        <div class="faq-item" data-animate="reveal-up" data-animate-delay="4">
          <button class="faq-question" aria-expanded="false">
            <span>What curriculum do you follow?</span>
            <span class="faq-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </button>
          <div class="faq-answer" hidden>
            <p>The current MOE/Cambridge syllabuses: O-Level English (1184), O-Level Mathematics (4052), H1 General Paper (8881) and H2 Economics (9570), taught with our own SHARP Method.</p>
          </div>
        </div>

        <div class="faq-item" data-animate="reveal-up" data-animate-delay="5">
          <button class="faq-question" aria-expanded="false">
            <span>How do I pay?</span>
            <span class="faq-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </button>
          <div class="faq-answer" hidden>
            <p>In advance, by the 1st of each month, by PayNow (preferred), bank transfer or credit card via HitPay. The fee is fixed, so a month with a fifth lesson costs the same. Lessons carry on through the school holidays and on public holidays. Missed lessons get the recording, not a make-up class. Sec 4 and JC 2 groups end after the national examinations, and there&rsquo;s no fee for the months after your child&rsquo;s last paper. To stop, give one month&rsquo;s notice.</p>
          </div>
        </div>
        <div class="faq-item" data-animate="reveal-up" data-animate-delay="6">
          <button class="faq-question" aria-expanded="false">
            <span>What if my child is away for a few weeks?</span>
            <span class="faq-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </button>
          <div class="faq-answer" hidden>
            <p>Once a calendar year, you can hold your child&rsquo;s place for up to four weeks in a row, for travel or any other reason. Tell us in writing (WhatsApp or email) at least two weeks before the first lesson your child will miss. There&rsquo;s no fee for the weeks on hold, and your child keeps their place in the group.</p>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            <span>What does a normal week look like?</span>
            <span class="faq-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </button>
          <div class="faq-answer" hidden>
            <p>One 90-minute live lesson with the same tutor. Your child gets written feedback every week and can WhatsApp questions between lessons. You get a monthly progress report by email.</p>
          </div>
        </div>
      </div>
      <p class="reading-nudge">Still deciding? Two honest guides: <a href="/blog/does-my-child-need-tuition/">Does My Child Actually Need Tuition?</a> and <a href="/blog/how-to-choose-a-tuition-centre-singapore/">How to Choose a Tuition Centre in Singapore</a>.</p>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section class="section cta-section">
    <div class="container cta-inner">
      <p class="eyebrow">Prefer WhatsApp?</p>
      <h2 class="squiggle squiggle--center" data-animate="reveal-up">Just message us</h2>
      <p class="cta-subtitle">Send your child&rsquo;s level and subject. Jeremy replies within 24 hours.</p>
      <a href="https://wa.me/6589913181?text=Hi%2C%20I%27d%20like%20a%20free%20assessment%20for%20my%20child." class="btn btn-accent" target="_blank" rel="noopener noreferrer">
        <span>
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="vertical-align: middle; margin-right: 0.5rem;"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Chat on WhatsApp
        </span>
      </a>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<!-- ===== CLIENT-SIDE SCRIPTS ===== -->
<script>
  // --- Form Validation & Submission ---
  // The lead event fires only when Formspree answers OK. After a send the
  // button stays disabled and a pre-filled WhatsApp button asks for the marked
  // paper. Works with or without the sitewide helpers (aworthyWaRef,
  // aworthyAttachAttribution, plausible).
  const w = window as any;
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successMsg = document.getElementById('form-success') as HTMLDivElement;
  const successWa = document.getElementById('form-success-wa') as HTMLAnchorElement;
  const errorsMsg = document.getElementById('form-errors') as HTMLDivElement;
  const submitBtn = document.getElementById('form-submit-btn') as HTMLButtonElement;
  const subjectBoxes = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="subjects"]'));
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  function waHref(text: string): string {
    let ref = 'WEB';
    try { if (typeof w.aworthyWaRef === 'function') ref = w.aworthyWaRef() || 'WEB'; } catch { /* keep WEB */ }
    return 'https://wa.me/6589913181?text=' + encodeURIComponent(text + ' [ref: ' + ref + ']');
  }

  // scroll: false when focus has already moved to the first missing field
  function showErrors(nodes: HTMLElement[], scroll = true) {
    errorsMsg.textContent = '';
    nodes.forEach((n) => errorsMsg.appendChild(n));
    errorsMsg.hidden = false;
    successMsg.hidden = true;
    if (scroll) errorsMsg.scrollIntoView({ block: 'center' });
  }

  function para(text: string): HTMLParagraphElement {
    const p = document.createElement('p');
    p.textContent = text;
    return p;
  }

  // /contact/?subject=english|maths|preib|gp|econ ticks that subject
  // (comma-separated values tick several; unknown values are ignored).
  try {
    const wanted = (new URLSearchParams(location.search).get('subject') || '').toLowerCase().split(',').map((v) => v.trim());
    subjectBoxes.forEach((box) => { if (wanted.includes(box.dataset.key || '')) box.checked = true; });
  } catch { /* no preselection */ }

  form.addEventListener('submit', async (e: Event) => {
    e.preventDefault();
    const nameInput = form.querySelector('#parent-name') as HTMLInputElement;
    const emailInput = form.querySelector('#email') as HTMLInputElement;
    const phoneInput = form.querySelector('#phone') as HTMLInputElement;
    const levelSelect = form.querySelector('#student-level') as HTMLSelectElement;
    const subjectsFieldset = form.querySelector('#subjects-fieldset') as HTMLFieldSetElement;
    const parentName = nameInput.value.trim();
    const email = emailInput.value.trim();
    const phone = phoneInput.value.trim();
    const studentLevel = levelSelect.value;
    const chosen = subjectBoxes.filter((b) => b.checked).map((b) => b.dataset.name || b.value);
    const digits = phone.replace(/\D/g, '');
    const phoneOk = !!phone && digits.length >= 8 && digits.length <= 15;
    const emailOk = !email || EMAIL_RE.test(email);

    // In form order, so the first one is the field the page moves to.
    const problems: [HTMLElement, string][] = [];
    if (!parentName) problems.push([nameInput, 'Please tell us what to call you.']);
    if (!phone) problems.push([phoneInput, 'Please enter your WhatsApp or phone number.']);
    else if (!phoneOk) problems.push([phoneInput, 'Please enter a valid WhatsApp or phone number.']);
    if (!studentLevel) problems.push([levelSelect, 'Please choose your child\u2019s level.']);
    if (!chosen.length) problems.push([subjectsFieldset, 'Please choose at least one subject.']);
    if (!emailOk) problems.push([emailInput, 'Please enter a valid email address, or leave the email blank.']);

    if (typeof w.aworthyFieldErrors === 'function') {
      w.aworthyFieldErrors(form, problems);
      if (problems.length) {
        showErrors([para(problems.length === 1 ? 'Please check the field above.' : 'Please check the ' + problems.length + ' fields above.')], false);
        return;
      }
    } else if (problems.length) {
      problems.forEach(([el]) => el.setAttribute('aria-invalid', 'true'));
      showErrors(problems.map(([, text]) => para(text)));
      return;
    }

    const subjectLabel = chosen.join(', ');
    (form.querySelector('[name="_subject"]') as HTMLInputElement).value = 'Contact form enquiry: ' + subjectLabel;
    if (typeof w.aworthyAttachAttribution === 'function') {
      try { w.aworthyAttachAttribution(form); } catch { /* attribution is optional */ }
    }

    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span class="spinner"></span> Sending…';

    let ok = false;
    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { 'Accept': 'application/json' },
      });
      ok = response.ok;
    } catch {
      ok = false;
    }

    if (ok) {
      if (typeof w.plausible === 'function') {
        try { w.plausible('Lead: Contact Form', { props: { subject: subjectLabel } }); } catch { /* analytics only */ }
      }
      if (w.aworthyCelebrate) w.aworthyCelebrate();
      // stays disabled: one enquiry per visit, and the WhatsApp button is the next step
      submitBtn.innerHTML = '<span>Sent</span>';
      errorsMsg.hidden = true;
      successWa.href = waHref('Hi Jeremy, I\'m ' + parentName + '. I\'ve just asked for a free assessment for my child (' + studentLevel + ', ' + subjectLabel + '). Here is the latest test or exam paper.');
      successMsg.hidden = false;
      successMsg.focus({ preventScroll: true });
      successMsg.scrollIntoView({ block: 'center' });
    } else {
      submitBtn.disabled = false;
      submitBtn.innerHTML = '<span>Get a Free Report</span>';
      const p = document.createElement('p');
      const a = document.createElement('a');
      a.href = waHref('Hi Jeremy, I\'m ' + parentName + '. I\'d like a free assessment for my child (' + studentLevel + ', ' + subjectLabel + ').');
      a.target = '_blank';
      a.rel = 'noopener noreferrer';
      a.textContent = 'send your request on WhatsApp';
      p.append('Sorry, your message didn\u2019t go through. Please try again, or ', a, '.');
      showErrors([p]);
    }
  });

  // --- FAQ Accordion (single-open) ---
  document.querySelectorAll('.faq-question').forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = btn.parentElement as HTMLDivElement;
      const answer = item.querySelector('.faq-answer') as HTMLDivElement;
      const isOpen = btn.getAttribute('aria-expanded') === 'true';

      // Close all others
      document.querySelectorAll('.faq-item').forEach((otherItem) => {
        if (otherItem !== item) {
          const otherBtn = otherItem.querySelector('.faq-question') as HTMLButtonElement;
          const otherAnswer = otherItem.querySelector('.faq-answer') as HTMLDivElement;
          otherBtn.setAttribute('aria-expanded', 'false');
          otherAnswer.hidden = true;
          otherItem.classList.remove('is-open');
        }
      });

      // Toggle current
      btn.setAttribute('aria-expanded', String(!isOpen));
      answer.hidden = isOpen;
      item.classList.toggle('is-open', !isOpen);
    });
  });
</script>

