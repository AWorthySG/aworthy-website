---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { googleWriteReviewUrl } from '../data/site-config';

const whatsappFeedback = 'https://wa.me/6589913181?text=' + encodeURIComponent('Hi A-Worthy, I have some feedback I’d like to share:');
---

<BaseLayout title="Leave a Review | A-Worthy" description={googleWriteReviewUrl ? 'Tell us how lessons with A-Worthy are going. Leave a short Google review, or send us private feedback on WhatsApp. We read every message.' : 'Tell us how lessons with A-Worthy are going. Send us a line or two on WhatsApp about what has helped and what could be better. We read every message.'} noindex={true}>
  <Header slot="header" />

  <section class="review-hero">
    <div class="container">
      <img src="/images/mascots/mascot-ok.webp" alt="" width="392" height="480" class="review-mascot sticker" />
      <span class="eyebrow">Thank you</span>
      <h1 class="review-title squiggle squiggle--center">How did we do?</h1>
      <p class="review-sub">Tell us honestly how lessons are going. It takes a minute, and your answer helps us teach your child better.</p>

      {/* The Google card shows only once googleWriteReviewUrl is set in
          src/data/site-config.ts; until then WhatsApp feedback is the main action. */}
      {googleWriteReviewUrl ? (
        <>
          <div class="review-card">
            <div class="review-stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
            <h2 class="review-card__title">Loved learning with A-Worthy?</h2>
            <p class="review-card__text">A line or two on Google, in your own words, helps the next parent decide whether we&rsquo;re right for their child.</p>
            <a href={googleWriteReviewUrl} class="btn btn-accent review-card__cta plausible-event-name=Review+Click" target="_blank" rel="noopener noreferrer">Leave a Google review</a>
          </div>

          <div class="review-alt">
            <p>Something we could do better? Tell us privately. We read every message.</p>
            <a href={whatsappFeedback} target="_blank" rel="noopener noreferrer" class="review-alt__link">Share private feedback on WhatsApp &rarr;</a>
            <span class="review-alt__or">or <a href="/contact/">send us a message</a></span>
          </div>
        </>
      ) : (
        <>
          <div class="review-card">
            <div class="review-stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
            <h2 class="review-card__title">Loved learning with A-Worthy?</h2>
            <p class="review-card__text">Tell us how your child is getting on: what has helped, and what we could do better. We read every message.</p>
            <a href={whatsappFeedback} class="btn btn-accent review-card__cta plausible-event-name=Review+Click" target="_blank" rel="noopener noreferrer">Share your feedback on WhatsApp</a>
          </div>

          <div class="review-alt">
            <span class="review-alt__or">or <a href="/contact/">send us a message</a></span>
          </div>
        </>
      )}
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .review-hero { padding: 2rem 0 3rem; text-align: center; }
  .review-mascot { width: 128px; margin: 0 auto 1rem; }
  .review-title { font-family: var(--font-heading); font-size: clamp(2.2rem, 5vw, 3.2rem); font-weight: 900; letter-spacing: -0.02em; color: var(--text-primary); margin-bottom: 0.75rem; }
  .review-sub { font-size: 1.05rem; line-height: 1.7; color: var(--text-secondary); max-width: 540px; margin: 0 auto 2rem; }
  /* Sticker card — white, 2px ink outline, hard offset shadow */
  .review-card { background: var(--bg-card); border: 2px solid var(--color-ink); border-radius: var(--radius-md); box-shadow: 0 3px 0 var(--ink-shadow); padding: 2.25rem 1.75rem; max-width: 480px; margin: 0 auto 1.5rem; }
  .review-stars { color: var(--color-sun); font-size: 1.6rem; letter-spacing: 0.15em; margin-bottom: 1rem; }
  .review-card__title { font-size: 1.4rem; font-weight: 800; letter-spacing: -0.02em; color: var(--text-primary); margin-bottom: 0.6rem; }
  .review-card__text { font-size: 0.95rem; line-height: 1.6; color: var(--text-secondary); margin-bottom: 1.5rem; }
  .review-card__cta { display: inline-flex; }
  .review-alt { max-width: 480px; margin: 0 auto; }
  .review-alt p { font-size: 0.9rem; color: var(--text-secondary); margin-bottom: 0.5rem; }
  /* inline-block so its vertical padding grows the real hit box (on an inline
     link the global coarse-pointer padding left it a 30px target) */
  .review-alt__link { display: inline-block; color: var(--color-accent-text); text-decoration: none; font-weight: 700; font-size: 0.95rem; }
  .review-alt__link:hover { text-decoration: underline; }
  .review-alt__or { display: block; margin-top: 0.4rem; font-size: 0.85rem; color: var(--text-secondary); }
  /* The fallback contact link must read as a link (WCAG 1.4.1 — not colour
     alone) and be comfortably tappable: inline-block + vertical padding grows
     the hit box; on coarse pointers it reaches the 40px floor. */
  .review-alt__or a { display: inline-block; color: var(--color-accent-text); font-weight: 700; text-decoration: underline; text-underline-offset: 0.15em; text-decoration-thickness: 1.5px; padding-block: 0.3rem; }
  @media (pointer: coarse) {
    .review-alt__or a { padding-block: 0.6rem; }
    .review-alt__link { padding-block: 0.55rem; }
  }
  /* Short centred copy: balance the lines so no paragraph ends on a lone
     word ("better.") or starts a line with a dash */
  .review-sub, .review-card__text, .review-alt p { text-wrap: balance; }
</style>
