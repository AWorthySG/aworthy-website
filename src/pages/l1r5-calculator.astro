---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const gradeOptions = [
  { v: '', label: '— Not taken —' },
  { v: 1, label: 'A1' }, { v: 2, label: 'A2' }, { v: 3, label: 'B3' },
  { v: 4, label: 'B4' }, { v: 5, label: 'C5' }, { v: 6, label: 'C6' },
  { v: 7, label: 'D7' }, { v: 8, label: 'E8' }, { v: 9, label: 'F9' },
];

const mathSci = ['Elementary Mathematics', 'Additional Mathematics', 'Physics', 'Chemistry', 'Biology', 'Combined Science'];
const humanities = ['Combined Humanities', 'Geography', 'History', 'Literature in English'];
const others = ['Mother Tongue Language', 'Principles of Accounts', 'Other subject'];
---

<BaseLayout
  title="Free L1R5 Calculator for JC Admission (2026) | A-Worthy"
  description="Free L1R5 calculator for O-Level students: work out your net aggregate, apply CCA & HMT bonus points, and see which JCs you’d qualify for."
  ogImage="/images/og-blog.png">
  <Header slot="header" />

  <section class="calc-hero">
    <div class="container">
      <span class="eyebrow">Free Tool</span>
      <h1 class="calc-title">L1R5 <span class="accent-word">Calculator</span></h1>
      <p class="calc-sub">Work out your net L1R5 aggregate in seconds, apply your CCA and Higher Mother Tongue bonus points, and see which junior colleges you&rsquo;d qualify for under the 2026 cut-off points. Built by A-Worthy&rsquo;s Singapore tutors.</p>
    </div>
    <img src="/images/mascots/mascot-cheer.webp" alt="" width="455" height="508" class="sticker sticker--hero" />
  </section>

  <section class="section calc-section">
    <div class="container calc-grid">
      <form class="calc-card" id="l1r5-form" novalidate>
        <div class="calc-l1">
          <label class="calc-row calc-row--l1">
            <span class="calc-subject">English Language <em>(L1)</em></span>
            <select class="calc-select" data-cat="english" aria-label="English Language grade">
              {gradeOptions.map(o => <option value={o.v}>{o.label}</option>)}
            </select>
          </label>
        </div>

        <fieldset class="calc-group">
          <legend>Mathematics &amp; Science <span>(best counts as R2)</span></legend>
          {mathSci.map(name => (
            <label class="calc-row">
              <span class="calc-subject">{name}</span>
              <select class="calc-select" data-cat="mathsci" data-name={name} aria-label={`${name} grade`}>
                {gradeOptions.map(o => <option value={o.v}>{o.label}</option>)}
              </select>
            </label>
          ))}
        </fieldset>

        <fieldset class="calc-group">
          <legend>Humanities <span>(best counts as R1)</span></legend>
          {humanities.map(name => (
            <label class="calc-row">
              <span class="calc-subject">{name}</span>
              <select class="calc-select" data-cat="humanities" data-name={name} aria-label={`${name} grade`}>
                {gradeOptions.map(o => <option value={o.v}>{o.label}</option>)}
              </select>
            </label>
          ))}
        </fieldset>

        <fieldset class="calc-group">
          <legend>Other subjects <span>(count towards R3&ndash;R5)</span></legend>
          {others.map(name => (
            <label class="calc-row">
              <span class="calc-subject">{name}</span>
              <select class="calc-select" data-cat="other" data-name={name} aria-label={`${name} grade`}>
                {gradeOptions.map(o => <option value={o.v}>{o.label}</option>)}
              </select>
            </label>
          ))}
        </fieldset>

        <fieldset class="calc-group calc-bonus">
          <legend>Bonus points <span>(deducted from your gross score)</span></legend>
          <label class="calc-check"><input type="checkbox" id="bonus-cca" /><span class="check-box" aria-hidden="true"></span><span>CCA &ldquo;A&rdquo; grade (&minus;2)</span></label>
          <label class="calc-check"><input type="checkbox" id="bonus-hmt" /><span class="check-box" aria-hidden="true"></span><span>Higher Mother Tongue D7 or better (&minus;2)</span></label>
        </fieldset>

        <div class="calc-actions">
          <button type="submit" class="btn btn-accent calc-btn">Calculate my L1R5</button>
          <button type="button" class="calc-reset" id="calc-reset">Reset</button>
        </div>
        <p class="calc-error" id="calc-error" role="alert" hidden></p>
      </form>

      <div class="calc-result" id="calc-result" aria-live="polite" hidden>
        <div class="calc-score">
          <div class="calc-score-block">
            <span class="calc-score-num"><span class="stat-dot stat-dot--blue" aria-hidden="true"></span><span id="calc-gross">&ndash;</span></span>
            <span class="calc-score-label">Gross L1R5</span>
          </div>
          <div class="calc-score-arrow">&rarr;</div>
          <div class="calc-score-block calc-score-block--net">
            <span class="calc-score-num"><span class="stat-dot stat-dot--green" aria-hidden="true"></span><span id="calc-net">&ndash;</span></span>
            <span class="calc-score-label">Net L1R5</span>
          </div>
        </div>
        <div class="calc-breakdown" id="calc-breakdown"></div>
        <h3 class="calc-jc-heading squiggle">JCs you&rsquo;d qualify for <span>(2026 JAE, indicative)</span></h3>
        <div class="calc-jc" id="calc-jc"></div>
        <p class="calc-disclaimer">Cut-off points change every year and depend on stream and choice order. This is an indicative guide only &mdash; always verify the latest figures on <a href="https://www.moe.gov.sg/schoolfinder" target="_blank" rel="noopener noreferrer">MOE SchoolFinder</a>.</p>
        <div class="calc-cta">
          <p><strong>English and Maths affect every L1R5.</strong> They&rsquo;re the two subjects every student takes &mdash; so every grade you raise there shifts your whole aggregate.</p>
          <div class="calc-cta-links">
            <a href="/contact/" class="btn btn-accent plausible-event-name=Tool+CTA+Click">Book Free Assessment</a>
            <a href="/o-level-english/" class="calc-cta-link subject--english"><span class="subject-dot" aria-hidden="true"></span>O-Level English &rarr;</a>
            <a href="/o-level-mathematics/" class="calc-cta-link subject--maths"><span class="subject-dot" aria-hidden="true"></span>O-Level Maths &rarr;</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--sand calc-explainer">
    <div class="container">
      <h2 class="section-title">How L1R5 works</h2>
      <p class="section-subtitle">L1R5 = 1 Language + 5 Relevant subjects &mdash; the aggregate of your six best grades, selected by MOE&rsquo;s rules. Each grade is worth points (A1&nbsp;=&nbsp;1 up to F9&nbsp;=&nbsp;9), so a <em>lower</em> score is better, and bonus points for CCA and Higher Mother Tongue are subtracted to give your net aggregate.</p>
      <p class="calc-explainer__note">For the full breakdown, bonus-point rules, and the complete 2026 cut-off table, read our <a href="/blog/o-level-cut-off-points-2026/">complete L1R5 &amp; cut-off points guide</a>. Already heading to JC? Plan your subjects with the <a href="/jc-subject-combinations/">JC subject combination advisor</a>, or test your exam instincts with the <a href="/sharp-decoder/">SHARP Decoder game</a>.</p>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .calc-hero { padding: 1.5rem 0 0.75rem; text-align: center; }
  .calc-title { font-family: var(--font-heading); font-size: clamp(2.2rem, 5vw, 3.2rem); font-weight: 900; color: var(--text-primary); margin-bottom: 0.75rem; }
  .calc-sub { font-size: 1.05rem; line-height: 1.7; color: var(--text-secondary); max-width: 640px; margin: 0 auto; }
  .calc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; align-items: start; }
  /* Until a result exists the lone form card sits centred instead of leaving the right column blank */
  .calc-grid:has(> .calc-result[hidden]) { grid-template-columns: minmax(0, 640px); justify-content: center; }
  /* The global sun blob (520px, top -32%) is taller than this short hero, so its dense band was clipped
     into a hard edge — span the hero's own height instead and fade the blob out before the top/bottom edges */
  section.calc-hero::before {
    top: 0; height: 100%;
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 30%, #000 70%, transparent);
    mask-image: linear-gradient(to bottom, transparent, #000 30%, #000 70%, transparent);
  }

  /* ── Form card — white sticker card with a 2px ink outline ── */
  .calc-card { background: var(--bg-card); border: 2px solid var(--color-ink); border-radius: var(--radius-md); box-shadow: 0 3px 0 var(--ink-shadow); padding: 1.5rem; }
  .calc-group { border: none; padding: 0; margin: 0 0 1.25rem; }
  .calc-group legend { font-weight: 700; color: var(--text-secondary); font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; padding: 0; margin-bottom: 0.5rem; }
  .calc-group legend span { font-weight: 600; text-transform: none; letter-spacing: 0; color: var(--text-secondary); font-size: 0.78rem; }
  .calc-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.35rem 0; margin-bottom: 0; font-weight: 400; letter-spacing: 0; }
  .calc-row--l1 { padding: 0.6rem 0.75rem; background: var(--bg-muted); border: 2px dashed var(--ink-faint); border-radius: var(--radius-sm); margin-bottom: 1.25rem; }
  .calc-subject { font-size: 0.9rem; color: var(--text-primary); font-weight: 600; }
  .calc-subject em { color: var(--color-accent-text); font-style: normal; font-weight: 800; }
  /* Selects take the global ink-outlined look and the global chevron (ink in light, cream in dark) — only size is page-scoped */
  .calc-select { min-width: 130px; width: auto; min-height: 44px; padding: 0.4rem 2.1rem 0.4rem 0.75rem; }
  .calc-bonus .calc-check { display: flex; align-items: center; gap: 0.5rem; font-size: 0.9rem; font-weight: 600; letter-spacing: 0; color: var(--text-primary); padding: 0.35rem 0; margin-bottom: 0; min-height: 44px; cursor: pointer; }
  .calc-check input { position: absolute; opacity: 0; width: 1px; height: 1px; margin: 0; }
  .calc-check .check-box { position: relative; display: inline-block; width: 1.15rem; height: 1.15rem; flex-shrink: 0; border: 2px solid var(--color-ink); border-radius: 5px; background: var(--bg-muted); transition: border-color var(--transition-fast); }
  .calc-check .check-box::after { content: ''; position: absolute; inset: -3px; background: url('/images/mascots/mascot-heart-alt-icon.webp') center / contain no-repeat; opacity: 0; transform: scale(0.5); transition: opacity var(--transition-fast), transform var(--transition-fast); }
  .calc-check input:checked ~ .check-box { border-color: var(--color-accent); }
  .calc-check input:checked ~ .check-box::after { opacity: 1; transform: scale(1); }
  .calc-check input:focus-visible ~ .check-box { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) { .calc-check .check-box::after { transition: none; } }
  .calc-actions { display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; margin-top: 0.5rem; }
  .calc-btn { cursor: pointer; }
  .calc-reset { background: none; border: none; color: var(--text-secondary); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; font-family: var(--font-body); font-size: 0.85rem; font-weight: 700; min-height: 44px; padding: 0.5rem 0.6rem; }
  .calc-reset:hover { color: var(--text-primary); }
  .calc-error { color: var(--color-accent-text); font-weight: 600; font-size: 0.85rem; margin-top: 0.75rem; }

  /* ── Result card ── */
  /* --nav-offset = header + SubjectBar (header alone ≤640px): the stuck card and the post-Calculate
     scrollIntoView both clear the fixed chrome instead of sliding under the programmes strip */
  .calc-result { background: var(--bg-card); border: 2px solid var(--color-ink); border-radius: var(--radius-md); box-shadow: 0 3px 0 var(--ink-shadow); padding: 1.5rem; position: sticky; top: calc(var(--nav-offset) + 1rem); scroll-margin-top: calc(var(--nav-offset) + 1rem); }
  .calc-score { display: flex; align-items: center; justify-content: center; gap: 1.25rem; margin-bottom: 1.25rem; }
  .calc-score-block { text-align: center; }
  .calc-score-num { display: flex; align-items: center; justify-content: center; gap: 0.1rem; font-family: var(--font-heading); font-size: 2.75rem; font-weight: 900; letter-spacing: -0.02em; color: var(--text-primary); line-height: 1; margin-bottom: 0.35rem; }
  .calc-score-num .stat-dot { width: 11px; height: 11px; }
  .calc-score-block--net .calc-score-num { color: var(--color-accent-text); }
  .calc-score-label { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-secondary); font-family: var(--font-body); }
  .calc-score-arrow { color: var(--text-tertiary); font-size: 1.5rem; }
  .calc-breakdown { font-size: 0.85rem; color: var(--text-secondary); line-height: 1.7; border-top: 2px dashed var(--ink-faint); border-bottom: 2px dashed var(--ink-faint); padding: 0.9rem 0; margin-bottom: 1rem; }
  .calc-breakdown span { display: inline-block; }
  .calc-breakdown :global(strong) { color: var(--text-primary); }
  .calc-jc-heading { font-size: 1rem; font-weight: 800; color: var(--text-primary); margin-bottom: 0.75rem; }
  .calc-jc-heading::after { width: 56px; height: 10px; margin-top: 0.3rem; }
  .calc-jc-heading span { font-weight: 600; color: var(--text-secondary); font-size: 0.8rem; }
  /* The JC list is built by the script, so its pieces are :global — green tinted chips, like the LMS */
  .calc-jc { margin-bottom: 1rem; }
  .calc-jc :global(.calc-jc) { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .calc-jc :global(.calc-jc-chip) {
    display: inline-flex; align-items: center; min-height: 32px; padding: 0.3rem 0.8rem; border-radius: var(--radius-pill);
    background: var(--tint-green-bg); color: var(--tint-green-fg); border: 1.5px solid var(--color-leaf);
    font-size: 0.78rem; font-weight: 800; letter-spacing: 0.04em; line-height: 1.2; white-space: nowrap;
  }
  .calc-jc :global(.calc-jc-none) { font-size: 0.9rem; color: var(--text-secondary); }
  .calc-disclaimer { font-size: 0.78rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 1.25rem; }
  .calc-disclaimer a { color: var(--color-accent-text); font-weight: 700; }
  .calc-cta { border-top: 2px dashed var(--ink-faint); padding-top: 1.25rem; }
  .calc-cta p { font-size: 0.9rem; color: var(--text-secondary); margin-bottom: 1rem; line-height: 1.6; }
  .calc-cta p strong { color: var(--text-primary); }
  .calc-cta-links { display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; }
  .calc-cta-link { color: var(--color-accent-text); text-decoration: none; font-weight: 700; font-size: 0.9rem; min-height: 40px; display: inline-flex; align-items: center; gap: 0.45rem; }
  .calc-cta-link:hover { text-decoration: underline; text-underline-offset: 3px; }
  .calc-explainer { text-align: center; }
  .calc-explainer__note { max-width: 640px; margin: 0 auto; }
  .calc-explainer a { color: var(--color-accent-text); font-weight: 700; }

  @media (max-width: 900px) {
    .calc-grid { grid-template-columns: 1fr; }
    .calc-result { position: static; }
  }
  @media (max-width: 480px) {
    .calc-row { flex-direction: column; align-items: flex-start; gap: 0.3rem; }
    .calc-select { width: 100%; min-width: 0; }
  }
</style>

<script>
  function initL1R5() {
    var form = document.getElementById('l1r5-form');
    if (!form) return;
    var resultEl = document.getElementById('calc-result');
    var errorEl = document.getElementById('calc-error');
    var grossEl = document.getElementById('calc-gross');
    var netEl = document.getElementById('calc-net');
    var breakdownEl = document.getElementById('calc-breakdown');
    var jcEl = document.getElementById('calc-jc');
    var resetBtn = document.getElementById('calc-reset');

    var GRADE_LABEL = { 1: 'A1', 2: 'A2', 3: 'B3', 4: 'B4', 5: 'C5', 6: 'C6', 7: 'D7', 8: 'E8', 9: 'F9' };
    var JCS = [
      { name: 'RI', sci: 3, arts: 5 }, { name: 'HCI', sci: 3, arts: 5 },
      { name: 'EJC', sci: 5, arts: 6 }, { name: 'NYJC', sci: 5, arts: 7 },
      { name: 'NJC', sci: 6, arts: 6 }, { name: 'DHS', sci: 6, arts: 7 },
      { name: 'VJC', sci: 6, arts: 8 }, { name: 'TJC', sci: 7, arts: 7 },
      { name: 'ACJC', sci: 7, arts: 9 }, { name: 'SAJC', sci: 8, arts: 11 },
      { name: 'ASRJC', sci: 9, arts: 12 }, { name: 'CJC', sci: 11, arts: 12 },
      { name: 'TMJC', sci: 12, arts: 12 }, { name: 'JPJC', sci: 13, arts: 14 },
      { name: 'YIJC', sci: 15, arts: 20 }
    ];

    function collect(cat) {
      var out = [];
      form.querySelectorAll('select[data-cat="' + cat + '"]').forEach(function (s) {
        if (s.value !== '') out.push({ name: s.getAttribute('data-name') || 'English Language', pts: parseInt(s.value, 10) });
      });
      return out;
    }

    function showError(msg) {
      errorEl.textContent = msg;
      errorEl.hidden = false;
      resultEl.hidden = true;
    }

    function calculate() {
      var english = collect('english');
      if (!english.length) { showError('Please enter your English Language grade — it is your L1.'); return; }

      var mathsci = collect('mathsci').sort(function (a, b) { return a.pts - b.pts; });
      var hums = collect('humanities').sort(function (a, b) { return a.pts - b.pts; });
      if (!mathsci.length) { showError('Add at least one Mathematics or Science subject — it is required for R2.'); return; }
      if (!hums.length) { showError('Add at least one Humanities subject — it is required for R1.'); return; }

      var L1 = english[0];
      var R2 = mathsci[0];
      var R1 = hums[0];

      // Everything not yet used goes into the pool for R3–R5.
      var pool = [];
      mathsci.slice(1).forEach(function (s) { pool.push(s); });
      hums.slice(1).forEach(function (s) { pool.push(s); });
      collect('other').forEach(function (s) { pool.push(s); });
      pool.sort(function (a, b) { return a.pts - b.pts; });

      if (pool.length < 3) { showError('Enter at least six subjects in total (English + R1 + R2 + three more) to compute a full L1R5.'); return; }

      var r3to5 = pool.slice(0, 3);
      var chosen = [L1, R1, R2].concat(r3to5);
      var gross = chosen.reduce(function (sum, s) { return sum + s.pts; }, 0);

      var bonus = 0;
      if (document.getElementById('bonus-cca').checked) bonus += 2;
      if (document.getElementById('bonus-hmt').checked) bonus += 2;
      var net = Math.max(gross - bonus, 0);

      errorEl.hidden = true;
      grossEl.textContent = gross;
      netEl.textContent = net;

      breakdownEl.innerHTML =
        '<span><strong>L1:</strong> English ' + GRADE_LABEL[L1.pts] + '</span> &nbsp;·&nbsp; ' +
        '<span><strong>R1:</strong> ' + R1.name + ' ' + GRADE_LABEL[R1.pts] + '</span> &nbsp;·&nbsp; ' +
        '<span><strong>R2:</strong> ' + R2.name + ' ' + GRADE_LABEL[R2.pts] + '</span> &nbsp;·&nbsp; ' +
        '<span><strong>R3&ndash;R5:</strong> ' + r3to5.map(function (s) { return s.name + ' ' + GRADE_LABEL[s.pts]; }).join(', ') + '</span>' +
        (bonus ? ' &nbsp;·&nbsp; <span><strong>Bonus:</strong> &minus;' + bonus + '</span>' : '');

      var sci = JCS.filter(function (j) { return net <= j.sci; }).map(function (j) { return j.name; });
      var arts = JCS.filter(function (j) { return net <= j.arts; }).map(function (j) { return j.name; });
      var html = '';
      if (sci.length) html += '<div><strong style="font-size:0.8rem;color:var(--text-secondary);">Science stream:</strong><div class="calc-jc" style="margin-top:0.4rem;">' + sci.map(function (n) { return '<span class="calc-jc-chip">' + n + '</span>'; }).join('') + '</div></div>';
      if (arts.length) html += '<div style="margin-top:0.6rem;"><strong style="font-size:0.8rem;color:var(--text-secondary);">Arts stream:</strong><div class="calc-jc" style="margin-top:0.4rem;">' + arts.map(function (n) { return '<span class="calc-jc-chip">' + n + '</span>'; }).join('') + '</div></div>';
      if (!sci.length && !arts.length) html = '<p class="calc-jc-none">With a net L1R5 of ' + net + ', none of the JCs in our 2026 table are within range &mdash; but Millennia Institute (a 3-year programme) and polytechnic routes remain open. Raising English and Maths is the fastest way to bring this down.</p>';
      jcEl.innerHTML = html;

      resultEl.hidden = false;
      resultEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      if (window.plausible) window.plausible('L1R5 Calculated');
    }

    form.onsubmit = function (e) { e.preventDefault(); calculate(); };
    if (resetBtn) resetBtn.onclick = function () {
      form.querySelectorAll('select').forEach(function (s) { s.value = ''; });
      form.querySelectorAll('input[type=checkbox]').forEach(function (c) { c.checked = false; });
      resultEl.hidden = true; errorEl.hidden = true;
    };
  }

  initL1R5();
  document.addEventListener('astro:page-load', initL1R5);
</script>
