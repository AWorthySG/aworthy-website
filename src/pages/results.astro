---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<BaseLayout title="Tuition Results | 90% O-Level English A1–B3 | A-Worthy" description="In 2025, 90% of our O-Level English students scored A1–B3. See our students' documented grade jumps, such as C5 to A2 in 3 months and D7 to B3 in 4 months.">
  <Header slot="header" />

  <!-- ===== HERO ===== -->
  <section class="r-hero">
    <div class="r-container">
      <span class="eyebrow">Results</span>
      <h1>Tuition <span class="accent-word">results</span> <br />by year and by student</h1>
      <p class="r-hero-sub">
        Our O-Level English results by exam year, and how individual students&rsquo; grades changed while they learned with us.
      </p>
      <div class="r-hero-actions" data-track="hero">
        <a href="/contact/" class="btn btn-accent">Get a Free Report</a>
      </div>
    </div>
  </section>

  <!-- ===== OVERVIEW STATS ===== -->
  <section class="r-section">
    <div class="r-container">
      <div class="r-stats-row">
        <div class="stat-card r-stat" data-animate="reveal-up" data-animate-delay="1">
          <span class="icon-circle icon-circle--green" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><path d="M15.5 12.9 17 22l-5-3-5 3 1.5-9.1"/></svg>
          </span>
          <span class="stat-card__num r-stat-num" data-count="90" data-count-suffix="%">90%</span>
          <span class="stat-card__label r-stat-label">O-Level English A1–B3</span>
        </div>
        <div class="stat-card r-stat" data-animate="reveal-up" data-animate-delay="2">
          <span class="icon-circle icon-circle--pink" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </span>
          <span class="stat-card__num r-stat-num">6</span>
          <span class="stat-card__label r-stat-label">Max class size</span>
        </div>
        <div class="stat-card r-stat" data-animate="reveal-up" data-animate-delay="3">
          <span class="icon-circle icon-circle--blue" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          </span>
          <span class="stat-card__num r-stat-num" data-count="500" data-count-suffix="+">500+</span>
          <span class="stat-card__label r-stat-label">Students taught</span>
        </div>
        <div class="stat-card r-stat" data-animate="reveal-up" data-animate-delay="4">
          <span class="icon-circle icon-circle--gold" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </span>
          <span class="stat-card__num r-stat-num">2–6</span>
          <span class="stat-card__label r-stat-label">Grades gained, six case studies</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== YEAR-OVER-YEAR ===== -->
  <section class="r-section">
    <div class="r-container">
      <div class="r-growth-head">
        <div>
          <span class="eyebrow">Growth</span>
          <h2 class="r-heading squiggle" data-animate="reveal-up">O-Level English, year by year</h2>
          <p class="r-subtitle">The share scoring A1–B3 in each exam year.</p>
        </div>
        <img src="/images/mascots/mascot-rocket.webp" alt="" width="308" height="411" class="r-growth-mascot sticker sticker--right" />
      </div>

      <div class="r-cards-3 r-cards-solo">
        <div class="r-card card-lift" data-animate="reveal-up">
          <h3 class="r-yoy-title">O-Level English: A1–B3</h3>
          <div class="r-yoy-rows">
            <div class="r-yoy-row">
              <span class="r-yoy-year">2023</span>
              <div class="r-bar-track r-bar-sm">
                <div class="r-bar-fill" style="width: 78%;"></div>
              </div>
              <span class="r-yoy-val">78%</span>
            </div>
            <div class="r-yoy-row">
              <span class="r-yoy-year">2024</span>
              <div class="r-bar-track r-bar-sm">
                <div class="r-bar-fill" style="width: 85%;"></div>
              </div>
              <span class="r-yoy-val">85%</span>
            </div>
            <div class="r-yoy-row">
              <span class="r-yoy-year">2025</span>
              <div class="r-bar-track r-bar-sm">
                <div class="r-bar-fill" style="width: 90%;"></div>
              </div>
              <span class="r-yoy-val">90%</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== GRADE TRANSFORMATIONS ===== -->
  <section class="r-section">
    <div class="r-container">
      <div class="r-transform-head">
        <div>
          <span class="eyebrow">Before &amp; after</span>
          <h2 class="r-heading squiggle" data-animate="reveal-up">Grade by grade</h2>
          <p class="r-subtitle">How five students&rsquo; grades moved, month by month, in 2024–2025.</p>
        </div>
        <img src="/images/mascots/mascot-grade-a.webp" alt="" width="414" height="553" class="r-transform-mascot sticker sticker--right" loading="lazy" />
      </div>

      <div class="grade-journey" data-animate="reveal-up">
        <div class="journey-cards">
          <div class="journey-card card-lift" data-animate="reveal-up" data-animate-delay="1">
            <div class="journey-header">
              <strong class="journey-name">Sarah T.</strong>
              <span class="journey-duration">3 months</span>
            </div>
            <div class="journey-progress">
              <div class="journey-grade journey-grade-before chip chip--pink">C5</div>
              <div class="journey-line">
                <div class="journey-line-fill" style="--journey-progress: 75%"></div>
                <div class="journey-milestone" style="--pos: 33%">
                  <span class="journey-milestone-label">Month 1: B4</span>
                </div>
                <div class="journey-milestone" style="--pos: 66%">
                  <span class="journey-milestone-label">Month 2: B3</span>
                </div>
              </div>
              <div class="journey-grade journey-grade-after chip chip--green">A2</div>
            </div>
          </div>
          <div class="journey-card card-lift" data-animate="reveal-up" data-animate-delay="2">
            <div class="journey-header">
              <strong class="journey-name">Marcus L.</strong>
              <span class="journey-duration">4 months</span>
            </div>
            <div class="journey-progress">
              <div class="journey-grade journey-grade-before chip chip--pink">D7</div>
              <div class="journey-line">
                <div class="journey-line-fill" style="--journey-progress: 60%"></div>
                <div class="journey-milestone" style="--pos: 50%">
                  <span class="journey-milestone-label">Month 2: C5</span>
                </div>
              </div>
              <div class="journey-grade journey-grade-after chip chip--green">B3</div>
            </div>
          </div>
          <div class="journey-card card-lift" data-animate="reveal-up" data-animate-delay="3">
            <div class="journey-header">
              <strong class="journey-name">Priya K.</strong>
              <span class="journey-duration">5 months</span>
            </div>
            <div class="journey-progress">
              <div class="journey-grade journey-grade-before chip chip--pink">C6</div>
              <div class="journey-line">
                <div class="journey-line-fill" style="--journey-progress: 90%"></div>
                <div class="journey-milestone" style="--pos: 40%">
                  <span class="journey-milestone-label">Month 2: B4</span>
                </div>
                <div class="journey-milestone" style="--pos: 70%">
                  <span class="journey-milestone-label">Month 4: A2</span>
                </div>
              </div>
              <div class="journey-grade journey-grade-after chip chip--green">A1</div>
            </div>
          </div>
          <div class="journey-card card-lift" data-animate="reveal-up" data-animate-delay="4">
            <div class="journey-header">
              <strong class="journey-name">Wei Jie C.</strong>
              <span class="journey-duration">2 months</span>
            </div>
            <div class="journey-progress">
              <div class="journey-grade journey-grade-before chip chip--pink">B4</div>
              <div class="journey-line">
                <div class="journey-line-fill" style="--journey-progress: 80%"></div>
                <div class="journey-milestone" style="--pos: 50%">
                  <span class="journey-milestone-label">Month 1: B3</span>
                </div>
              </div>
              <div class="journey-grade journey-grade-after chip chip--green">A2</div>
            </div>
          </div>
          <div class="journey-card card-lift" data-animate="reveal-up" data-animate-delay="5">
            <div class="journey-header">
              <strong class="journey-name">Aisha M.</strong>
              <span class="journey-duration">H1 GP &middot; 6 months</span>
            </div>
            <div class="journey-progress">
              <div class="journey-grade journey-grade-before chip chip--pink">U</div>
              <div class="journey-line">
                <div class="journey-line-fill" style="--journey-progress: 80%"></div>
                <div class="journey-milestone" style="--pos: 33%">
                  <span class="journey-milestone-label">Month 2: D</span>
                </div>
                <div class="journey-milestone" style="--pos: 66%">
                  <span class="journey-milestone-label">Month 4: C</span>
                </div>
              </div>
              <div class="journey-grade journey-grade-after chip chip--green">B</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== SUCCESS STORIES ===== -->
  <section class="r-section">
    <div class="r-container">
      <span class="eyebrow">Student Stories</span>
      <h2 class="r-heading squiggle" data-animate="reveal-up">In their own words</h2>
      <p class="r-subtitle">Three O-Level English students on what changed.</p>

      <div class="r-cards-3 r-stories">
        <div class="r-card r-story-card card-lift" data-animate="reveal-up" data-animate-delay="1">
          <span class="r-story-badge chip chip--blue">O-Level English</span>
          <h3 class="r-story-name">Sarah</h3>
          <p class="r-story-school">Sec 4, 3 months with A-Worthy</p>
          <div class="r-story-grades">
            <div class="r-grade-block">
              <span class="r-grade-label">Before</span>
              <span class="r-grade-val r-grade-before chip chip--pink">C5</span>
            </div>
            <span class="r-grade-arrow">&rarr;</span>
            <div class="r-grade-block">
              <span class="r-grade-label">After</span>
              <span class="r-grade-val r-grade-after chip chip--green">A2</span>
            </div>
          </div>
          <p class="r-story-quote">"I used to dread comprehension passages. Now I actually enjoy pulling them apart — it's like solving a puzzle."</p>
        </div>

        <div class="r-card r-story-card card-lift" data-animate="reveal-up" data-animate-delay="2">
          <span class="r-story-badge chip chip--blue">O-Level English</span>
          <h3 class="r-story-name">Marcus</h3>
          <p class="r-story-school">Sec 4, 4 months with A-Worthy</p>
          <div class="r-story-grades">
            <div class="r-grade-block">
              <span class="r-grade-label">Before</span>
              <span class="r-grade-val r-grade-before chip chip--pink">D7</span>
            </div>
            <span class="r-grade-arrow">&rarr;</span>
            <div class="r-grade-block">
              <span class="r-grade-label">After</span>
              <span class="r-grade-val r-grade-after chip chip--green">B3</span>
            </div>
          </div>
          <p class="r-story-quote">"My parents couldn't believe the change. I went from failing English to actually looking forward to the exam."</p>
        </div>

        <div class="r-card r-story-card card-lift" data-animate="reveal-up" data-animate-delay="3">
          <span class="r-story-badge chip chip--blue">O-Level English</span>
          <h3 class="r-story-name">Priya</h3>
          <p class="r-story-school">Sec 4, 5 months with A-Worthy</p>
          <div class="r-story-grades">
            <div class="r-grade-block">
              <span class="r-grade-label">Before</span>
              <span class="r-grade-val r-grade-before chip chip--pink">C6</span>
            </div>
            <span class="r-grade-arrow">&rarr;</span>
            <div class="r-grade-block">
              <span class="r-grade-label">After</span>
              <span class="r-grade-val r-grade-after chip chip--green">A1</span>
            </div>
          </div>
          <p class="r-story-quote">"The SHARP Method didn't just help me in English — it changed how I think about every subject."</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section class="r-cta" data-track="final-cta">
    <div class="r-container">
      <span class="eyebrow">Get Started</span>
      <h2 class="r-cta-heading" data-animate="reveal-up">Find out what&rsquo;s holding your child&rsquo;s grade back</h2>
      <p class="r-cta-sub">Send us your child&rsquo;s latest test or exam paper, and Jeremy will send you a free written report on the gaps and the <span class="r-nobr">A-Worthy</span> programme we recommend.</p>
      <div class="r-cta-actions">
        <a href="/contact/" class="btn btn-accent">Get a Free Report</a>
        <a href="https://wa.me/6589913181" class="btn">WhatsApp us</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* Uses the sticker-book tokens + vocabulary from global.css (ink cards,
     red action colour, feature-colour data, grey micro-labels). */

  /* ===== CONTAINER ===== */
  .r-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* ===== HERO ===== */
  .r-hero {
    padding: 1.75rem 0;
    text-align: center;
  }

  .r-hero h1 {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 900;
    color: var(--text-primary);
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin: 0 0 1.5rem;
  }

  .r-hero-sub {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto;
  }

  .r-hero-actions {
    display: flex;
    justify-content: center;
    margin-top: 1.5rem;
  }

  /* ===== SECTIONS ===== */
  .r-section {
    padding: 1.75rem 0;
  }

  .r-heading {
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
  }

  .r-subtitle {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 0 1.25rem;
  }

  .r-growth-head,
  .r-transform-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .r-growth-mascot {
    height: 110px;
    width: auto;
    flex-shrink: 0;
    margin-bottom: 0.5rem;
  }

  .r-transform-mascot {
    width: 130px;
    height: auto;
    flex-shrink: 0;
    margin-bottom: 0.5rem;
  }

  @media (max-width: 640px) {
    .r-growth-mascot,
    .r-transform-mascot { display: none; }
  }

  /* ===== STATS ROW — the LMS dashboard stat tiles: global .stat-card with a
     tinted .icon-circle, 900 number and grey micro-label. Four tiles → 2×2 on
     tablets and phones, so no grid cell is ever left empty. ===== */
  .r-stats-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
  }

  /* Page-level sizing only — the tile look itself comes from .stat-card */
  .r-stat {
    padding: 1.5rem 1.5rem 1.35rem;
    gap: 0.45rem;
  }

  .r-stat-num {
    font-size: 2.5rem;
    white-space: nowrap;
    margin-top: 0.55rem;
  }


  /* ===== CARDS GRID ===== */
  .r-cards-3 {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  /* One card should not sit in a third of the row with two empty cells.
     Two classes so the 2-column tablet rule for .r-cards-3 can't override it
     (it used to, leaving the chart in the left half at 769–1024px). */
  .r-cards-3.r-cards-solo {
    grid-template-columns: minmax(0, 45rem);
    justify-content: center;
  }

  /* Ink card — white sticker on the paper, 3px hard rest shadow, lifts on hover */
  .r-card,
  .journey-card {
    background: var(--bg-card);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-md);
    box-shadow: 0 3px 0 var(--ink-shadow);
    transition: transform 0.22s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.22s ease;
  }

  .r-card {
    padding: 1.75rem;
  }

  @media (hover: hover) {
    .r-card:hover,
    .journey-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 0 var(--ink-shadow), 0 12px 24px rgba(70, 50, 20, 0.10);
    }
  }

  .r-card-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1rem;
  }

  .r-card-subject {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .r-card-pct {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .r-card-note {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin-top: 0.75rem;
  }

  /* ===== PROGRESS BARS — muted track, ink outline, feature-colour fills ===== */
  .r-bar-track {
    width: 100%;
    height: 12px;
    background: var(--bg-muted);
    border: 1.5px solid var(--color-ink);
    border-radius: var(--radius-pill);
    overflow: hidden;
  }

  .r-bar-sm {
    height: 10px;
  }

  .r-bar-fill {
    height: 100%;
    background: var(--color-sun);
    border-radius: var(--radius-pill);
  }


  /* ===== YEAR-OVER-YEAR ===== */
  .r-yoy-title {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 1.25rem;
  }

  .r-yoy-rows {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .r-yoy-row {
    display: grid;
    grid-template-columns: 44px 1fr 44px;
    align-items: center;
    gap: 0.75rem;
  }

  .r-yoy-year {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--text-secondary);
  }

  .r-yoy-val {
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--text-primary);
    text-align: right;
  }

  /* ===== STORY CARDS ===== */
  .r-story-card {
    display: flex;
    flex-direction: column;
  }

  .r-story-badge {
    width: fit-content;
    margin-bottom: 1rem;
  }

  .r-story-name {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 0.15rem;
  }

  .r-story-school {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin: 0 0 1.25rem;
  }

  .r-story-grades {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    margin-bottom: 1rem;
    padding: 1rem 0;
    border-top: 2px dashed var(--ink-faint);
    border-bottom: 2px dashed var(--ink-faint);
  }

  .r-grade-block {
    text-align: center;
  }

  .r-grade-label {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin-bottom: 0.35rem;
  }

  /* Grade pills are .chip--pink / .chip--green; only the size is page-specific */
  .r-grade-val.chip {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 0;
    padding: 0.3rem 0.85rem;
    line-height: 1.2;
  }

  .r-grade-arrow {
    font-size: 1.25rem;
    color: var(--text-secondary);
    font-weight: 700;
  }

  .r-story-quote {
    font-size: 0.9rem;
    font-style: italic;
    line-height: 1.7;
    color: var(--text-secondary);
    margin: 0;
    flex-grow: 1;
  }

  /* ===== CTA ===== */
  .r-cta {
    padding: 3rem 0;
    text-align: center;
  }

  .r-cta-heading {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
  }

  .r-cta-sub {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 550px;
    margin: 0 auto 2rem;
  }
  /* the brand name never breaks at its hyphen ("A- / Worthy") */
  .r-nobr { white-space: nowrap; }
  /* rem at the 112.5-150% roots (600px / 550px at 16px): in px the hero and
     CTA copy ran ~35-40 characters a line at 2560 */
  @media (min-width: 1441px) {
    .r-hero-sub { max-width: 37.5rem; }
    .r-cta-sub { max-width: 34.375rem; }
  }

  .r-cta-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* ===== ANIMATED GRADE JOURNEY (#9) ===== */
  .journey-cards {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 55rem;
  }

  .journey-card {
    padding: 1.5rem 2rem;
  }

  .journey-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .journey-name {
    font-size: 1rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .journey-duration {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .journey-progress {
    display: flex;
    align-items: center;
    gap: 1rem;
    /* Reserves room under the line for the always-visible milestone labels */
    padding-bottom: 1.35rem;
  }

  /* Before / after grades are .chip--pink / .chip--green; size only here */
  .journey-grade.chip {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0;
    padding: 0.3rem 0.75rem;
    line-height: 1.2;
    flex-shrink: 0;
  }

  .journey-line {
    flex: 1;
    height: 4px;
    background: var(--ink-faint);
    border-radius: 2px;
    position: relative;
    overflow: visible;
  }

  /* Grows on the compositor (scaleX), not by animating width, which re-laid
     out the page on every frame of the 1.5s fill */
  .journey-line-fill {
    height: 100%;
    width: var(--journey-progress);
    background: var(--color-leaf);
    border-radius: 2px;
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 1.5s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.3s;
  }

  .journey-card.is-visible .journey-line-fill,
  .journey-card [data-animate].is-visible .journey-line-fill {
    transform: scaleX(1);
  }

  .journey-milestone {
    position: absolute;
    top: -6px;
    left: var(--pos);
    width: 16px;
    height: 16px;
    transform: translateX(-50%);
  }

  .journey-milestone::before {
    content: '';
    position: absolute;
    inset: 2px;
    border-radius: 50%;
    background: var(--color-sun);
    border: 2px solid var(--color-ink);
  }

  /* Milestone labels sit under their dot and are always readable — no hover-only data */
  .journey-milestone-label {
    position: absolute;
    top: calc(100% + 4px);
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .journey-card {
      padding: 1.25rem;
    }
    .journey-grade.chip {
      font-size: 0.9rem;
    }
    /* Two labels on a short line would collide — the second one drops a row */
    .journey-progress {
      padding-bottom: 2.4rem;
    }
    .journey-milestone + .journey-milestone .journey-milestone-label {
      top: calc(100% + 4px + 1.05rem);
    }
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 1024px) {
    .r-stats-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    .r-cards-3 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* Two columns: 3 stories → 2 + 1. Four half-width tracks let the odd
       card out sit centred under the pair above it instead of leaving an
       empty cell beside it. */
    .r-cards-3.r-stories {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .r-stories > .r-card {
      grid-column: span 2;
    }
    .r-stories > .r-card:nth-child(3) {
      grid-column: 2 / span 2;
    }
  }

  /* One column only on phones — tablets in portrait keep two (a 700px-wide
     single card with a centred grade pair was mostly empty space). */
  @media (max-width: 700px) {
    .r-cards-3,
    .r-cards-3.r-stories {
      grid-template-columns: minmax(0, 1fr);
    }
    .r-cards-3 > .r-card:nth-child(n) {
      grid-column: auto;
    }
  }

  @media (max-width: 768px) {
    .r-hero {
      padding: 1.75rem 0 1.25rem;
    }

    .r-section {
      padding: 1.5rem 0;
    }

    .r-stats-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .r-stat-num {
      font-size: 2.2rem;
    }

    .r-cta {
      padding: 1.75rem 0;
    }
  }

  @media (max-width: 480px) {
    .r-hero {
      padding: 1.5rem 0 1rem;
    }

    .r-hero-actions {
      margin-top: 1.25rem;
    }

    /* Phone display size (as global.css steps h1 down); the forced break
       after "results" is dropped so the headline wraps naturally to 3 lines
       instead of 4 with "results" stranded on a line of its own. */
    .r-hero h1 {
      font-size: clamp(1.9rem, 8.5vw, 2.4rem);
    }
    .r-hero h1 br {
      display: none;
    }

    .r-stats-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
    }

    .r-stat {
      padding: 1.1rem 1rem 1rem;
    }

    .r-stat-num {
      font-size: 1.9rem;
    }

    .r-grade-val.chip {
      font-size: 1rem;
    }

    .r-story-grades {
      gap: 0.75rem;
    }

    .r-cta-actions {
      flex-direction: column;
      align-items: center;
    }
  }

  /* ===== LARGE SCREENS ===== */
  @media (min-width: 1921px) {
    /* rem, not px: html is 125–150% here, so a fixed 1400px squeezed the
       3-up story cards until "O-Level Result" wrapped and the grade pills
       fell out of line at 2560px. */
    .r-container {
      max-width: 75rem;
    }
    .r-section {
      padding: 2.25rem 0;
    }
    .r-stat-num {
      font-size: 3rem;
    }
    .r-cards-3 {
      gap: 2rem;
    }
    .r-cta {
      padding: 2.5rem 0;
    }
  }

  /* Tablet portrait */
  @media (min-width: 481px) and (max-width: 768px) {
    .r-stats-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

<script is:inline>
(function(){
  var cards = document.querySelectorAll('.journey-card');
  if (!cards.length) return;
  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.3 });
  cards.forEach(function(c) { observer.observe(c); });
})();
</script>
