---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';
---

<BaseLayout title="H2 Economics Tuition for JC Students | A-Worthy Singapore" description="Top-rated H2 Economics tuition for JC students. SHARP Method for diagram precision, essay technique & case study mastery. Max 6 per class." ogImage="/images/og-econs.png" noindex={true}>
  <Header slot="header" />

  <section class="lp-hero">
    <div class="container">
      <span class="eyebrow">H2 Economics Tuition</span>
      <h1 class="lp-title">Master H2 Economics with<br/><span class="accent-word">analytical precision</span></h1>
      <p class="lp-subtitle">The SHARP Method applies legal reasoning to economic analysis &mdash; diagram accuracy, essay structure, and case study evaluation. Small groups of 6, live on the A-Worthy Whiteboard. <a href="/h2-economics/#playbook" style="color: var(--color-accent); text-decoration: underline;">See the full SHARP Playbook &rarr;</a></p>
      <div class="lp-cta-row">
        <a href="/contact/" class="btn btn-accent plausible-event-name=LP+CTA+Click">Book Free Assessment</a>
        <a href="/h2-economics/" class="btn">View Full Programme</a>
      </div>
    </div>
    <img class="sticker sticker--hero sticker--right" src="/images/mascots/mascot-economics.webp" width="426" height="551" alt="" decoding="async">
  </section>

  <section class="section lp-proof">
    <div class="container">
      <div class="lp-stats">
        <div class="lp-stat"><span class="stat-dot stat-dot--green" aria-hidden="true"></span><span class="lp-stat-num" data-count="85" data-count-suffix="%">0</span><span class="lp-stat-label">score B or above</span></div>
        <div class="lp-stat"><span class="stat-dot stat-dot--pink" aria-hidden="true"></span><span class="lp-stat-num">6</span><span class="lp-stat-label">max per class</span></div>
        <div class="lp-stat"><span class="stat-dot stat-dot--blue" aria-hidden="true"></span><span class="lp-stat-num" data-count="4.9">0</span><span class="lp-stat-label">Google rating</span></div>
      </div>

      <div class="lp-testimonial">
        <blockquote>&ldquo;I went from blank-staring at case studies to actually enjoying them. The DEED structure changed everything for me.&rdquo;</blockquote>
        <cite>&mdash; Daniel O., JC 2 student (U &rarr; A in 8 months)</cite>
      </div>
    </div>
  </section>

  <section class="section lp-features">
    <div class="container">
      <h2 class="squiggle squiggle--center">Full 9570 syllabus mastery</h2>
      <div class="lp-features-grid">
        <div class="lp-feature card-lift">
          <span class="icon-circle icon-circle--green" aria-hidden="true">1</span>
          <h3>Diagram Precision</h3>
          <p>Every essential diagram mastered &mdash; demand-supply, market failure, AD-AS, exchange rates, Phillips curve. Correctly labelled, exam-ready.</p>
        </div>
        <div class="lp-feature card-lift">
          <span class="icon-circle icon-circle--pink" aria-hidden="true">2</span>
          <h3>Essay Technique</h3>
          <p>The DEED structure &mdash; Define, Explain, Evaluate, Diagram &mdash; gives your child a repeatable framework for every essay question type. Learn what examiners look for in each mark band.</p>
        </div>
        <div class="lp-feature card-lift">
          <span class="icon-circle icon-circle--blue" aria-hidden="true">3</span>
          <h3>Case Study Mastery</h3>
          <p>The Extract-Link-Apply method for data interpretation and higher-order evaluation. The component where most marks are won or lost.</p>
        </div>
        <div class="lp-feature card-lift">
          <span class="icon-circle icon-circle--gold" aria-hidden="true">4</span>
          <h3>Real-World Application</h3>
          <p>Current Singapore and global examples for every topic. Examiners reward students who can connect theory to reality.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--sand lp-final-cta">
    <div class="container" style="text-align:center;">
      <h2>Ready to improve your Economics grade?</h2>
      <p style="max-width:540px;margin:0 auto 2rem;color:var(--text-secondary);">Book a free 20-minute diagnostic assessment. We&rsquo;ll identify your specific gaps and recommend the right programme.</p>
      <a href="/contact/" class="btn btn-accent plausible-event-name=LP+CTA+Click">Book Free Assessment</a>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* ── Hero — centred copy, soft sunlit wash, subject sticker in the right margin ── */
  .lp-hero { position: relative; overflow: hidden; padding: 1.5rem 0 1.75rem; text-align: center; }
  .lp-hero::before {
    content: '';
    position: absolute;
    top: -32%;
    right: -10%;
    width: 520px;
    height: 520px;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-sun) 12%, transparent) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }
  .lp-hero > .container { position: relative; z-index: 1; }
  .lp-title { font-family: var(--font-heading); font-size: clamp(2.2rem, 5vw, 3.4rem); font-weight: 900; line-height: 1.1; letter-spacing: -0.02em; color: var(--text-primary); margin-bottom: 1.25rem; }
  .lp-subtitle { font-size: 1.1rem; line-height: 1.7; color: var(--text-secondary); max-width: 600px; margin: 0 auto 1.25rem; }
  .lp-cta-row { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

  /* ── Proof row — coloured stat dots before 900-weight numbers, grey micro-labels ── */
  .lp-stats { display: flex; justify-content: center; flex-wrap: wrap; gap: 2rem 3rem; margin-bottom: 2rem; }
  .lp-stat { text-align: center; }
  .lp-stat .stat-dot { width: 11px; height: 11px; margin-right: 0.5rem; vertical-align: 0.55em; }
  .lp-stat-num { display: inline-block; font-family: var(--font-heading); font-size: 2.5rem; font-weight: 900; line-height: 1; letter-spacing: -0.02em; color: var(--text-primary); }
  .lp-stat-label { display: block; margin-top: 0.4rem; font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.08em; }

  /* ── Testimonial — a white ink card with a red squiggle above the quote ── */
  .lp-testimonial {
    max-width: 640px;
    margin: 0 auto;
    padding: 1.75rem 2rem;
    text-align: center;
    background: var(--bg-card);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-md);
    box-shadow: 0 3px 0 var(--ink-shadow);
  }
  .lp-testimonial::before {
    content: '';
    display: block;
    width: 72px;
    height: 12px;
    margin: 0 auto 1rem;
    background: var(--swash) center / contain no-repeat;
  }
  .lp-testimonial blockquote { font-family: var(--font-heading); font-size: 1.25rem; font-weight: 600; font-style: italic; color: var(--text-primary); line-height: 1.6; margin: 0 0 0.75rem; }
  .lp-testimonial cite { font-size: 0.85rem; font-weight: 700; color: var(--text-secondary); font-style: normal; }

  /* ── Feature grid — white ink cards that lift, numbered icon circles ── */
  .lp-features h2 { font-family: var(--font-heading); font-size: clamp(1.8rem, 4vw, 2.5rem); font-weight: 800; letter-spacing: -0.02em; text-align: center; margin-bottom: 1.5rem; }
  .lp-features-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; max-width: 800px; margin: 0 auto; }
  .lp-feature { background: var(--bg-card); border: 2px solid var(--color-ink); border-radius: var(--radius-md); box-shadow: 0 3px 0 var(--ink-shadow); padding: 1.25rem; }
  .lp-feature .icon-circle { margin-bottom: 0.75rem; font-family: var(--font-heading); font-size: 0.9rem; font-weight: 800; }
  .lp-feature h3 { font-size: 1.05rem; font-weight: 800; color: var(--text-primary); margin-bottom: 0.5rem; }
  .lp-feature p { font-size: 0.9rem; line-height: 1.6; color: var(--text-secondary); }

  /* ── Final CTA — sand band, one red button ── */
  .lp-final-cta h2 { font-family: var(--font-heading); font-size: clamp(1.6rem, 4vw, 2.2rem); font-weight: 800; letter-spacing: -0.02em; margin-bottom: 0.75rem; }

  @media (max-width: 640px) {
    .lp-stats { gap: 1.5rem 2rem; }
    .lp-stat-num { font-size: 2.1rem; }
    .lp-testimonial { padding: 1.5rem 1.25rem; }
    .lp-features-grid { grid-template-columns: 1fr; }
  }
</style>
