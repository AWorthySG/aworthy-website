---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';
---

<BaseLayout title="Best O-Level Maths Tuition in Singapore | A-Worthy" description="O-Level Mathematics tuition with the SHARP Method — a named framework for every question type. Max 6 per class, NUS Law graduate tutor, free assessment." ogImage="/images/og-maths.png" noindex={true}>
  <Header slot="header" />

  <section class="lp-hero">
    <div class="container">
      <div class="hero-card lp-hero-card subject--maths">
        <div class="lp-hero-copy">
          <span class="eyebrow">O-Level Mathematics Tuition</span>
          <h1 class="lp-title squiggle">Your child deserves an <span class="accent-word">A for Maths</span></h1>
          <p class="lp-subtitle">The SHARP Method gives your child a named, examiner-aligned framework for every question type — so they always know which method to reach for. Small groups of 6, live on the A-Worthy Whiteboard. <a href="/o-level-mathematics/#playbook">See the full SHARP Playbook&nbsp;&rarr;</a></p>
          <div class="lp-cta-row">
            <a href="/contact/" class="btn btn-accent plausible-event-name=LP+CTA+Click">Book Free Assessment</a>
            <a href="/o-level-mathematics/" class="btn">View Full Programme</a>
          </div>
          <div class="lp-stats">
            <div class="lp-stat"><span class="stat-dot stat-dot--green" aria-hidden="true"></span><span class="lp-stat-num">6</span><span class="lp-stat-label">max per class</span></div>
            <div class="lp-stat"><span class="stat-dot stat-dot--pink" aria-hidden="true"></span><span class="lp-stat-num" data-count="4.9">0</span><span class="lp-stat-label">Google rating</span></div>
            <div class="lp-stat"><span class="stat-dot stat-dot--blue" aria-hidden="true"></span><span class="lp-stat-num">S$280</span><span class="lp-stat-label">from / month</span></div>
          </div>
        </div>
        <img class="sticker sticker--right lp-hero-art" src="/images/mascots/mascot-maths.webp" width="417" height="553" alt="" decoding="async">
      </div>
    </div>
  </section>

  <section class="section lp-proof">
    <div class="container">
      <div class="lp-testimonial">
        <blockquote>&ldquo;Built on the same SHARP Method behind multi-grade jumps in English, GP and Economics &mdash; now engineered for the O-Level Mathematics 4048 syllabus, with a named framework for every question type.&rdquo;</blockquote>
        <cite>&mdash; The A-Worthy method, taught by Jeremy Lim, LLB (Hons) NUS Law</cite>
      </div>
    </div>
  </section>

  <section class="section lp-features">
    <div class="container">
      <h2 class="squiggle squiggle--center">A framework for every question type</h2>
      <div class="lp-features-grid">
        <div class="lp-feature card-lift">
          <span class="icon-circle icon-circle--green" aria-hidden="true">1</span>
          <h3>Algebra &amp; Word Problems</h3>
          <p>READ (Read, Extract, Assign, Derive) turns wordy questions into precise equations, with line-by-line working that earns every method mark.</p>
        </div>
        <div class="lp-feature card-lift">
          <span class="icon-circle icon-circle--pink" aria-hidden="true">2</span>
          <h3>Geometry &amp; Trigonometry</h3>
          <p>LABEL for geometry and RULE for trigonometry — a right-angle check decides SOH-CAH-TOA, sine rule, or cosine rule, so your child never picks the wrong method.</p>
        </div>
        <div class="lp-feature card-lift">
          <span class="icon-circle icon-circle--blue" aria-hidden="true">3</span>
          <h3>Functions &amp; Graphs</h3>
          <p>PLOT (Parameters, Locate, Obtain, Trace) for accurate sketching of linear, quadratic, cubic, and exponential functions — intercepts, turning points, and symmetry every time.</p>
        </div>
        <div class="lp-feature card-lift">
          <span class="icon-circle icon-circle--gold" aria-hidden="true">4</span>
          <h3>Statistics, Probability &amp; Proofs</h3>
          <p>DATA (Define, Arrange, Tabulate, Answer) maximises method marks in statistics; SHOW (State, Hunt, Order, Write) turns intimidating &ldquo;show that&rdquo; questions into a structured chain of reasoning.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--sand lp-final-cta">
    <div class="container" style="text-align:center;">
      <h2 class="squiggle squiggle--center">Start your child&rsquo;s transformation</h2>
      <p style="max-width:540px;margin:0 auto 2rem;color:var(--text-secondary);">Book a free 20-minute diagnostic assessment. We&rsquo;ll review your child&rsquo;s recent Maths paper, identify their specific gaps, and recommend the right programme &mdash; no obligation, no sales pitch.</p>
      <a href="/contact/" class="btn btn-accent plausible-event-name=LP+CTA+Click">Book Free Assessment</a>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* ── Hero — the LMS welcome card: a white ink card with the subject-tint wash,
     copy + proof row on the left and the subject sticker on the right (≥1024px);
     the sticker sits centred above the headline on narrower screens ── */
  .lp-hero { padding: 1.5rem 0 var(--space-3xl); }
  .lp-hero-card { display: flex; flex-direction: column; text-align: center; }
  .lp-hero-copy { min-width: 0; }
  .lp-hero-art { order: -1; width: 140px; margin: 0 auto 1rem; }
  .lp-title { font-family: var(--font-heading); font-size: clamp(2.2rem, 4vw, 3.2rem); font-weight: 900; line-height: 1.1; letter-spacing: -0.02em; color: var(--text-primary); margin-bottom: 1.25rem; }
  .lp-title::after { margin-inline: auto; }
  .lp-subtitle { font-size: 1.1rem; line-height: 1.7; color: var(--text-secondary); max-width: 640px; margin: 0 auto 1.25rem; text-wrap: pretty; }
  .lp-subtitle a { color: var(--color-accent-text); text-decoration: underline; text-underline-offset: 0.15em; }
  .lp-cta-row { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

  /* ── Proof row — coloured stat dots before 900-weight numbers, grey micro-labels;
     three equal columns under a dashed rule inside the hero card ── */
  .lp-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem 0.5rem; margin-top: 1.5rem; padding-top: 1.25rem; border-top: 2px dashed var(--ink-faint); }
  .lp-stat { text-align: center; }
  .lp-stat .stat-dot { width: 11px; height: 11px; margin-right: 0.5rem; vertical-align: 0.55em; }
  .lp-stat-num { display: inline-block; font-family: var(--font-heading); font-size: 2.5rem; font-weight: 900; line-height: 1; letter-spacing: -0.02em; color: var(--text-primary); }
  .lp-stat-label { display: block; margin-top: 0.4rem; font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.08em; }

  @media (min-width: 1024px) {
    .lp-hero-card { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; column-gap: clamp(1.5rem, 3vw, 3rem); text-align: left; }
    .lp-hero-art { order: 0; width: clamp(150px, 15vw, 180px); margin: 0; }
    .lp-title::after { margin-inline: 0; }
    .lp-subtitle { margin-inline: 0; }
    .lp-cta-row { justify-content: flex-start; }
    .lp-stats { display: flex; flex-wrap: wrap; justify-content: flex-start; gap: 1rem 2.5rem; }
    .lp-stat { text-align: left; }
  }

  /* ── Testimonial — a white ink card with a red squiggle above the quote ── */
  .lp-testimonial {
    max-width: 800px;
    margin: 0 auto;
    padding: 1.75rem 2rem;
    text-align: center;
    background: var(--bg-card);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-md);
    box-shadow: 0 3px 0 var(--ink-shadow);
  }
  .lp-testimonial::before {
    content: '';
    display: block;
    width: 72px;
    height: 12px;
    margin: 0 auto 1rem;
    background: var(--swash) center / contain no-repeat;
  }
  .lp-testimonial blockquote { font-family: var(--font-heading); font-size: 1.25rem; font-weight: 600; font-style: italic; color: var(--text-primary); line-height: 1.6; margin: 0 0 0.75rem; }
  .lp-testimonial cite { font-size: 0.85rem; font-weight: 700; color: var(--text-secondary); font-style: normal; }

  /* ── Feature grid — white ink cards that lift, numbered icon circles ── */
  .lp-features h2 { font-family: var(--font-heading); font-size: clamp(1.8rem, 4vw, 2.5rem); font-weight: 800; letter-spacing: -0.02em; text-align: center; margin-bottom: 1.5rem; }
  .lp-features-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; max-width: 800px; margin: 0 auto; }
  .lp-feature { background: var(--bg-card); border: 2px solid var(--color-ink); border-radius: var(--radius-md); box-shadow: 0 3px 0 var(--ink-shadow); padding: 1.25rem; }
  .lp-feature .icon-circle { margin-bottom: 0.75rem; font-family: var(--font-heading); font-size: 0.9rem; font-weight: 800; }
  .lp-feature h3 { font-size: 1.05rem; font-weight: 800; color: var(--text-primary); margin-bottom: 0.5rem; }
  .lp-feature p { font-size: 0.9rem; line-height: 1.6; color: var(--text-secondary); }

  /* ── Final CTA — sand band, one red button ── */
  .lp-final-cta h2 { font-family: var(--font-heading); font-size: clamp(1.6rem, 4vw, 2.2rem); font-weight: 800; letter-spacing: -0.02em; margin-bottom: 0.75rem; }

  @media (max-width: 640px) {
    /* The three proofs share one row: smaller dot, number scaled to the column
       (widest number is "S$280"), labels at the 0.72rem floor and wrapping */
    .lp-stat .stat-dot { width: 9px; height: 9px; margin-right: 0.4rem; }
    .lp-stat-num { font-size: clamp(1.4rem, 6.7vw, 2.1rem); }
    .lp-stat-label { font-size: 0.72rem; letter-spacing: 0.06em; }
    .lp-testimonial { padding: 1.5rem 1.25rem; }
    .lp-features-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 480px) {
    .lp-hero-card { padding: 1.25rem; }
  }
</style>
