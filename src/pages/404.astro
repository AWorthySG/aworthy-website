---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<BaseLayout title="Page Not Found | A-Worthy Singapore Tuition Centre" description="This page doesn't exist. Return to A-Worthy's homepage for O-Level English & Maths, H1 GP and H2 Economics tuition in Singapore." noindex={true}>
  <Header slot="header" />

  <section class="error-page">
    <div class="error-bg">404</div>
    <section class="section error-section">
      <div class="container" style="text-align: center; max-width: 37.5rem;">
        <img src="/images/mascots/mascot-sorry.webp" alt="" width="412" height="480" class="sticker error-mascot" />
        <span class="eyebrow">404</span>
        <h1 class="error-title">Page not found</h1>
        <p style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.7; margin-bottom: 2.5rem;">The page you're looking for doesn't exist or has been moved. Let's get you back on track.</p>
        <div style="display: flex; flex-direction: column; gap: 0.75rem; align-items: center; margin-bottom: 3rem;">
          <a href="/" class="btn btn-primary" style="min-width: 240px; text-align: center;">Go to Homepage</a>
          <a href="/programmes/" class="btn btn-secondary" style="min-width: 240px; text-align: center;">View Programmes</a>
          <a href="/contact/" class="btn btn-secondary" style="min-width: 240px; text-align: center;">Contact Us</a>
        </div>
        <p style="font-size: 0.85rem; color: var(--text-muted);">Popular pages:</p>
        <div class="error-links" style="display: flex; flex-wrap: wrap; justify-content: center; gap: 0.25rem 1.25rem; margin-top: 0.75rem;">
          <a href="/o-level-english/">O-Level English</a>
          <span style="color: var(--text-muted);">&middot;</span>
          <a href="/h1-general-paper/">H1 General Paper</a>
          <span style="color: var(--text-muted);">&middot;</span>
          <a href="/h2-economics/">H2 Economics</a>
          <span style="color: var(--text-muted);">&middot;</span>
          <a href="/o-level-mathematics/">O-Level Maths</a>
          <span style="color: var(--text-muted);">&middot;</span>
          <a href="/pre-ib-mathematics/">Pre-IB Maths</a>
          <span style="color: var(--text-muted);">&middot;</span>
          <a href="/resources/">Free Resources</a>
          <span style="color: var(--text-muted);">&middot;</span>
          <a href="/results/">Results</a>
        </div>

        <div class="suggestions" data-animate="reveal-up">
          <h2 class="section-title">You might be looking for</h2>
          <div class="suggestion-grid">
            <a href="/programmes/" class="suggestion-card card-lift">
              <h3>Programmes</h3>
              <p>O-Level English, Maths, H1 GP & H2 Economics</p>
            </a>
            <a href="/pricing/" class="suggestion-card card-lift">
              <h3>Pricing</h3>
              <p>Transparent fees from SGD 280/month</p>
            </a>
            <a href="/resources/" class="suggestion-card card-lift">
              <h3>Free Resources</h3>
              <p>Study guides, checklists & worksheets</p>
            </a>
            <a href="/contact/" class="suggestion-card card-lift">
              <h3>Contact Us</h3>
              <p>Book a free diagnostic assessment</p>
            </a>
          </div>
        </div>
      </div>
    </section>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .error-page {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
  }

  /* Watermark "404" — sits on the paper texture in the sand tone */
  .error-bg {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--font-body);
    font-size: clamp(16rem, 30vw, 28rem);
    font-weight: 900;
    color: var(--bg-secondary);
    line-height: 1;
    letter-spacing: -0.04em;
    user-select: none;
    pointer-events: none;
  }

  /* A flex item's automatic min-width is its min-content width, and the
     suggestion grid's auto-fit tracks (sized against its 800px max-width)
     made that ~600px: on phones the whole column was forced to 600px wide,
     centred, and clipped by overflow:hidden on both sides. Fill the row and
     allow shrinking instead. */
  .error-section { position: relative; z-index: 1; width: 100%; min-width: 0; }

  .error-mascot { height: 150px; width: auto; margin: 0 auto 0.75rem; }

  .error-title {
    font-family: var(--font-heading);
    font-size: clamp(2.4rem, 6vw, 3.75rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    line-height: 1;
    margin-bottom: 1rem;
  }

  .error-links a {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-accent-text);
    text-decoration: none;
  }
  .error-links a:hover { text-decoration: underline; }
  /* The middot separators are flex items too, so on every width one ended up
     dangling at the end or start of a wrapped row; the column gap separates
     the links instead. */
  .error-links > span { display: none; }
  /* Touch: the links were 26px tall — give them the site's 40px row */
  @media (pointer: coarse) {
    .error-links a { display: inline-flex; align-items: center; min-height: 40px; }
  }

  /* Landscape phones (~390px tall): shrink the sticker and the headline
     so the headline sits on the first screen, not below it */
  @media (max-height: 500px) and (orientation: landscape) {
    .error-mascot { height: 88px; }
    .error-title { font-size: 2.2rem; margin-bottom: 0.75rem; }
  }

  .suggestion-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin-top: 2rem;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }
  /* Sticker cards — white, 2px ink outline, lift onto a hard shadow (global .card-lift) */
  .suggestion-card {
    background: var(--bg-card);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-md);
    box-shadow: 0 3px 0 var(--ink-shadow);
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
  }
  .suggestion-card h3 {
    color: var(--text-primary);
    margin: 0 0 0.5rem;
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  .suggestion-card p {
    color: var(--text-secondary);
    margin: 0;
    font-size: 0.9rem;
  }
  .suggestions h2 {
    margin-top: 3rem;
  }
</style>
