---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<BaseLayout title="Tuition Programmes | English, Maths, GP & Econs | A-Worthy" description="A-Worthy's programmes: O-Level English & Maths (Sec 1–4), H1 GP & H2 Economics (JC 1–2). Groups of 6, taught with the SHARP Method. From SGD 280/month.">
  <Header slot="header" />

  <!-- ===== PAGE HERO ===== -->
  <section class="prog-hero">
    <div class="container">
      <p class="eyebrow">Programmes</p>
      <h1 class="prog-hero__heading">Singapore tuition <span class="accent-word">programmes</span> for <span class="prog-hero__nobr">O-Level</span> English, Maths, GP &amp; H2 Economics</h1>
      <p class="prog-hero__sub">Every A-Worthy programme is taught with the SHARP Method (See, Hit, Apply, Refine, Practise) in groups of up to 6, online on the A-Worthy Whiteboard, with personalised feedback every session.</p>
      <div class="prog-hero__actions" data-track="hero">
        <a href="/contact/" class="btn btn-accent">Book Free Assessment</a>
      </div>
    </div>
    <img src="/images/mascots/mascot-teacher.webp" alt="" width="560" height="640" class="sticker sticker--hero" />
  </section>

  <!-- ===== PROGRAMME CARDS ===== -->
  <section class="prog-section">
    <div class="container">
      <div class="card-grid card-grid--4">
        <a href="/o-level-english/" class="prog-card card-lift prog-card--link prog-card--subject subject--english">
          <div class="subject-panel" aria-hidden="true">
            <img src="/images/mascots/mascot-grade-a.webp" alt="" width="414" height="553" class="sticker" loading="lazy" />
          </div>
          <div class="prog-card__body">
          <p class="prog-card__eyebrow">Sec 1 &ndash; 4</p>
          <h3 class="prog-card__title">O-Level English</h3>
          <p class="prog-card__desc">Foundation and intensive programmes for Secondary 1&ndash;4 students. Master comprehension, composition, oral, and editing with the SHARP Method.</p>
          <ul class="prog-card__topics">
            <li>Sec 1-2 Foundation &mdash; SGD 280/month</li>
            <li>Sec 3-4 Intensive &mdash; SGD 320/month</li>
            <li>One-to-One &mdash; SGD 120/session</li>
          </ul>
          <div class="prog-card__meta">
            <span class="prog-card__link-text">View O-Level English tuition &rarr;</span>
          </div>
          </div>
        </a>

        <a href="/h1-general-paper/" class="prog-card card-lift prog-card--link prog-card--subject subject--gp">
          <div class="subject-panel" aria-hidden="true">
            <img src="/images/mascots/mascot-lightbulb.webp" alt="" width="399" height="546" class="sticker" loading="lazy" />
          </div>
          <div class="prog-card__body">
          <p class="prog-card__eyebrow">JC 1 &ndash; 2</p>
          <h3 class="prog-card__title">H1 General Paper</h3>
          <p class="prog-card__desc">A-Level GP preparation using the SHARP Method&rsquo;s legal-analytical framework. Build argumentation, critical reading, and essay writing across all 12 content themes.</p>
          <ul class="prog-card__topics">
            <li>JC 1 Foundation &mdash; SGD 360/month</li>
            <li>JC 2 Intensive &mdash; SGD 400/month</li>
            <li>One-to-One &mdash; SGD 140/session</li>
          </ul>
          <div class="prog-card__meta">
            <span class="prog-card__link-text">View H1 General Paper tuition &rarr;</span>
          </div>
          </div>
        </a>

        <a href="/o-level-mathematics/" class="prog-card card-lift prog-card--link prog-card--subject subject--maths prog-card--accent">
          <div class="subject-panel" aria-hidden="true">
            <img src="/images/mascots/mascot-maths.webp" alt="" width="417" height="553" class="sticker" loading="lazy" />
          </div>
          <div class="prog-card__body">
          <p class="prog-card__eyebrow">Sec 1 &ndash; 4</p>
          <h3 class="prog-card__title">O-Level Mathematics</h3>
          <p class="prog-card__desc">Foundation and intensive Mathematics programmes for Secondary 1&ndash;4. Master algebra, geometry, trigonometry, and statistics with the SHARP Method.</p>
          <ul class="prog-card__topics">
            <li>Sec 1-2 Foundation &mdash; SGD 280/month</li>
            <li>Sec 3-4 Intensive &mdash; SGD 320/month</li>
            <li>One-to-One &mdash; SGD 120/session</li>
          </ul>
          <div class="prog-card__meta">
            <span class="prog-card__link-text">View O-Level Mathematics tuition &rarr;</span>
          </div>
          </div>
        </a>

        <a href="/pre-ib-mathematics/" class="prog-card card-lift prog-card--link prog-card--subject subject--preib prog-card--accent">
          <div class="subject-panel" aria-hidden="true">
            <img src="/images/mascots/mascot-graph.webp" alt="" width="418" height="550" class="sticker" loading="lazy" />
          </div>
          <div class="prog-card__body">
          <p class="prog-card__eyebrow">Year 3 &ndash; 4 <span class="chip chip--blue">New</span></p>
          <h3 class="prog-card__title">Pre-IB Mathematics</h3>
          <p class="prog-card__desc">Year 3 &amp; Year 4 pre-IB Mathematics, from indices and surds to logarithms and an introduction to calculus. Taught with the SHARP Method and annotated, line-by-line working.</p>
          <ul class="prog-card__topics">
            <li>Year 3 Foundation &mdash; SGD 280/month</li>
            <li>Year 4 Advanced &mdash; SGD 320/month</li>
            <li>One-to-One &mdash; SGD 120/session</li>
          </ul>
          <div class="prog-card__meta">
            <span class="prog-card__link-text">View Pre-IB Mathematics tuition &rarr;</span>
          </div>
          </div>
        </a>

        <a href="/h2-economics/" class="prog-card card-lift prog-card--link prog-card--subject subject--econ">
          <div class="subject-panel" aria-hidden="true">
            <img src="/images/mascots/mascot-economics.webp" alt="" width="426" height="551" class="sticker" loading="lazy" />
          </div>
          <div class="prog-card__body">
          <p class="prog-card__eyebrow">JC 1 &ndash; 2</p>
          <h3 class="prog-card__title">H2 Economics</h3>
          <p class="prog-card__desc">A-Level Economics preparation covering the full 9570 syllabus, taught with the SHARP Method: precise diagrams, essay technique and case-study answers.</p>
          <ul class="prog-card__topics">
            <li>JC 1 Foundation &mdash; SGD 360/month</li>
            <li>JC 2 Intensive &mdash; SGD 400/month</li>
            <li>One-to-One &mdash; SGD 140/session</li>
          </ul>
          <div class="prog-card__meta">
            <span class="prog-card__link-text">View H2 Economics tuition &rarr;</span>
          </div>
          </div>
        </a>

        <a href="/contact/" class="prog-card card-lift prog-card--link prog-card--subject subject--coaching">
          <div class="subject-panel" aria-hidden="true">
            <img src="/images/mascots/mascot-teacher.webp" alt="" width="560" height="640" class="sticker" loading="lazy" />
          </div>
          <div class="prog-card__body">
          <p class="prog-card__eyebrow">All subjects</p>
          <h3 class="prog-card__title">One-to-One Coaching</h3>
          <p class="prog-card__desc">Fully customised to your child&rsquo;s specific gaps &mdash; comprehension, essay technique, problem sums or exam timing. Individual online sessions on the A-Worthy Whiteboard, scheduled around you.</p>
          <ul class="prog-card__topics">
            <li>O-Level subjects &mdash; SGD 120/session</li>
            <li>JC subjects &mdash; SGD 140/session</li>
            <li>Flexible scheduling, 60&ndash;90 min</li>
          </ul>
          <div class="prog-card__meta">
            <span class="prog-card__link-text">Book a coaching assessment &rarr;</span>
          </div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ===== THE SHARP METHOD ===== -->
  <section class="prog-section" id="lesson-structure">
    <div class="container">
      <p class="eyebrow">Every Lesson</p>
      <h2 class="prog-section__heading squiggle">Inside a SHARP lesson &mdash; the 90 minutes that change how your child thinks</h2>

      <div class="card-grid card-grid--2 card-grid--steps">
        <div class="prog-card card-lift prog-card--step">
          <h3 class="prog-card__title">See</h3>
          <p class="prog-card__desc">Your child learns to read questions the way a lawyer reads a brief &mdash; identifying exactly what is being asked, what type of response is required, and where the marks lie. No more losing marks to misread questions.</p>
        </div>

        <div class="prog-card card-lift prog-card--step">
          <h3 class="prog-card__title">Hit</h3>
          <p class="prog-card__desc">The tutor models the analysis on a live example. Your child then selects the right framework (FLIP/EIL or ACED for English, P-E-E-L for GP, DEED for Economics) and targets the highest-value marks first.</p>
        </div>

        <div class="prog-card card-lift prog-card--step">
          <h3 class="prog-card__title">Apply</h3>
          <p class="prog-card__desc">Your child writes a full response using the claim-evidence-reasoning framework, and the tutor gives feedback on it in the lesson, not a week later.</p>
        </div>

        <div class="prog-card card-lift prog-card--step">
          <h3 class="prog-card__title">Refine</h3>
          <p class="prog-card__desc">Your child self-assesses against the SHARP checklist, then receives process-level feedback: why each error happened and how to fix it. Every answer is revised to exam standard.</p>
        </div>

        <div class="prog-card card-lift prog-card--step">
          <h3 class="prog-card__title">Practise</h3>
          <p class="prog-card__desc">Your child tackles a fresh question independently, applying everything from the lesson. Every session ends with one concrete improvement goal for the week.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== FREE DIAGNOSTIC ASSESSMENT CTA ===== -->
  <section class="prog-cta" data-track="final-cta">
    <div class="container prog-cta__inner">
      <p class="eyebrow">Get Started</p>
      <h2 class="prog-cta__heading">Not sure which programme?</h2>
      <p class="prog-cta__sub">Book a free 20-minute diagnostic assessment. We&rsquo;ll review your child&rsquo;s recent paper and identify specific areas for improvement &mdash; no obligation, no sales pitch.</p>
      <div class="prog-cta__actions">
        <a href="/contact/" class="btn btn-accent prog-cta__btn">Book Free Assessment</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* ===== DESIGN TOKENS ===== */
  :root {
    --prog-bg-card: var(--bg-card);
    --prog-border: var(--border-color);
    --prog-text: var(--text-primary);
    --prog-text-secondary: var(--text-secondary);
    --prog-accent: var(--color-accent);
    --prog-font: var(--font-body);
    --prog-mono: var(--font-mono);
  }

  /* .eyebrow — the global grey micro-label; no page override */

  /* ===== HERO ===== */
  /* Keep the centred copy clear of the hero sticker floating in the right margin */
  .prog-hero .container {
    max-width: 860px;
  }

  /* No page fill on the hero / sections / CTA — the body's paper-dot texture
     is the canvas (LMS) */
  .prog-hero {
    padding: 1.75rem 0;
    text-align: center;
  }

  .prog-hero__heading {
    font-family: var(--prog-font);
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    font-weight: 900;
    line-height: 1.15;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
    letter-spacing: -0.03em;
  }

  /* Keep the compound "O-Level" on one line (the hyphen was a break point) */
  .prog-hero__nobr {
    white-space: nowrap;
  }

  .prog-hero__sub {
    font-family: var(--prog-font);
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--prog-text-secondary);
    max-width: 640px;
    margin: 0 auto;
  }

  .prog-hero__actions {
    display: flex;
    justify-content: center;
    margin-top: 1.5rem;
  }
  /* Below 1280 the sticker sits inline under the copy, so the 860px cap that
     clears the floating sticker only made the hero taller: widen the copy and
     shrink the sticker so the first programme card reaches the first screen */
  @media (min-width: 769px) and (max-width: 1279px) {
    .prog-hero .container { max-width: 1000px; }
    .prog-hero__sub { max-width: 46rem; }
    .prog-hero .sticker--hero { width: 96px; margin-top: 0.75rem; }
  }

  /* ===== NAV ===== */
  .prog-nav {
    background: var(--bg-primary);
    border-bottom: 1px solid var(--prog-border);
    padding: 1.25rem 0;
    position: sticky;
    top: 0;
    z-index: var(--z-subject-selector);
    /* Allow horizontal scroll on small screens */
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    /* Hide scrollbar */
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .prog-nav::-webkit-scrollbar {
    display: none;
  }

  .prog-nav__inner {
    display: flex;
    justify-content: center;
    gap: 2rem;
    flex-wrap: nowrap;
    min-width: max-content;
  }

  .prog-nav__link {
    font-family: var(--prog-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--prog-text-secondary);
    text-decoration: none;
    padding: 0.4rem 0;
    border-bottom: 1px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .prog-nav__link:hover {
    color: var(--prog-text);
    border-bottom-color: var(--prog-accent);
  }

  /* ===== SECTIONS ===== */
  .prog-section {
    padding: 1.75rem 0;
    scroll-margin-top: var(--nav-offset);
  }

  .prog-section + .prog-section {
    border-top: 1px solid var(--prog-border);
  }

  .prog-section__heading {
    font-family: var(--prog-font);
    font-size: clamp(1.8rem, 3.5vw, 2.4rem);
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
    letter-spacing: -0.03em;
  }

  .prog-section__sub {
    font-family: var(--prog-font);
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--prog-text-secondary);
    max-width: 600px;
    margin-bottom: 1.5rem;
  }

  /* ===== CARD GRID ===== */
  .card-grid {
    display: grid;
    gap: 1rem;
  }

  .card-grid--1 {
    grid-template-columns: 1fr;
    max-width: 640px;
  }

  .card-grid--2 {
    grid-template-columns: repeat(2, 1fr);
  }

  .card-grid--3 {
    grid-template-columns: repeat(3, 1fr);
  }

  .card-grid--4 {
    grid-template-columns: repeat(3, 1fr);
  }

  /* ===== PROGRAMME CARD — white sticker, ink outline, lifts on hover ===== */
  .prog-card {
    background: var(--bg-card);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    transition: transform 0.22s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.22s ease;
    display: flex;
    flex-direction: column;
  }

  /* Subject cards (LMS "Your subjects"): sticker on its pastel panel, body below */
  .prog-card.prog-card--subject {
    padding: 0;
    overflow: hidden;
  }
  .prog-card__body {
    padding: 1.1rem 1.25rem 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  /* Fixed sticker height so every panel is the same height regardless of each
     pose's aspect ratio (the teacher sticker is squarer than the subject set) */
  .prog-card--subject .subject-panel img {
    height: 200px;
    width: auto;
    max-width: 60%;
    object-fit: contain;
  }

  .prog-card__title {
    font-family: var(--prog-font);
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }

  .prog-card__desc {
    font-family: var(--prog-font);
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
  }

  .prog-card__topics {
    list-style: none;
    padding: 0;
    margin: 0 0 auto;
    flex-grow: 1;
  }

  .prog-card__topics li {
    font-family: var(--prog-font);
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--prog-text-secondary);
    padding: 0.45rem 0;
    border-bottom: 1px solid var(--border-color);
    padding-left: 1rem;
    position: relative;
  }

  .prog-card__topics li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 0.85rem;
    height: 0.85rem;
    background: url('/images/mascots/mascot-heart-alt-icon.webp') center / contain no-repeat;
    transform: translateY(-50%);
  }

  .prog-card__topics li:last-child {
    border-bottom: none;
  }

  .prog-card__meta {
    display: flex;
    gap: 1.25rem;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--prog-border);
    flex-wrap: wrap;
  }

  .prog-card__meta span {
    font-family: var(--prog-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--prog-text-secondary);
  }

  .prog-card__fee {
    font-family: var(--prog-font);
    font-size: 1rem;
    font-weight: 800;
    color: var(--color-accent-text);
    margin-top: 0.75rem;
    margin-bottom: 0;
  }

  /* ===== HUB CARD VARIANTS ===== */
  .prog-card--link {
    text-decoration: none;
    cursor: pointer;
  }

  /* .prog-card--accent: the "New" cards keep the default ink outline; the
     .chip--blue in the eyebrow carries the emphasis instead */

  .prog-card__eyebrow {
    /* Same height whether it holds text or a "New" chip, so titles line up across a row */
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 1.75rem;
    font-family: var(--prog-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--prog-text-secondary);
    margin-bottom: 0.5rem;
  }

  /* The link line is an action, not a label — red, chunky, sentence case */
  .prog-card__meta .prog-card__link-text {
    color: var(--color-accent-text);
    font-weight: 800;
    font-size: 0.9rem;
    letter-spacing: 0;
    text-transform: none;
  }

  /* ===== SHARP STEP CARDS (numbered sequence) ===== */
  .card-grid--steps {
    counter-reset: sharp-step;
  }

  .prog-card--step {
    position: relative;
    counter-increment: sharp-step;
  }

  /* Numbered badge — red sticker dot with the ink outline */
  .prog-card--step::before {
    content: counter(sharp-step);
    position: absolute;
    top: 1.1rem;
    right: 1.1rem;
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    font-family: var(--prog-mono);
    font-size: 0.85rem;
    font-weight: 800;
    color: #fff;
    background: var(--color-accent);
    border: 2px solid var(--color-ink);
  }

  .prog-card--step .prog-card__title {
    padding-right: 2.4rem;
  }

  /* Step copy: no trailing gap under the last line (the card padding already
     closes the card — the extra 1.25rem made every step bottom-heavy), and a
     readable measure when a card runs wide (full-row card on tablets, 2560).
     60ch ≈ 80 characters in Nunito, whose "0" is unusually wide */
  .prog-card--step .prog-card__desc {
    margin-bottom: 0;
    max-width: 60ch;
  }

  /* ===== CTA ===== */
  .prog-cta {
    border-top: 1px solid var(--prog-border);
    padding: 1.75rem 0;
  }

  .prog-cta__inner {
    text-align: center;
    /* rem, not px: the container padding scales with the root font on large
       desktops, so a px cap squeezed the copy to ~456px at 1920 and broke the
       heading over two lines */
    max-width: 38rem;
    margin: 0 auto;
  }

  .prog-cta__heading {
    font-family: var(--prog-font);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 1rem;
    letter-spacing: -0.03em;
  }

  .prog-cta__sub {
    font-family: var(--prog-font);
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--prog-text-secondary);
    margin-bottom: 1.25rem;
  }

  .prog-cta__actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* Look comes from the global .btn.btn-accent — size only here */
  .prog-cta__btn {
    padding: 0.85rem 1.9rem;
  }

  /* ===== PROGRAMME PLACEHOLDER ===== */
  .prog-placeholder {
    background: var(--bg-secondary);
    border: 1px dashed var(--border-color);
    border-radius: var(--border-radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 1024px) {
    .card-grid--4 {
      grid-template-columns: repeat(2, 1fr);
    }

    .card-grid--3 {
      grid-template-columns: repeat(2, 1fr);
    }

    .card-grid--2 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Programme cards stay two-up on tablet portrait; single column only on phones */
  @media (max-width: 600px) {
    .card-grid--4,
    .card-grid--3 {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .prog-hero {
      padding: 3rem 0 2.25rem;
    }

    .prog-section {
      padding: 1.75rem 0;
    }

    .prog-nav__inner {
      gap: 1rem;
    }

    .card-grid--2 {
      grid-template-columns: 1fr;
    }

    .prog-card {
      padding: 1.25rem;
    }

    .prog-cta {
      padding: 1.25rem 0;
    }
  }

  @media (max-width: 480px) {
    .prog-hero__heading {
      font-size: 1.8rem;
    }

    .prog-nav__inner {
      gap: 0.6rem;
    }

    .prog-nav__link {
      font-size: 0.75rem;
    }

    .prog-cta__actions {
      flex-direction: column;
      align-items: center;
    }

    .prog-cta__btn {
      width: 100%;
      text-align: center;
    }
  }

  /* Tablet landscape and up: card copy at the 15px body floor */
  @media (min-width: 1024px) {
    .prog-card__desc {
      font-size: 0.95rem;
    }
  }

  /* SHARP steps — five cards, never an orphan. Two-up tablets let the odd
     last card run the full row; laptops and up set them 3 + 2 on a six-track
     grid. (Phones are one column, where spanning 1 / -1 is a no-op.) */
  @media (max-width: 1024px) {
    .card-grid--steps > .prog-card--step:last-child:nth-child(odd) {
      grid-column: 1 / -1;
