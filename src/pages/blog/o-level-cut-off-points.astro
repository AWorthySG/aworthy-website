              <tr><td>Hwa Chong Institution (HCI)</td><td>3</td><td>5</td></tr>
              <tr><td>Eunoia Junior College (EJC)</td><td>5</td><td>6</td></tr>
              <tr><td>Nanyang Junior College (NYJC)</td><td>5</td><td>7</td></tr>
