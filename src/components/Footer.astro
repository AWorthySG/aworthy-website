<style>
  /* Light footer — the LMS has no dark band; the page simply ends on a
     sand-coloured strip with an ink rule across the top. */
  .site-footer {
    background: var(--bg-footer);
    border-top: 2px solid var(--color-ink);
    padding: 3rem 0 2rem;
    /* Safe area for notched devices */
    padding-bottom: calc(2rem + env(safe-area-inset-bottom, 0px));
    color: var(--text-secondary);
    position: relative;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
    gap: var(--space-2xl);
    margin-bottom: var(--space-3xl);
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    margin-bottom: var(--space-md);
  }

  .footer-logo-img {
    height: 80px;
    width: auto;
    flex-shrink: 0;
  }

  .footer-logo-words {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }

  .footer-logo-text {
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }

  .footer-logo-sub {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .footer-tagline {
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 30ch;
    margin-bottom: var(--space-md);
  }

  .footer-socials {
    display: flex;
    gap: 0.5rem;
    margin-top: var(--space-sm);
  }

  .footer-socials a {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-card);
    border: 2px solid var(--color-ink);
    color: var(--text-primary);
    box-shadow: 0 3px 0 var(--ink-shadow);
    transition: background-color var(--transition-fast), transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .footer-socials a:hover {
    background: var(--color-accent-soft);
    color: var(--color-accent-text);
    transform: translateY(-2px);
    box-shadow: 0 5px 0 var(--ink-shadow);
    opacity: 1;
  }

  .footer-links h4,
  .footer-contact h4 {
    font-family: var(--font-mono);
    color: var(--text-primary);
    margin-bottom: var(--space-md);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 800;
  }

  /* Marker swash under footer column headings — same motif as section titles */
  .footer-links h4::after,
  .footer-contact h4::after {
    content: '';
    display: block;
    width: 44px;
    height: 8px;
    margin-top: 0.45rem;
    background: var(--swash) left center / contain no-repeat;
  }

  .footer-links ul,
  .footer-contact ul {
    list-style: none;
    padding: 0;
  }

  .footer-links li,
  .footer-contact li {
    margin-bottom: var(--space-sm);
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .footer-links a,
  .footer-contact a {
    color: var(--text-secondary);
    display: inline-block;
    padding: 0.2rem 0;
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .footer-links a:hover,
  .footer-contact a:hover {
    color: var(--color-accent-text);
    transform: translateX(3px);
    opacity: 1;
  }

  /* Touch screens: every footer link is a full 40px target (the site's
     standard; they measured 29px), with the list spacing tightened by the
     same amount so the footer does not grow. */
  @media (pointer: coarse) {
    .footer-links li,
    .footer-contact li { margin-bottom: 0.2rem; }
    .footer-links a,
    .footer-contact a { display: inline-flex; align-items: center; min-height: 40px; padding: 0; }
  }

  .footer-bottom {
    border-top: 2px dashed var(--ink-faint);
    padding-top: 1.5rem;
    margin-top: 2.5rem;
    font-size: 0.8rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-bottom p {
    color: var(--text-secondary);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    margin-bottom: 0;
  }

  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }
    .footer-bottom {
      flex-direction: column;
      text-align: center;
      gap: var(--space-xs);
    }
  }
</style>
