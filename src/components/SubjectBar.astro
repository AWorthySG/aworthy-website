---
const currentPath = Astro.url.pathname;
const subjects = [
  { href: '/o-level-english/', label: 'O-Level English', short: 'English', level: 'Sec 1–4', subject: 'english' },
  { href: '/h1-general-paper/', label: 'H1 General Paper', short: 'GP', level: 'JC 1–2', subject: 'gp' },
  { href: '/h2-economics/', label: 'H2 Economics', short: 'Economics', level: 'JC 1–2', subject: 'econ' },
  { href: '/o-level-mathematics/', label: 'O-Level Mathematics', short: 'Maths', level: 'Sec 1–4', subject: 'maths' },
  { href: '/pre-ib-mathematics/', label: 'Pre-IB Mathematics', short: 'Pre-IB Maths', level: 'Year 3–4', subject: 'preib' },
];
---

<nav class="subject-bar" aria-label="Subject navigation">
  <div class="subject-bar-inner">
    <span class="subject-bar-label">Programmes</span>
    <div class="subject-bar-options">
      {subjects.map(s => (
        <a
          href={s.href}
          class:list={['subject-bar-link', `subject--${s.subject}`, { 'is-active': currentPath.startsWith(s.href) }]}
          title={`${s.label} · ${s.level}`}
        >
          <span class="subject-dot" aria-hidden="true"></span>
          <span class="subject-bar-name">{s.label}</span>
          <span class="subject-bar-name--short">{s.short}</span>
          <span class="subject-bar-level">{s.level}</span>
        </a>
      ))}
    </div>
  </div>
</nav>

<style>
  .subject-bar {
    position: fixed;
    top: var(--header-height);
    left: 0;
    right: 0;
    z-index: var(--z-subject-bar);
    background: rgba(250, 246, 238, 0.86);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-color);
  }

  .subject-bar-inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--space-xl);
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    height: 44px;
  }

  .subject-bar-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .subject-bar-options {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
  }

  .subject-bar-options::-webkit-scrollbar {
    display: none;
  }

  .subject-bar-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.9rem;
    min-height: 40px;
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--text-secondary);
    text-decoration: none;
    background: var(--bg-card);
    border: 1.5px solid var(--ink-faint);
    border-radius: 100px;
    white-space: nowrap;
    transition: background-color 0.12s ease, border-color 0.12s ease, color 0.12s ease;
  }

  .subject-bar-link:hover {
    color: var(--text-primary);
    border-color: var(--color-ink);
    background: var(--bg-hover);
    opacity: 1;
  }

  :global([data-theme="dark"]) .subject-bar {
    background: rgba(23, 22, 20, 0.85);
  }

  /* Active chip takes its subject's colour (LMS sidebar dots) */
  .subject-bar-link.is-active {
    color: var(--subject-accent-text);
    border-color: var(--subject-accent);
    background: var(--subject-tint);
    font-weight: 800;
  }

  .subject-bar-name--short {
    display: none;
  }

  /* Level labels ("Sec 1–4") made the five chips overflow the 1200px container at
     every desktop width (the row scrolled sideways with no hint and the last chip was
     cut mid-word). Like the LMS sidebar, the bar is names + dots; the level lives in
     the link's title and on every programme card. */
  .subject-bar-level {
    display: none;
  }

  /* Tablets: short names so the row still fits without scrolling */
  @media (min-width: 641px) and (max-width: 1024px) {
    .subject-bar-name { display: none; }
    .subject-bar-name--short { display: inline; }
  }

  @media (max-width: 640px) {
    .subject-bar {
      display: none;
    }
  }
</style>

