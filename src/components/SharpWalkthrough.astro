---
// Interactive walkthrough of the SHARP Method — uses the WAI-ARIA
// tabs pattern (role="tablist" / role="tab" / role="tabpanel" with
// arrow-key navigation). No external deps.

const steps = [
  {
    letter: 'S',
    name: 'See',
    summary: 'Identify the question type — and what the examiner is actually rewarding — before writing a single word.',
    example: 'A comprehension question contains the word "suggest" → it\'s an inference question, not a literal lookup. Different question type, different tool.'
  },
  {
    letter: 'H',
    name: 'Hit',
    summary: 'Pick the named, paper-matched framework built for that question type.',
    example: 'Inference → EIL (Evidence + Implication + Link). GP body paragraph → P-E-E-L. Trigonometry → RULE. The right tool for the job, every time.'
  },
  {
    letter: 'A',
    name: 'Apply',
    summary: 'Execute the framework with full, line-by-line working — banking method marks even when the final answer slips.',
    example: 'Quote the evidence, then interpret it. Or write each algebraic step on its own line. The marker can\'t award what they can\'t see.'
  },
  {
    letter: 'R',
    name: 'Refine',
    summary: 'Targeted feedback closes the specific gap that\'s costing marks — the bit a textbook can\'t do.',
    example: 'A student keeps quoting evidence but never interpreting it. Two lessons of focused feedback fixes the habit permanently.'
  },
  {
    letter: 'P',
    name: 'Practise',
    summary: 'Spaced retrieval over weeks turns the framework into instinct — so it survives the pressure of exam day.',
    example: 'Five timed comprehension questions a week, marked against the rubric. By the prelims, the framework is automatic.'
  }
];
---

<section class="sharp-walk" aria-labelledby="sharp-walk-heading">
  <div class="container">
    <span class="eyebrow" data-animate="reveal-up">The Method, Interactive</span>
    <h2 id="sharp-walk-heading" class="squiggle" data-animate="reveal-up">Walk through SHARP, one step at a time</h2>
    <p class="sharp-walk__sub" data-animate="reveal-up">Click each letter to see what your child does at that step &mdash; with a concrete example. Use the arrow keys to step through.</p>

    <div class="sharp-walk__tabs" role="tablist" aria-label="SHARP method steps">
      {steps.map((step, i) => (
        <button
          role="tab"
          id={`sharp-tab-${i}`}
          aria-controls={`sharp-panel-${i}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          class:list={['sharp-walk__tab', i === 0 && 'is-active']}
          data-index={i}
          type="button"
        >
          <span class="sharp-walk__tab-letter">{step.letter}</span>
          <span class="sharp-walk__tab-name">{step.name}</span>
        </button>
      ))}
    </div>

    <div class="sharp-walk__panels">
      {steps.map((step, i) => (
        <div
          role="tabpanel"
          id={`sharp-panel-${i}`}
          aria-labelledby={`sharp-tab-${i}`}
          class:list={['sharp-walk__panel', i === 0 && 'is-active']}
          tabindex="0"
          hidden={i !== 0}
        >
          <h3 class="sharp-walk__panel-heading">{step.letter} &mdash; {step.name}</h3>
          <p class="sharp-walk__panel-summary">{step.summary}</p>
          <div class="sharp-walk__panel-example">
            <span class="sharp-walk__panel-example-label">Example</span>
            <p>{step.example}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Cream, so the band alternates with the sand "Our values" section above it */
  .sharp-walk { padding: 2rem 0; background: var(--bg-primary); }
  /* Same heading scale as the page's other section h2s (about.astro .section h2),
     with breathing room between the squiggle and the subtitle */
  .sharp-walk h2 {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0 0 1.25rem;
    max-width: 600px;
  }
  .sharp-walk__sub { font-size: 1rem; color: var(--text-secondary); margin-bottom: 1.5rem; max-width: 640px; }

  /* Tabs — the LMS segmented control (track = muted well, active = red pill) */
  .sharp-walk__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    padding: 4px;
    margin-bottom: 1.25rem;
    background: var(--bg-muted);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-pill);
  }
  .sharp-walk__tab {
    flex: 1 1 110px;
    min-width: 90px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.45rem 0.9rem;
    background: transparent;
    border: 2px solid transparent;
    border-radius: var(--radius-pill);
    color: var(--text-secondary);
    cursor: pointer;
    font-family: var(--font-body);
    touch-action: manipulation;
    transition: background-color 0.12s ease, color 0.12s ease, border-color 0.12s ease;
  }
  @media (hover: hover) {
    .sharp-walk__tab:not(.is-active):hover { background: var(--bg-hover); color: var(--text-primary); }
  }
  .sharp-walk__tab:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .sharp-walk__tab.is-active {
    background: var(--color-accent);
    border-color: var(--color-ink);
    color: #fff;
  }
  /* Step badge — red circle with an ink ring; inverts on the active tab */
  .sharp-walk__tab-letter {
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--color-accent);
    border: 2px solid var(--color-ink);
    color: #fff;
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 900;
    line-height: 1;
    flex-shrink: 0;
  }
  .sharp-walk__tab.is-active .sharp-walk__tab-letter {
    background: #fff;
    color: var(--color-accent);
  }
  .sharp-walk__tab-name {
    font-size: 0.9rem;
    font-weight: 800;
    color: inherit;
  }

  /* Panels — white ink cards */
  .sharp-walk__panel {
    background: var(--bg-card);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-md);
    box-shadow: 0 3px 0 var(--ink-shadow);
    padding: 1.5rem;
  }
  .sharp-walk__panel:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .sharp-walk__panel-heading {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin: 0 0 0.5rem;
  }
  .sharp-walk__panel-summary {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }
  .sharp-walk__panel-example {
    padding: 0.85rem 1rem;
    background: var(--bg-muted);
    border: 2px dashed var(--ink-faint);
    border-radius: var(--radius-sm);
  }
  .sharp-walk__panel-example-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    display: block;
    margin-bottom: 0.3rem;
  }
  .sharp-walk__panel-example p {
    margin: 0;
    color: var(--text-primary);
    font-size: 0.92rem;
    line-height: 1.55;
  }
  @media (max-width: 540px) {
    .sharp-walk__tabs { border-radius: var(--radius-md); }
    .sharp-walk__tab { padding: 0.4rem 0.6rem; gap: 0.4rem; }
    .sharp-walk__tab-letter { width: 24px; height: 24px; font-size: 0.85rem; }
    .sharp-walk__tab-name { font-size: 0.8rem; }
  }
</style>

<script>
  function initSharpWalk() {
    var tabs = Array.prototype.slice.call(document.querySelectorAll('.sharp-walk__tab'));
    var panels = Array.prototype.slice.call(document.querySelectorAll('.sharp-walk__panel'));
    if (!tabs.length || !panels.length) return;

    function activate(idx) {
      tabs.forEach(function (t, i) {
        var active = i === idx;
        t.classList.toggle('is-active', active);
        t.setAttribute('aria-selected', active ? 'true' : 'false');
        t.setAttribute('tabindex', active ? '0' : '-1');
      });
      panels.forEach(function (p, i) {
        var active = i === idx;
        p.classList.toggle('is-active', active);
        p.hidden = !active;
      });
    }

    tabs.forEach(function (tab, i) {
      tab.onclick = function () { activate(i); };
      tab.onkeydown = function (e) {
        var next = null;
        if (e.key === 'ArrowRight') next = (i + 1) % tabs.length;
        else if (e.key === 'ArrowLeft') next = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = tabs.length - 1;
        if (next !== null) {
          e.preventDefault();
          activate(next);
          tabs[next].focus();
        }
      };
    });
  }

  initSharpWalk();
</script>
