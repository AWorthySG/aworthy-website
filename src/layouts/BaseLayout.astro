    "name": "Tuition Programmes",
    "itemListElement": [
      {"@type": "Offer", "itemOffered": {"@type": "Course", "name": "O-Level English Tuition Singapore", "courseCode": "1184", "inLanguage": "en-SG", "description": "Secondary 1–4 O-Level English tuition with the SHARP Method. Small groups of 6, online on the A-Worthy Whiteboard."}, "price": "280", "priceCurrency": "SGD"},
      {"@type": "Offer", "itemOffered": {"@type": "Course", "name": "H1 General Paper Tuition Singapore", "courseCode": "8881", "inLanguage": "en-SG", "description": "JC 1–2 H1 GP tuition with the SHARP Method. Essay argumentation, comprehension and AQ mastery."}, "price": "360", "priceCurrency": "SGD"},
      {"@type": "Offer", "itemOffered": {"@type": "Course", "name": "H2 Economics Tuition Singapore", "courseCode": "9570", "inLanguage": "en-SG", "description": "JC 1–2 H2 Economics tuition with the SHARP Method. Diagram precision, essay technique, and case study mastery."}, "price": "360", "priceCurrency": "SGD"},
      {"@type": "Offer", "itemOffered": {"@type": "Course", "name": "O-Level Mathematics Tuition Singapore", "courseCode": "4052", "inLanguage": "en-SG", "description": "Secondary 1–4 O-Level Mathematics tuition with the SHARP Method. Small groups of 6, online on the A-Worthy Whiteboard."}, "price": "280", "priceCurrency": "SGD"},
      {"@type": "Offer", "itemOffered": {"@type": "Course", "name": "Pre-IB Mathematics Tuition (Year 3 & Year 4)", "inLanguage": "en-SG", "description": "Year 3–4 Pre-IB Mathematics tuition with the SHARP Method. Indices to introductory calculus, with annotated line-by-line working. Small groups of 6, online on the A-Worthy Whiteboard."}, "price": "280", "priceCurrency": "SGD"}
    ]
  }
