  <script is:inline>
  (function(){
    function init() {
      var notice = document.getElementById('privacy-notice');
      var btn = document.getElementById('privacy-accept');
      if (!notice || !btn) return;
      var accepted = null;
      try { accepted = localStorage.getItem('privacy-accepted'); } catch (e) {}
      if (accepted) return;
      notice.hidden = false;
      // Report the notice's height so the WhatsApp/chatbot/back-to-top floats
      // sit above it instead of on top of its text and buttons.
      function report() { window.aworthyBottomBar('privacy', notice.hidden ? 0 : notice.offsetHeight); }
      report();
      // The notice appears on idle (up to 3s after load). A visitor who has
      // already scrolled has a sticky CTA showing; the CTAs only re-check the
      // notice on scroll, so nudge them now or both bars stack until the next one.
      window.dispatchEvent(new Event('scroll'));
      window.addEventListener('resize', report, { passive: true });
      btn.addEventListener('click', function() {
        try { localStorage.setItem('privacy-accepted', '1'); } catch (e) {}
        notice.hidden = true;
        window.removeEventListener('resize', report);
        window.aworthyBottomBar('privacy', 0);
      });
    }
    if ('requestIdleCallback' in window) requestIdleCallback(init, { timeout: 3000 });
    else setTimeout(init, 1500);
  })();
  </script>

  <script is:inline>
  (function(){
    var bar = document.getElementById('scroll-progress');
    if (!bar) return;
    var ticking = false;
    window.addEventListener('scroll', function() {
      if (!ticking) {
        requestAnimationFrame(function() {
          var scrollTop = window.scrollY;
          var docHeight = document.documentElement.scrollHeight - window.innerHeight;
          bar.style.width = (docHeight > 0 ? (scrollTop / docHeight) * 100 : 0) + '%';
          ticking = false;
        });
        ticking = true;
      }
    });
  })();
  </script>

