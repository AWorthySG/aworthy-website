  <script is:inline>
  (function(){
    // Defer setup until the browser is idle — this widget has a 45s timer
    // before it actually fires, so there's no benefit to running its init
    // during the critical render path.
    function init() {
      var popup = document.getElementById('email-popup');
      var closeBtn = document.getElementById('email-popup-close');
      var form = document.getElementById('email-popup-form');
      if (!popup) return;

      // Don't show if already dismissed or on contact page
      var dismissed = null;
      try { dismissed = localStorage.getItem('email-popup-dismissed'); } catch (e) { return; } // can't remember a dismissal: don't nag
      if (dismissed) return;
      if (window.location.pathname.indexOf('/contact') > -1) return;

      function showPopup() {
      popup.hidden = false;
      document.body.style.overflow = 'hidden';
      if (closeBtn) closeBtn.focus();
    }

    function hidePopup() {
      popup.hidden = true;
      document.body.style.overflow = '';
      try { localStorage.setItem('email-popup-dismissed', '1'); } catch (e) {}
    }

    // Show after 45 seconds
    var timer = setTimeout(showPopup, 45000);

    // Or on exit intent (mouse leaves viewport)
    document.addEventListener('mouseout', function(e) {
      if (e.clientY < 5 && popup.hidden) {
        clearTimeout(timer);
        showPopup();
      }
    }, { once: true });

    closeBtn.addEventListener('click', hidePopup);
    popup.addEventListener('click', function(e) { if (e.target === popup) hidePopup(); });
    document.addEventListener('keydown', function(e) { if (e.key === 'Escape' && !popup.hidden) hidePopup(); });

    form.addEventListener('submit', function(e) {
      e.preventDefault();
      var input = form.querySelector('input');
      var email = ((input && input.value) || '').trim();
      var submitBtn = form.querySelector('button[type="submit"]');
      var PDF_URL = '/docs/samples/essay-framework-sample.pdf';

      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        if (input) { input.setAttribute('aria-invalid', 'true'); input.focus(); }
        return;
      }
      if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Sending…'; }

      function deliver() {
        // Honour the promise: open the framework now, with a reliable fallback link.
        try { window.open(PDF_URL, '_blank', 'noopener'); } catch (err) {}
        if (window.plausible) window.plausible('Lead: Email Popup');
        if (window.aworthyCelebrate) window.aworthyCelebrate();
        form.innerHTML = '<p style="text-align:center;color:var(--color-accent);font-weight:500;">' +
          'Your SHARP essay framework is opening in a new tab. If it doesn’t, ' +
          '<a href="' + PDF_URL + '" target="_blank" rel="noopener" style="color:var(--color-accent);text-decoration:underline;">download it here</a>. ' +
          'We’ll also email you the full version shortly.</p>';
        try { localStorage.setItem('email-popup-dismissed', '1'); } catch (e) {}
        setTimeout(hidePopup, 6000);
      }

      fetch('https://formspree.io/f/xreoozkk', {
        method: 'POST',
        headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: email, resource: 'SHARP Essay Writing Framework', _subject: 'Email popup lead — SHARP essay framework' })
      }).then(function(res) {
        if (!res.ok) throw new Error('submit-failed');
        deliver();
      }).catch(function() {
        // Don't block the visitor on a Formspree outage — still deliver the framework.
        deliver();
      });
    });
    }
    if ('requestIdleCallback' in window) requestIdleCallback(init, { timeout: 5000 });
    else setTimeout(init, 2000);
  })();
  </script>


