    <div class="chatbot-panel" id="chatbot-panel" role="dialog" aria-modal="true" aria-labelledby="chatbot-title" hidden>
      <div class="chatbot-header">
        <span class="chatbot-header-brand">
          <img src="/images/logo.webp" alt="" class="chatbot-header-img" width="240" height="273" />
          <strong id="chatbot-title">A-Worthy Help</strong>
        </span>
        <button class="chatbot-close" id="chatbot-close" aria-label="Close">&times;</button>
      </div>
      <div class="chatbot-body" id="chatbot-body">
        <div class="chatbot-msg chatbot-msg--bot">Hi! I can help answer common questions. What would you like to know?</div>
        <div class="chatbot-options" id="chatbot-options">
          <button class="chatbot-option" data-q="pricing">How much does it cost?</button>
          <button class="chatbot-option" data-q="schedule">What are the class schedules?</button>
          <button class="chatbot-option" data-q="method">What is the SHARP Method?</button>
          <button class="chatbot-option" data-q="enrol">How do I enrol?</button>
          <button class="chatbot-option" data-q="trial">Can I try a free lesson?</button>
          <button class="chatbot-option" data-q="online">Are classes online or in-person?</button>
          <button class="chatbot-option" data-q="classsize">What are the class sizes?</button>
          <button class="chatbot-option" data-q="results">What results do your students get?</button>
          <button class="chatbot-option" data-q="tutor">Who is the tutor?</button>
          <button class="chatbot-option" data-q="subjects">What subjects do you teach?</button>
          <button class="chatbot-option" data-q="location">Where are you located?</button>
          <button class="chatbot-option" data-q="resources">Do you have any free resources?</button>
          <button class="chatbot-option" data-q="refund">What's the refund policy?</button>
          <button class="chatbot-option" data-q="contact">How do I contact you?</button>
          <button class="chatbot-option" data-q="schools">What schools do your students come from?</button>
        </div>
      </div>
    </div>
  </div>

  <style>
    .chatbot-widget {
      position: fixed;
      bottom: calc(2rem + 68px + var(--sticky-bar-h, 0px) + env(safe-area-inset-bottom, 0px));
      right: calc(2rem + env(safe-area-inset-right, 0px));
      z-index: var(--z-chatbot);
      transition: bottom 0.35s ease;
    }
    .chatbot-toggle {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: var(--bg-card);
      color: var(--text-primary);
      border: 2px solid var(--color-ink);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: 0 4px 0 var(--ink-shadow);
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .chatbot-toggle:hover { transform: translateY(-2px); box-shadow: 0 6px 0 var(--ink-shadow); }
    .chatbot-toggle:active { transform: translateY(2px); box-shadow: 0 1px 0 var(--ink-shadow); }
    .chatbot-toggle-img {
      height: 34px;
      width: auto;
    }
    .chatbot-panel {
      position: absolute;
      bottom: 56px;
      right: 0;
      width: 320px;
      max-height: 520px;
      background: var(--bg-card);
      border: 2px solid var(--color-ink);
      border-radius: var(--radius-md);
      box-shadow: 0 6px 0 var(--ink-shadow), 0 16px 32px rgba(70, 50, 20, 0.14);
      display: none;
      flex-direction: column;
      overflow: hidden;
    }
    .chatbot-panel[hidden] {
      display: none;
    }
    .chatbot-panel:not([hidden]) {
      display: flex;
    }
    .chatbot-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.75rem 1rem;
      background: #22304A;
      color: #F0EEE8;
      font-size: 0.85rem;
      font-weight: 800;
    }
    .chatbot-header-brand {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .chatbot-header-img {
      height: 26px;
      width: auto;
      flex-shrink: 0;
    }
    .chatbot-close {
      background: none;
      border: none;
      color: rgba(255,255,255,0.7);
      font-size: 1.2rem;
      cursor: pointer;
      min-width: 44px;
      min-height: 44px;
      display: flex;
      align-items: center;
      justify-content: center;
      touch-action: manipulation;
    }
    .chatbot-body {
      flex: 1;
      overflow-y: auto;
      padding: 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      max-height: 460px;
    }
    .chatbot-msg {
      padding: 0.6rem 0.85rem;
      border-radius: var(--radius-md);
      font-size: 0.82rem;
      line-height: 1.5;
      max-width: 85%;
    }
    .chatbot-msg a { color: var(--color-accent-text); font-weight: 700; }
    .chatbot-msg--bot {
      background: var(--bg-muted);
      color: var(--text-primary);
      align-self: flex-start;
      border-bottom-left-radius: 4px;
    }
    .chatbot-msg--user {
      background: var(--color-accent);
      color: #fff;
      align-self: flex-end;
      border-bottom-right-radius: 4px;
    }
    .chatbot-options {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      margin-top: 0.5rem;
    }
    .chatbot-option {
      text-align: left;
      padding: 0.5rem 0.75rem;
      border: 1.5px solid var(--ink-faint);
      border-radius: var(--radius-sm);
      background: var(--bg-card);
      color: var(--text-primary);
      font-size: 0.78rem;
      font-weight: 700;
      cursor: pointer;
      font-family: var(--font-body);
      transition: all 0.12s ease;
    }
    .chatbot-option:hover {
      border-color: var(--color-accent);
      background: var(--color-accent-soft);
      color: var(--color-accent-text);
    }
    @media (max-width: 768px) {
      .chatbot-widget { right: calc(1rem + env(safe-area-inset-right, 0px)); bottom: calc(1.25rem + 68px + var(--sticky-bar-h, 0px) + env(safe-area-inset-bottom, 0px)); }
    }
    @media (max-width: 480px) {
      .chatbot-panel { width: calc(100vw - 2rem); right: -1rem; }
      .chatbot-widget { bottom: calc(1.25rem + 64px + var(--sticky-bar-h, 0px) + env(safe-area-inset-bottom, 0px)); }
    }
  </style>

  <script is:inline>
  (function(){
    function init() {
    var toggle = document.getElementById('chatbot-toggle');
    var panel = document.getElementById('chatbot-panel');
    var close = document.getElementById('chatbot-close');
    var body = document.getElementById('chatbot-body');
    var opts = document.getElementById('chatbot-options');
    if (!toggle || !panel) return;

    var answers = {
      pricing: 'O-Level English: SGD 280\u2013320/month. O-Level Maths: SGD 280\u2013320/month. H1 GP: SGD 360\u2013400/month. H2 Economics: SGD 360\u2013400/month. 1-to-1: SGD 120\u2013140/session. <a href="/pricing/">View full pricing \u2192</a>',
      schedule: 'Classes run Mon\u2013Fri 2pm\u20139:30pm and Sat\u2013Sun 9am\u20136pm. All sessions run live on the A-Worthy Whiteboard. <a href="/contact/">Contact us for available slots \u2192</a>',
      method: 'The SHARP Method is our proprietary 5-step system: See, Hit, Apply, Refine, Practise. Adapted from legal reasoning, it teaches students how to think systematically. <a href="/programmes/">Learn more \u2192</a>',
      enrol: 'Step 1: Book a free diagnostic assessment. Step 2: Get a personalised learning plan. Step 3: Start learning! <a href="/contact/">Book Free Assessment \u2192</a>',
      trial: 'Yes! We offer a free diagnostic assessment for all new students. This helps us understand your child\'s needs before recommending a programme. <a href="/contact/">Book free assessment \u2192</a>',
      online: 'All classes are 100% online, on the A-Worthy Whiteboard. This allows us to keep class sizes small (max 6) while serving students across all of Singapore. <a href="/programmes/">View programmes \u2192</a>',
      classsize: 'We cap every class at 6 students \u2014 no exceptions. This means your child gets personal feedback on their work every single session, and the tutor knows their specific strengths and weaknesses. <a href="/about/">Learn more about our approach \u2192</a>',
      results: '90% of our students score A1\u2013B3 for O-Level English. Many students improve by 2\u20133 grades within their first term. <a href="/results/">See our full results \u2192</a>',
      tutor: 'All classes are taught by Jeremy Lim, our founder. He\u2019s an NUS Law graduate (LLB Hons) who left corporate law to teach full-time. He created the SHARP Method based on the analytical skills used in legal practice. <a href="/about/">Read his story \u2192</a>',
      subjects: 'We teach five programmes: O-Level English (Sec 1\u20134), O-Level Mathematics (Sec 1\u20134), Pre-IB Mathematics (Year 3\u20134), H1 General Paper (JC 1\u20132), and H2 Economics (JC 1\u20132). All use the same SHARP Method framework. <a href="/programmes/">View all programmes \u2192</a>',
      location: 'We\u2019re 100% online \u2014 no physical centre. Students join from anywhere in Singapore on the A-Worthy Whiteboard, with every lesson recorded. No commute, no wasted time. <a href="/programmes/">View programmes \u2192</a>',
      resources: 'Yes! We have free downloadable resources covering grammar, essay writing, comprehension, vocabulary, and more. No payment required \u2014 just an email address. <a href="/resources/">Browse the resource vault \u2192</a>',
      refund: 'Every new student starts with a free diagnostic assessment. If you\u2019re not satisfied after the first month of lessons, tell us within 7 days of that month\u2019s last lesson and we\u2019ll refund the first month\u2019s fees in full. <a href="/pricing/">See pricing \u2192</a>',
      contact: 'You can reach us via WhatsApp, email, or the contact form on our website. We typically reply within a few hours. <a href="/contact/">Go to contact page \u2192</a>',
      schools: 'Our students come from schools across Singapore \u2014 Raffles Institution, Hwa Chong, ACS, CHIJ, Victoria School, and many neighbourhood schools. The SHARP Method works regardless of starting level. <a href="/success-stories/">Read student stories \u2192</a>'
    };

    toggle.addEventListener('click', function() {
      panel.hidden = !panel.hidden;
      if (!panel.hidden) toggle.style.display = 'none';
    });
    close.addEventListener('click', function() {
      panel.hidden = true;
      toggle.style.display = 'flex';
    });

    opts.addEventListener('click', function(e) {
      var btn = e.target.closest('.chatbot-option');
      if (!btn) return;
      var q = btn.getAttribute('data-q');
      var questionText = btn.textContent;
      // Add user message
      var userMsg = document.createElement('div');
      userMsg.className = 'chatbot-msg chatbot-msg--user';
      userMsg.textContent = questionText;
      body.insertBefore(userMsg, opts);
      // Add bot response
      setTimeout(function() {
        var botMsg = document.createElement('div');
        botMsg.className = 'chatbot-msg chatbot-msg--bot';
        botMsg.innerHTML = answers[q] || 'Sorry, I don\'t have an answer for that. Please <a href="/contact/">contact us</a>.';
        body.insertBefore(botMsg, opts);
        body.scrollTop = body.scrollHeight;
      }, 400);
      body.scrollTop = body.scrollHeight;
    });
    }
    if ('requestIdleCallback' in window) requestIdleCallback(init, { timeout: 5000 });
    else setTimeout(init, 2000);
  })();
  </script>

  <!-- Exam Countdown -->
  <script is:inline define:vars={{ exams }}>
  (function() {
    // Skip entirely on the homepage — it already has its own urgency cues.
    if (window.location.pathname === '/' || window.location.pathname === '/index.html') return;

    function init() {
      var countdown = document.getElementById('exam-countdown');
      var el = document.getElementById('exam-countdown-text');
      if (!countdown || !el) return;
      // `exams` is injected from src/data/site-config.ts via Astro define:vars.
      var now = new Date();
      var next = exams
        .map(function(e) { return { name: e.name, days: Math.ceil((new Date(e.date) - now) / 86400000) }; })
        .filter(function(e) { return e.days > 0; })
        .sort(function(a, b) { return a.days - b.days; })[0];
      if (next) {
        el.textContent = next.days + ' days to ' + next.name + ' — every lesson counts';
        countdown.hidden = false;
        countdown.setAttribute('aria-hidden', 'false');
      }
    }
    if ('requestIdleCallback' in window) requestIdleCallback(init, { timeout: 3000 });
    else setTimeout(init, 1000);
  })();
  </script>

  <!-- Mobile Subject Selector -->
  <script is:inline>
  (function() {
    var sel = document.getElementById('subject-selector');
    if (!sel) return;
    // Only show on homepage
    if (window.location.pathname !== '/' && window.location.pathname !== '/index.html') {
      sel.style.display = 'none';
      return;
    }
    var shown = false;
    window.addEventListener('scroll', function() {
      if (window.scrollY > 600 && !shown) {
        sel.classList.add('visible');
        shown = true;
      } else if (window.scrollY <= 600 && shown) {
        sel.classList.remove('visible');
        shown = false;
      }
    }, { passive: true });
  })();
  </script>

  <!-- Service Worker Registration -->
  <script is:inline>
  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.register('/sw.js').catch(function(){});
  }
  </script>
</body>
</html>
