---
import SubjectBar from '../components/SubjectBar.astro';
import { exams } from '../data/site-config';

// Microsoft Clarity (heatmaps + session recordings) — only renders when
// PUBLIC_CLARITY_PROJECT_ID is set in the environment, so previews/local
// builds without the var stay clean. The project ID is passed to a
// static /clarity.js loader via a meta tag. Using process.env here
// because import.meta.env access inside this large layout's frontmatter
// surfaced a parser error during the Vite transform.
const clarityId = process.env.PUBLIC_CLARITY_PROJECT_ID || '';


interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const { title, description = "Singapore's top-rated tuition for O-Level English & Maths, GP & H2 Economics. 90% A1–B3 rate, max 6 per class. Book a free assessment.", ogImage, noindex = false } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage || '/images/og-default.png', Astro.site);

const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbLabels: Record<string, string> = {
  'about': 'About',
  'programmes': 'Programmes',
  'o-level-english': 'O-Level English',
  'h1-general-paper': 'H1 General Paper',
  'h2-economics': 'H2 Economics',
  'o-level-mathematics': 'O-Level Mathematics',
  'pre-ib-mathematics': 'Pre-IB Mathematics',
  'results': 'Results',
  'frameworks': 'Frameworks',
  'study': 'Study Hub',
  'resources': 'Resources',
  'testimonials': 'Testimonials',
  'contact': 'Contact',
  'pricing': 'Pricing',
  'blog': 'Blog',
  'lp': 'Landing Page',
  'success-stories': 'Success Stories',
  'parent-portal': 'Parent Portal',
  'accessibility': 'Accessibility',
  'privacy-policy': 'Privacy Policy',
  '404': 'Page Not Found',
  'gp-tuition': 'GP Tuition',
  'english-tuition': 'English Tuition',
  'econs-tuition': 'Economics Tuition',
  'comprehension-techniques': 'Comprehension Techniques',
  'gp-essay-structure': 'GP Essay Structure',
  'gp-essay-examples': 'GP Essay Examples',
  'economics-essay-diagrams': 'Economics Essay Diagrams',
  'h2-econs-case-study-tips': 'H2 Econs Case Study Tips',
  'why-smart-students-fail': 'Why Smart Students Fail',
  'situational-writing-guide': 'Situational Writing Guide',
  'exam-prep-timeline': 'Exam Prep Timeline',
  'o-level-english-tips-2026': 'O-Level English Tips 2026',
  'o-level-cut-off-points-2026': '2026 O-Level Cut-Off Points',
  'ib-vs-jc': 'IB vs JC',
  'maths-tuition': 'Maths Tuition',
  'o-level-maths-common-mistakes': 'O-Level Maths Mistakes',
  'e-maths-vs-a-maths': 'E-Maths vs A-Maths',
  'a-maths-calculus-guide': 'A-Maths Calculus Guide',
  'l1r5-calculator': 'L1R5 Calculator',
  'jc-subject-combinations': 'JC Subject Combinations',
  'how-to-choose-a-tuition-centre-singapore': 'Choosing a Tuition Centre',
  'does-my-child-need-tuition': 'Does My Child Need Tuition?',
  'review': 'Leave a Review',
};

const schemaData = {
  "@context": "https://schema.org",
  "@type": ["EducationalOrganization", "LocalBusiness"],
  "name": "A-Worthy",
  "url": Astro.site?.toString(),
  "logo": new URL('/images/logo.png', Astro.site).toString(),
  "description": "Singapore's top-rated tuition centre for O-Level English & Maths, H1 General Paper & H2 Economics. Small classes, proven SHARP Method, 90% A1–B3 rate.",
  "address": {
    "@type": "PostalAddress",
    "addressCountry": "SG",
    "addressLocality": "Singapore"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "1.3521",
    "longitude": "103.8198"
  },
  "telephone": "+6589913181",
  "email": "jeremy@a-worthy.com",
  "sameAs": ["https://wa.me/6589913181", "https://instagram.com/aworthy.sg", "https://tiktok.com/@aworthy.sg", "https://youtube.com/@aworthysg"],
  "areaServed": {
    "@type": "Country",
    "name": "Singapore"
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "14:00",
      "closes": "21:30"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Saturday", "Sunday"],
      "opens": "09:00",
      "closes": "18:00"
    }
  ],
  "priceRange": "SGD 280-400/month",
  "founder": {
    "@type": "Person",
    "name": "Jeremy Lim",
    "jobTitle": "Founder & Lead Tutor",
    "description": "Singapore tutor and founder of A-Worthy. NUS Law graduate (LLB Hons) and creator of the SHARP Method — a five-step analytical framework adapted from legal training and applied to O-Level English & Maths, H1 General Paper, and H2 Economics. 500+ students taught.",
    "alumniOf": {
      "@type": "EducationalOrganization",
      "name": "National University of Singapore, Faculty of Law"
    },
    "knowsAbout": ["O-Level English", "O-Level Mathematics", "H1 General Paper", "H2 Economics", "SHARP Method"],
    "url": "https://a-worthy.com/about/"
  },
  "knowsAbout": ["O-Level English Tuition", "O-Level Mathematics Tuition", "Pre-IB Mathematics Tuition", "H1 General Paper Tuition", "H2 Economics Tuition", "Online Tuition Singapore", "Small Group Tuition", "SHARP Method"],
