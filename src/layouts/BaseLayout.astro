---

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#FAF6EE" />
  <meta name="color-scheme" content="dark light" />
  <meta name="format-detection" content="telephone=no" />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <!-- Google Search Console verification — paste the centre's code here once available: <meta name="google-site-verification" content="..." /> -->
  <!-- Cross-browser compatibility -->
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

  <!-- Local SEO — Singapore -->
  <meta name="geo.region" content="SG" />
  <meta name="geo.placename" content="Singapore" />
  <meta name="geo.position" content="1.3521;103.8198" />
  <meta name="ICBM" content="1.3521, 103.8198" />

  <!-- hreflang — single-locale site, declare both English variants and x-default -->
  <link rel="alternate" hreflang="en-sg" href={canonicalURL.toString()} />
  <link rel="alternate" hreflang="en" href={canonicalURL.toString()} />
  <link rel="alternate" hreflang="x-default" href={canonicalURL.toString()} />

  <!-- Canonical -->
  <link rel="canonical" href={canonicalURL.toString()} />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="en_SG" />
  <meta property="og:url" content={canonicalURL.toString()} />
  <meta property="og:image" content={ogImageURL.toString()} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={`${title} — A-Worthy`} />
  <meta property="og:site_name" content="A-Worthy" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@aworthy_sg" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL.toString()} />
  <meta name="twitter:image:alt" content={`${title} — A-Worthy`} />

  <!-- Schema.org Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

  <!-- BreadcrumbList Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://a-worthy.com/"
      },
      ...(Astro.url.pathname !== "/" ? [{
        "@type": "ListItem",
        "position": 2,
        "name": title,
        "item": `https://a-worthy.com${Astro.url.pathname}`
      }] : [])
    ]
  })} />

  {/* Fonts — Nunito is self-hosted (@font-face in global.css, files in
       public/fonts/). Preload the one file every page needs so it arrives with
       the stylesheet instead of after it; the other subsets load on demand.
       crossorigin is required on font preloads even for same-origin files, or
       the browser fetches the font twice. */}
  <link rel="preload" href="/fonts/nunito-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />

  <link rel="preconnect" href="https://plausible.io" />

  <!-- Analytics -->
  <script defer data-domain="a-worthy.com" src="https://plausible.io/js/script.tagged-events.js"></script>

  {clarityId && <meta name="clarity-id" content={clarityId} />}
  {clarityId && <script async src="/clarity.js"></script>}

  <!-- Celebration microinteraction (confetti on success moments) — defines window.aworthyCelebrate -->
  <script defer src="/celebrate.js"></script>


  <!-- Manifest & icons -->
  <link rel="manifest" href="/manifest.json" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <title>{title}</title>

  {/* No ClientRouter. Astro's router swaps page bodies in place and keeps a
       session-wide record of every inline script it has run, so it never runs
       the same script twice: a page revisited by clicking around came back
       with its toggles, quizzes and calculators unwired, and the header's
       menu and theme toggle stopped responding after the first link. Plain
       navigation runs every script exactly once per page. The cross-fade
       between pages is native CSS (@view-transition in global.css) and links
       are prefetched on hover (astro.config.mjs), so navigation stays quick. */}

  <!-- Theme initialization (auto-detect system preference) -->
  <script is:inline>
    (function() {
      // Gate for scroll-reveal hiding: [data-animate] content is only hidden
      // pre-reveal when JS is running (html.js in global.css), so no-JS
      // visitors always see the page.
      document.documentElement.classList.add('js');
      // Storage access throws (not just returns null) when a browser blocks
      // it — Safari with "Block All Cookies", some in-app browsers — so every
      // read/write on the site is guarded, or the rest of its script dies.
      let saved = null;
      try { saved = localStorage.getItem('theme'); } catch (e) {}
      if (saved === 'dark' || saved === 'light') {
        document.documentElement.setAttribute('data-theme', saved);
      } else {
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.setAttribute('data-theme', prefersDark ? 'dark' : 'light');
      }
    })();

    /*
     * Bottom-bar registry. Several fixed bars can occupy the bottom of the
     * screen — the cookie notice, the global sticky CTA, the homepage's own
     * sticky CTA. Each reports its visible height here (0 when hidden) and the
     * tallest is published as --sticky-bar-h, which the WhatsApp float, chatbot
     * and back-to-top add to their `bottom` so they ride above whichever bar is
     * showing. Previously each bar wrote the variable directly and the cookie
     * notice not at all, so the floats sat on top of the notice's text and
     * buttons for every first-time visitor on a phone.
     */
    window.aworthyBottomBar = function (name, px) {
      var bars = window.__aworthyBars || (window.__aworthyBars = {});
      bars[name] = px > 0 ? Math.round(px) : 0;
      var tallest = 0;
      for (var k in bars) if (bars[k] > tallest) tallest = bars[k];
      document.documentElement.style.setProperty('--sticky-bar-h', tallest + 'px');
    };
  </script>
</head>
<body>

  <a href="#main-content" class="skip-link">Skip to main content</a>

  <div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>

  <slot name="header" />
  <SubjectBar />

  {pathSegments.length > 0 && (
    <nav class="breadcrumb" aria-label="Breadcrumb" id="breadcrumb">
      <ol class="breadcrumb-list">
        <li><a href="/">Home</a></li>
        {pathSegments.map((segment, index) => {
          const href = '/' + pathSegments.slice(0, index + 1).join('/') + '/';
          const label = breadcrumbLabels[segment] || segment.replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
          const isLast = index === pathSegments.length - 1;
          // 'lp' is a folder, not a page — linking it would 404
          const noPage = segment === 'lp';
          return (
            <li>
              {isLast ? <span aria-current="page">{label}</span> : noPage ? <span>{label}</span> : <a href={href}>{label}</a>}
            </li>
          );
        })}
      </ol>
    </nav>
  )}

  <!-- Mobile Subject Selector -->
  <div class="subject-selector" id="subject-selector">
    <a href="/o-level-english/" class="subject-pill">English</a>
    <a href="/h1-general-paper/" class="subject-pill">GP</a>
    <a href="/h2-economics/" class="subject-pill">Econs</a>
    <a href="/o-level-mathematics/" class="subject-pill">Maths</a>
    <a href="/pre-ib-mathematics/" class="subject-pill">Pre-IB Maths</a>
  </div>

  <main id="main-content">
    <slot />
  </main>

  <slot name="footer" />

  <!-- Exam Countdown Bar -->
  <div class="exam-countdown" id="exam-countdown" aria-hidden="true" hidden>
    <div class="exam-countdown-inner">
      <span class="exam-countdown-icon">
        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      </span>
      <span class="exam-countdown-text" id="exam-countdown-text"></span>
    </div>
  </div>

  <!-- Global Sticky CTA Bar (#13) -->
  <div class="sticky-cta-global" id="sticky-cta-global">
    <div class="sticky-cta-global-inner">
      <span class="sticky-cta-global-text">Book a free diagnostic assessment for O-Level English, Maths, GP, or H2 Economics</span>
      <a href="/contact/" class="sticky-cta-global-btn">Book Free Assessment</a>
      <a href="tel:+6589913181" class="sticky-cta-phone" aria-label="Call us">
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6A19.79 19.79 0 012.12 4.18 2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.362 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
      </a>
    </div>
    <button class="sticky-cta-global-dismiss" id="sticky-cta-global-dismiss" aria-label="Dismiss">&times;</button>
  </div>

  <div class="whatsapp-widget" id="whatsapp-widget">
    <a class="whatsapp-float-btn plausible-event-name=WhatsApp+Click" id="whatsapp-float-btn" href="https://wa.me/6589913181?text=Hi%2C%20I%27d%20like%20to%20enquire%20about%20A-Worthy%20tuition" target="_blank" rel="noopener noreferrer" aria-label="Chat on WhatsApp">
      <!-- Fixed sticker-ink navy for both themes (not currentColor) — the button's
           own green background doesn't change between themes, so the icon shouldn't
           either. White-on-green was 1.98:1, failing WCAG 1.4.11 (needs 3:1 for
           icons that identify a UI control); ink navy clears 5:1. -->
      <svg aria-hidden="true" viewBox="0 0 24 24" width="28" height="28" fill="#22304A">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
    </a>
  </div>

  <style>
    .whatsapp-widget {
      position: fixed;
      bottom: calc(2rem + var(--sticky-bar-h, 0px) + env(safe-area-inset-bottom, 0px));
      right: calc(2rem + env(safe-area-inset-right, 0px));
      z-index: var(--z-fixed-widget);
      transition: bottom 0.35s ease;
    }
    .whatsapp-float-btn {
      width: 56px;
      height: 56px;
      background: #25D366;
      border-radius: 50%;
      border: 2px solid var(--color-ink);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 0 var(--ink-shadow);
      cursor: pointer;
      transition: transform 0.15s ease, box-shadow 0.15s ease;
      position: relative;
      text-decoration: none;
    }
    .whatsapp-float-btn::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 50%;
      box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.5);
      pointer-events: none;
    }
    @media (prefers-reduced-motion: no-preference) {
      .whatsapp-float-btn::before {
        animation: wa-attention 5s ease-out infinite;
      }
    }
    @keyframes wa-attention {
      0%   { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.35); }
      60%  { box-shadow: 0 0 0 10px rgba(37, 211, 102, 0); }
      100% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0); }
    }
    .whatsapp-float-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 0 var(--ink-shadow), 0 10px 20px rgba(37, 211, 102, 0.3);
    }
    .whatsapp-float-btn:active {
      transform: translateY(2px);
      box-shadow: 0 1px 0 var(--ink-shadow);
    }
    @media (max-width: 768px) {
      .whatsapp-widget { right: calc(1rem + env(safe-area-inset-right, 0px)); bottom: calc(1.25rem + var(--sticky-bar-h, 0px) + env(safe-area-inset-bottom, 0px)); }
    }
    @media (max-width: 480px) {
      .whatsapp-float-btn { width: 52px; height: 52px; }
    }
    .email-popup-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.5);
      z-index: var(--z-modal);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 1rem;
      -webkit-backdrop-filter: blur(4px);
      backdrop-filter: blur(4px);
    }
    .email-popup-overlay[hidden] {
      display: none;
    }
    .email-popup-overlay:not([hidden]) {
      display: flex;
    }
    .email-popup {
      background: var(--bg-card);
      border: 2px solid var(--color-ink);
      border-radius: var(--radius-lg);
      padding: 2.5rem;
      max-width: min(400px, calc(100vw - 2rem));
      width: 100%;
      position: relative;
      box-shadow: 0 8px 0 var(--ink-shadow), 0 24px 48px rgba(0, 0, 0, 0.18);
    }
    .email-popup-close {
      position: absolute;
      top: 0.5rem;
      right: 0.5rem;
      background: none;
      border: none;
      font-size: 1.5rem;
      color: var(--text-muted);
      cursor: pointer;
      min-width: 44px;
      min-height: 44px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .email-popup-mascot {
      display: block;
      height: 64px;
      width: auto;
      margin: 0 auto 0.5rem;
    }
    .email-popup-title {
      font-family: var(--font-heading);
      font-size: 1.4rem;
      font-weight: 800;
      color: var(--text-primary);
      text-align: center;
      margin: 0.5rem 0;
    }
    .email-popup-desc {
      font-size: 0.9rem;
      color: var(--text-secondary);
      text-align: center;
      line-height: 1.6;
      margin-bottom: 1.5rem;
    }
    .email-popup-form {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    .email-popup-form input {
      min-height: 44px;
    }
    .email-popup-note {
