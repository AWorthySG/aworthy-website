  <script is:inline>
  (function(){
    var el = document.getElementById('sticky-cta-global');
    var dismiss = document.getElementById('sticky-cta-global-dismiss');
    if (!el) return;
    if (window.location.pathname === '/' || window.location.pathname === '/index.html') return;
    var dismissed = false;
    var ticking = false;
    // Looked up on each call: the notice's markup comes after this script, so
    // a lookup at start-up found nothing and the bar showed on top of it.
    function isPrivacyVisible() {
      var notice = document.getElementById('privacy-notice');
      return !!(notice && !notice.hidden);
    }
    window.addEventListener('scroll', function(){
      if (dismissed) return;
      if (!ticking) {
        requestAnimationFrame(function(){
          var visible = window.scrollY > window.innerHeight * 0.5 && !isPrivacyVisible();
          el.classList.toggle('is-visible', visible);
          // Floating widgets read this to ride up above the bar
          window.aworthyBottomBar('cta', visible ? el.offsetHeight : 0);
          ticking = false;
        });
        ticking = true;
      }
    });
    dismiss?.addEventListener('click', function(){
      dismissed = true;
      el.classList.remove('is-visible');
      window.aworthyBottomBar('cta', 0);
    });
  })();
  </script>

